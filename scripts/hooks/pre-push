#!/bin/sh
# Refuse to push app code that is already known to be broken.
#
# Written 2026-08-27, the other half of the alarm in scripts/brief.py. That one
# makes a red gate impossible to walk past; this one stops the red from being
# created in the first place, for the faults a machine can see in under a
# second.
#
# WHAT IT DELIBERATELY DOES NOT DO: build the app or run the tests. That is two
# to five minutes, every push, and a hook that slow is a hook everybody bypasses
# within a week. The slow half is CI's job and the brief now makes its verdict
# unmissable. This is only the checks that cost nothing:
#
#   crossdevice every place either surface keeps something is named in
#               data/cross-device.json with a verdict: it hangs under the
#               account and lives on the server, or it belongs to this device.
#               A new store has to say which (Hidde, 2026-09-11).
#   netcheck    every network call goes through Kit/Net.swift, so every one of
#               them can have the network taken away by a test
#   check-lists the screen sweep and the layout gate agree on the screen list
#   icon_check  the app icon has no alpha channel, which App Store Connect
#               refuses on upload before review even starts
#   convention  a NEW screen or component names the product its interaction was
#               copied from, so a design from somebody's own head cannot ship
#               unnoticed (2026-08-28)
#   standing    a sighting records where the PHONE stood, never our own pin
#               handed back to us as if somebody had measured it (2026-09-12)
#   darkcheck   every colour pair in the palette can be read, in BOTH
#               appearances. The app shipped with white text on the dark
#               palette's moss at 2.85:1, on the primary button, because
#               nobody had ever done the arithmetic (2026-09-03)
#   map style   the dark map style is what the light one generates, so the two
#               cannot drift while nobody looks at the dark one in daylight
#   crosscheck  a feed field the website sends is decoded by the app, and the
#               reverse, so a FEATURE cannot reach one surface only (2026-09-12)
#   iconcheck   no hand-drawn SVG icon added under site/src; icons come from
#               Phosphor's own files (Hidde, 2026-09-24)
#   pluralcheck a count interpolated into a string with the plural hardcoded
#               on it, which reads fine until the count is exactly 1 and
#               nobody tests with exactly 1 (recurred three times, 2026-09-12)
#
# It only runs when the push actually touches the app, so a night run pushing
# trees never sees it.
#
# Enable it once per clone:  git config core.hooksPath scripts/hooks
# Skip it in an emergency:   git push --no-verify

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT" || exit 0

ZERO="0000000000000000000000000000000000000000"
CHANGED=""

# git hands us "local_ref local_sha remote_ref remote_sha" per ref being pushed.
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue          # deleting a branch
    if [ "$remote_sha" = "$ZERO" ]; then
        base=$(git rev-parse origin/main 2>/dev/null) || base=""
    else
        base="$remote_sha"
    fi
    [ -z "$base" ] && base="origin/main"
    CHANGED="$CHANGED
$(git diff --name-only "$base" "$local_sha" 2>/dev/null)"
done

# PITCH COPY, checked before it can leave (2026-09-04). The nudge hook puts the
# calibration in front of a first draft; this is the net under it, because the
# draft that reaches a stranger is the one in a file. Narrow on purpose:
# OUTREACH.md is a 900-line ledger of history and batches are generated, so
# neither is copy anybody is writing now.
# THE QA CHECKS THAT NEED NO BUILD, BEFORE THE BUILD (2026-09-25). Seventeen
# of them read only the source and were all waiting twenty-five minutes behind
# a full Astro build to speak. One of them failed a deploy the day before this
# was written, on a CITY_QUEUE mismatch a laptop reports in under a second.
if ! out=$(python3 scripts/qa.py --source-only 2>&1); then
    echo ""
    echo "pre-push: a qa check that needs no build says no"
    echo "$out" | sed 's/^/  /'
    echo ""
    echo "Nothing was pushed."
    exit 1
fi

# SPELLING, in the copy a reader meets (2026-09-24). Hidde: "dat is toch niet
# zo veel gevraagd van een llm." It is not. Under a second, local only: the
# dictionary is /usr/share/dict/words and it prints one line and passes where
# there is none, so a machine without it is never blocked.
if ! out=$(python3 scripts/spellcheck.py 2>&1); then
    echo ""
    echo "pre-push: a word in the copy is not a word"
    echo "$out" | sed 's/^/  /'
    echo ""
    echo "Nothing was pushed."
    exit 1
fi

# ONE BACKTICK KILLS THE WHOLE DEPLOY (2026-09-23). A comment inside one of the
# JS-in-TS template literals quoted an identifier the natural way and ended the
# literal, and the site stopped building for everyone, night runs included.
# There is no Node on Hidde's Mac, so this is the only thing between writing it
# and finding out from CI twenty minutes later.
if ! out=$(python3 scripts/jslits.py 2>&1); then
    echo ""
    echo "pre-push: a template literal is closed early"
    echo "$out" | sed 's/^/  /'
    echo ""
    echo "Nothing was pushed."
    exit 1
fi

# A CONFLICT MARKER IS NOT PYTHON (2026-09-24). scripts/mailcheck.py sat on
# main for about four hours carrying an unresolved stash pop's conflict
# markers, taking contributor_reply.py down with it (it imports mailcheck),
# self-caught only because it happened to be exercised the same day
# (REVIEW.md 2026-09-24 WARN). Nothing here checked that a changed
# scripts/*.py file still parses; py_compile catches a SyntaxError without
# running anything.
PYFILES=$(echo "$CHANGED" | grep -E '^scripts/[^/]+\.py$' | sort -u)
for f in $PYFILES; do
    [ -f "$f" ] || continue
    if ! out=$(python3 -m py_compile "$f" 2>&1); then
        echo ""
        echo "pre-push: $f does not parse as Python"
        echo "$out" | sed 's/^/  /'
        echo ""
        echo "Nothing was pushed. A stash pop or merge that left conflict"
        echo "markers behind is the usual cause."
        exit 1
    fi
done

# A LETTER IS NOT A PITCH, and each register goes to its own gate (2026-09-23).
# pitchcheck governs the copy a stranger reads to decide whether we are
# interesting; a reply to somebody who has already written to us is mailcheck's,
# and mailcheck was not in this hook at all. It refused "Hi Leon, both trees you
# sent us are on the map" for opening on us, which is exactly the sentence a
# reply should open on.
LETTERS=$(echo "$CHANGED" | grep -E '^drafts/reply-.*\.(md|txt)$' | sort -u)
for f in $LETTERS; do
    [ -f "$f" ] || continue
    if ! out=$(python3 scripts/mailcheck.py "$f" 2>&1); then
        echo ""
        echo "pre-push: mailcheck says no about $f"
        echo "$out" | sed 's/^/  /'
        echo ""
        echo "Nothing was pushed. Rewrite, or 'git push --no-verify' if this is"
        echo "deliberate (a file quoting the bad version, for instance)."
        exit 1
    fi
done

PITCH=$(echo "$CHANGED" | grep -E '^(drafts/|APP_STORE_LISTING\.md)' \
        | grep -vE '(OUTREACH\.md|batches/|HIS_VOICE\.md|PITCH_VOICE\.md|incoming/|^drafts/reply-)' \
        | grep -E '\.(md|txt)$' | sort -u)
for f in $PITCH; do
    [ -f "$f" ] || continue
    if ! out=$(python3 scripts/pitchcheck.py "$f" 2>&1); then
        echo ""
        echo "pre-push: pitchcheck says no about $f"
        echo "$out" | sed 's/^/  /'
        echo ""
        echo "Nothing was pushed. Rewrite, or 'git push --no-verify' if this is"
        echo "deliberate (a file quoting the bad version, for instance)."
        exit 1
    fi
done

# A SESSION MERGES ITS OWN WORK (2026-09-17). Hidde, after a finished and
# verified change was parked on a claude/ branch with a FOR HIDDE line asking
# him to land it: "Merge maar ik wil niet mergen doe dit zelf vraag nooit meer
# aan mij." The corpus already said he is not the gate and that waiting for
# permission is the failure mode here; none of it could refuse a push. This can.
# Narrow on purpose: it refuses git plumbing handed to him, never FOR HIDDE
# itself, which still carries the things only he can do.
if echo "$CHANGED" | grep -qE '^LOG\.md$'; then
    if ! out=$(python3 scripts/handoffcheck.py 2>&1); then
        echo ""
        echo "$out" | sed 's/^/  /'
        echo ""
        echo "Nothing was pushed. Merge it to main yourself and say it is live."
        exit 1
    fi
fi

# THE TRANSLATION OVERLAYS (2026-09-17). i18ncheck.py has gated the deploy
# since Contract J shipped, and it is the FIRST step in deploy.yml, so a
# problem there kills the build before it starts and nothing reaches the site.
# It cost a deploy the day this was added: the check was run before a
# 622-commit merge and not after it, data/i18n/it was one of the conflicted
# paths, and the push was green locally and red in CI. It costs under a second,
# so it runs whenever an overlay or the check itself moved.
if echo "$CHANGED" | grep -qE '^(data/i18n/|data/cities/|scripts/i18ncheck\.py)'; then
    # No pipe here: a pipeline's status is the LAST command's, so piping this
    # through tail would make the check pass whatever it found.
    if ! out=$(python3 scripts/i18ncheck.py 2>&1); then
        out=$(echo "$out" | grep -vE '\s+clean$')
        echo ""
        echo "pre-push: i18ncheck says no"
        echo "$out" | sed 's/^/  /'
        echo ""
        echo "Nothing was pushed. deploy.yml runs this first, so pushing it"
        echo "would fail the build before the site is even rendered."
        exit 1
    fi
fi

# BOTH SURFACES, checked rather than remembered (2026-09-11). Hidde found
# "Exact location. The pin marks the trunk." still on the website a week after
# he had it taken out of the app: "zorg dat dit volgende keer wel gelijk app en
# web doet." A line removed from one surface that survives, word for word, on
# the other is refused here. Deliberate one-surface copy lives in
# data/parity-allow.json with its reason. Runs on ANY change under ios/ or
# site/src/, which the app gate below does not cover.
# BRITISH ENGLISH, gating from 2026-09-18 rather than only printing. It could
# not gate before, because it had been red for weeks on nine findings of which
# every single one was a false positive: the phenology table's American lookup
# KEYS (which exist to catch that spelling), "Open Database License" (a name),
# and three sentences it had cut in half at an inline <a> or <strong>. A check
# that is permanently red is a check nobody reads, which is the same lesson
# ios.yml taught on 2026-08-25. It is quieter now and not weaker: every rule
# still fires on a planted fault. 0.2s, so it belongs in the hook.
if echo "$CHANGED" | grep -qE '^(ios/|site/src/)'; then
    if ! out=$(python3 scripts/englishcheck.py 2>&1); then
        echo ""
        echo "pre-push: englishcheck says no"
        echo "$out" | sed 's/^/  /'
        echo ""
        echo "Nothing was pushed. Fix the spelling, or read the shape findings"
        echo "and rewrite; they are candidates for a human, never a bulk edit."
        exit 1
    fi
fi

# No hand-drawn icons (Hidde, 2026-09-24: "never ever draw icons by hand").
# Every icon comes from Phosphor's own files in site/src/icons/phosphor/.
if echo "$CHANGED" | grep -qE '^site/src/'; then
    if ! out=$(python3 scripts/iconcheck.py 2>&1); then
        echo ""
        echo "pre-push: iconcheck says no"
        echo "$out" | sed 's/^/  /'
        echo ""
        echo "Nothing was pushed."
        exit 1
    fi
fi

if echo "$CHANGED" | grep -qE '^(ios/|site/src/)'; then
    if ! out=$(python3 scripts/paritycheck.py 2>&1); then
        echo ""
        echo "pre-push: paritycheck says no"
        echo "$out" | sed 's/^/  /'
        echo ""
        echo "Nothing was pushed. Take it out of both surfaces, or record why it"
        echo "lives on one in data/parity-allow.json."
        exit 1
    fi
    # And the FEATURE half of the same rule (2026-09-12). paritycheck reads
    # strings, so it can see a sentence that left one surface and cannot see a
    # feature that only ever reached one. crosscheck reads the contract between
    # them instead: a feed field the website sends that no Swift model decodes
    # is a feature that stopped at the web, and neither compiler nor decoder
    # says a word about it. Skipped silently without a build, which is the
    # ordinary case for a push that only touches ios/.
    if ! out=$(python3 scripts/crosscheck.py 2>&1); then
        echo ""
        echo "pre-push: crosscheck says no"
        echo "$out" | sed 's/^/  /'
        echo ""
        echo "Nothing was pushed. Read the field on the other surface too, or"
        echo "record why it is one-sided in data/cross-surface-allow.json."
        exit 1
    fi
fi

echo "$CHANGED" | grep -qE '^(ios/|site/src/|site/public/assets/map-style|scripts/(app|netcheck|icon_check|layout_rules|conventioncheck|crossdevice|darkcheck|map_style_dark|pluralcheck))' || exit 0

fail=0
for check in \
    "scripts/netcheck.py" \
    "scripts/appsweep.py --check-lists" \
    "scripts/icon_check.py" \
    "scripts/conventioncheck.py" \
    "scripts/crossdevice.py" \
    "scripts/darkcheck.py" \
    "scripts/standingpoint.py" \
    "scripts/map_style_dark.py --check" \
    "scripts/pluralcheck.py"
do
    # shellcheck disable=SC2086
    if ! out=$(python3 $check 2>&1); then
        echo ""
        echo "pre-push: $check says no"
        echo "$out" | sed 's/^/  /'
        fail=1
    fi
done

if [ "$fail" = 1 ]; then
    echo ""
    echo "Nothing was pushed. Fix the above, or 'git push --no-verify' if you"
    echo "know what you are doing and are pushing the fix for it."
    exit 1
fi

exit 0
