---
/* The ambassador byline under a city intro.
 *
 * Convention: a BYLINE, a small label and a name, never a sentence about what
 * the person does. Atlas Obscura prints "ADDED BY Eric Grundhauser" and
 * "EDITED BY Martin" in small caps beside the name; komoot prints "Collection
 * by komoot"; komoot's Pioneer and Google's Local Guide are a seal and a role
 * word beside the name (CONVENTIONS.md 2026-10-02 and 2026-10-03). The first
 * version here was a full sentence in a moss pill ("... is the ambassador for
 * Florence and helps keep this list right"), and Hidde, 2026-10-03: "is this
 * really how others do it - feels a bit unprofessional." It explained our
 * process to the reader, which a byline never does.
 *
 * Where we differ, and why this renders so rarely: every reference prints the
 * badge beside a PUBLIC profile, and this site publishes no person's name
 * without their consent (2026-08-11). So this component is only ever handed
 * people who said yes (lib/ambassadors.ts filters on that), and a city with
 * none prints nothing at all, not an empty pill.
 *
 * Hidde, 2026-10-02: "ambassador idea is perfect lets implement it in both app
 * and web." The app shows the same badge beside the name in People and on the
 * person's own My trees header (Screens/AmbassadorBadge.swift).
 *
 * THE OPEN SEAT (Hidde, 2026-10-04: "de ambassadeur regel ... bij elke stad
 * toevoegen met de vraag Tokio is looking for an ambassador met een knop").
 * A city with nobody named gets the same row with an empty dashed avatar and a
 * button, instead of nothing. Convention (CONVENTIONS.md 2026-10-04): Google
 * Maps' Contribute tab carries "Join Local Guides" as one tap, and a Reddit
 * community recruiting moderators says so where its members read and takes the
 * application as a prefilled message. One tap here too: signed out opens the
 * sign-in dialog (the account is the reply channel, 2026-08-21), signed in
 * writes one submissions row of kind 'ambassador' and the button says thanks.
 * The badge still follows the person's ANSWER, never the tap: the knock mails
 * them the editor questions (scripts/ambassador.py --requests) and a session
 * grants it.
 *
 * CONFIRM, THEN SAY IT ARRIVED (Hidde, 2026-10-05: "ik zou eerder een pop up
 * verwachten"). Google Maps' "Join Local Guides" opens a sheet that says what
 * the role is and asks for a yes, then shows that you are in; no reference
 * swaps a line of grey text in place. So the tap opens #amb-dialog, the request
 * is written only on "Send request", and the same dialog turns into the
 * receipt. The app does the same with a standard alert pair. Whether this account already asked is read from the account,
 * never remembered in the browser.
 */
import { icon } from "../lib/icons";
import { SUPABASE_URL, SUPABASE_KEY } from "../lib/site-config";
import Sheet from "./Sheet.astro";
import { ui } from "../lib/i18n";
import { profileHref, type Ambassador } from "../lib/ambassadors";

interface Props {
  people: Ambassador[]; lang?: string; place?: string;
  /** The city's ENGLISH name, written into the request row so the pipeline
   *  reads one spelling whatever language the page was in. Without it no
   *  open seat is drawn. */
  requestCity?: string;
  /** Somebody already looks after this place, named or not (Hidde,
   *  2026-10-27): the open-seat row stays, asking for "an" ambassador, as
   *  Google's "Join Local Guides" is there however many guides a place has. */
  seated?: boolean;
}
const { people, lang = "en", place, requestCity, seated = false } = Astro.props as Props;
const U = ui(lang);
const taken = seated || people.length > 0;
const canAsk = !!(place && requestCity);
// DIRECTION C (Hidde, 2026-11-05): the ambassador is the first row of the
// city page's white box, Plus the second (PlusAsk.astro). Nobody named: one
// line that opens the request, "the" ambassador for an empty place and "a"
// second one where somebody already looks after it. A named person: their
// row, and under the last name "{place} ambassador · Become one too", the
// last words the link to the same request. The affiliation stays on the
// profile (Hidde: "leaving out quercus lisboa is good"), and the dashed
// circle of 2026-10-31 is gone with it.
const askLabel = place ? (taken ? U.ambassadorBecomeA(place) : U.ambassadorBecomeThe(place)) : "";
// THE NAME OPENS THE PROFILE when its owner made it public (Hidde,
// 2026-10-19): the whole row is the link with a chevron, by a stretched link
// on the name, so "Become one too" can sit in the same row as a button of its
// own. A private profile keeps plain text, so no link ever lands on a closed
// page.
---
{people.length > 0 && (
  <ul class="ambassadors" aria-label={U.ambassadorsLabel}>
    {people.map((p, i) => {
      const href = profileHref(p);
      const last = i === people.length - 1;
      return (
        <li class="city-box-row city-box-row-tall ambassador">
          <span class="ambassador-avatar" aria-hidden="true">
            {p.display_name!.trim().charAt(0).toUpperCase()}
            <Fragment set:html={icon("seal-check", "fill", "ic ambassador-seal")} />
          </span>
          <span class="ambassador-text">
            {href ? <a class="ambassador-name ambassador-link" href={href}>{p.display_name}</a> : <span class="ambassador-name">{p.display_name}</span>}
            <span class="ambassador-role">
              {U.ambassadorOf(place ?? p.place_name)}
              {last && canAsk && (
                <span class="ambassador-open" data-city={requestCity} data-sb={SUPABASE_URL} data-key={SUPABASE_KEY}>{" · "}<button type="button" class="ambassador-apply ambassador-more"><span class="amb-label" data-done={U.ambassadorApplied}>{U.ambassadorBecomeOneToo}</span></button></span>
              )}
            </span>
          </span>
          {href && <Fragment set:html={icon("caret-right", "bold", "ic city-box-chev")} />}
        </li>
      );
    })}
  </ul>
)}
{canAsk && people.length === 0 && (
  <div class="ambassador-open" data-city={requestCity} data-sb={SUPABASE_URL} data-key={SUPABASE_KEY}>
    <button type="button" class="city-box-row ambassador-apply" aria-label={askLabel}>
      <Fragment set:html={icon("seal-check", "bold", "ic city-box-ic")} />
      <span class="city-box-label amb-label" data-done={U.ambassadorApplied}>{askLabel}</span>
      <Fragment set:html={icon("caret-right", "bold", "ic city-box-chev")} />
    </button>
  </div>
)}
{place && requestCity && (
  <Sheet lang={lang} class="amb-dialog" id="amb-dialog" aria-labelledby="amb-title">
    {/* THE ONE SHEET (components/Sheet.astro, 2026-10-10): a sheet from
        the bottom on a phone, like every other, with the three lines as rows
        and the receipt as its second step. The app's sheet is the same
        (AmbassadorBadge.swift). */}
    <div class="amb-step amb-ask" data-step="ask">
      <span class="at-sheet-tile"><Fragment set:html={icon("seal-check", "bold")} /></span>
      <h3 class="at-sheet-h" id="amb-title">{taken ? U.ambassadorJoinTitle(place) : U.ambassadorAskTitle(place)}</h3>
      <p class="at-sheet-p">{U.ambassadorAskBody}</p>
      {/* What the role is, before anybody applies (Hidde, 2026-10-08).
          Google Maps' Local Guides join sheet lists what you will do the
          same way. */}
      <ul class="at-sheet-pts">{U.ambassadorAskPoints.map((pt) => <li><Fragment set:html={icon("check", "bold")} />{pt}</li>)}</ul>
      <div class="at-sheet-btns">
        <button type="button" class="sheet-b sheet-b--primary amb-send">{U.ambassadorAskSend}</button>
        <button type="button" class="sheet-b sheet-b--quiet amb-later">{U.ambassadorNotNow}</button>
      </div>
      {/* No address on this step; the receipt names it (Hidde, 2026-10-10). */}
    </div>
    <div class="amb-step amb-sent" data-step="sent" hidden>
      <span class="at-sheet-tile"><Fragment set:html={icon("check", "bold")} /></span>
      <h3 class="at-sheet-h">{U.ambassadorSentTitle}</h3>
      <p class="at-sheet-p">{U.ambassadorSentBody}</p>
      <p class="at-sheet-p amb-who" data-tpl={U.ambassadorWriteTo("{email}")} hidden></p>
      <div class="at-sheet-btns">
        <button type="button" class="sheet-b sheet-b--primary amb-done">{U.ambassadorDone}</button>
      </div>
    </div>
  </Sheet>
  <script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var box = document.querySelector('.ambassador-open');
    var C = window.atCollection;
    if (!box || !C) return;
    var btn = box.querySelector('.ambassador-apply');
    var line = box.querySelector('.amb-label');
    var first = line.textContent;
    var city = box.getAttribute('data-city');
    var SB = box.getAttribute('data-sb'), KEY = box.getAttribute('data-key');
    function done() { line.textContent = line.getAttribute('data-done'); if (btn.hasAttribute('aria-label')) btn.setAttribute('aria-label', line.textContent); btn.disabled = true; box.classList.add('ambassador-asked'); }
    function headers(s, json) {
      var h = { 'apikey': KEY, 'Authorization': 'Bearer ' + s.access_token };
      if (json) { h['Content-Type'] = 'application/json'; h['Prefer'] = 'return=minimal'; }
      return h;
    }
    // Already asked, on any device: the account's own rows answer it.
    C.verify().then(function(ok) {
      var s = ok && C.session();
      if (!s) return;
      fetch(SB + '/rest/v1/submissions?select=id&kind=eq.ambassador&city=eq.' + encodeURIComponent(city) + '&limit=1',
            { headers: headers(s) })
        .then(function(r) { return r.ok ? r.json() : []; })
        .then(function(rows) { if (rows && rows.length) done(); })
        .catch(function() {});
      // You look after this place already: the ask is not yours (Hidde,
      // 2026-10-30, Baarn's ambassador still reading "Request sent." under his
      // own name). Google Maps shows "Join Local Guides" only to non-guides.
      // The user id is the token's sub claim (see add-photo-js userId).
      var uid = null;
      try {
        var b = s.access_token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
        while (b.length % 4) b += '=';
        uid = JSON.parse(atob(b)).sub || null;
      } catch (e) {}
      if (!uid) return;
      fetch(SB + '/rest/v1/ambassadors?select=place_name&user_id=eq.' + encodeURIComponent(uid) + '&place_name=ilike.' + encodeURIComponent(city),
            { headers: headers(s) })
        .then(function(r) { return r.ok ? r.json() : []; })
        .then(function(rows) { if (rows && rows.length) box.hidden = true; })
        .catch(function() {});
    });
    var dlg = document.getElementById('amb-dialog');
    var ask = dlg.querySelector('.amb-ask'), sent = dlg.querySelector('.amb-sent');
    var send = dlg.querySelector('.amb-send');
    function close() { if (dlg.open) dlg.close(); }
    // THE ADDRESS WE WILL WRITE TO, printed in the confirm step and in the
    // receipt (Hidde, 2026-10-07: "so that we know the email address of that
    // person and we can contact them"). It is the server's answer to who this
    // session is, so a request can never look anonymous from either side.
    function who() {
      var e = C.who();
      dlg.querySelectorAll('.amb-who').forEach(function(p) {
        if (e) { p.textContent = p.getAttribute('data-tpl').replace('{email}', e); p.hidden = false; }
        else p.hidden = true;
      });
    }
    function open() { who(); ask.hidden = false; sent.hidden = true; send.disabled = false; dlg.showModal(); }
    btn.addEventListener('click', function() {
      C.gate(function() { open(); }, function() {
        // Signed out: sign in first, and come back to THIS step. The intent
        // travels with the sign-in (signin-js keeps it for the page they land
        // on), so the tap is finished rather than swallowed.
        if (window.atOpenSignIn) window.atOpenSignIn(null, 'feedback', { kind: 'ambassador', city: city });
      });
    });
    // Back from signing in with the request still to make: reopen the confirm
    // step, never send on their behalf. Nothing is written until Send request.
    if (window.atPendingAmbassador && (window.atPendingAmbassador === true || window.atPendingAmbassador === city)) {
      window.atPendingAmbassador = null;
      C.gate(function() { if (!btn.disabled) open(); }, function() {});
    }
    dlg.querySelector('.amb-later').addEventListener('click', close);
    dlg.querySelector('.amb-done').addEventListener('click', close);
    send.addEventListener('click', function() {
      var s = C.session();
      if (!s) { close(); if (window.atOpenSignIn) window.atOpenSignIn(null, 'feedback', { kind: 'ambassador', city: city }); return; }
      send.disabled = true;
      fetch(SB + '/rest/v1/submissions', {
        method: 'POST', headers: headers(s, true),
        body: JSON.stringify({ kind: 'ambassador', city: city, tree: '', why: 'ambassador request', page: location.pathname })
      }).then(function(r) {
        if (r.status === 401 || r.status === 403) { C.forget(); close(); if (window.atOpenSignIn) window.atOpenSignIn(null, 'feedback', { kind: 'ambassador', city: city }); return; }
        if (r.ok) {
          done(); ask.hidden = true; sent.hidden = false;
          if (window.at && at.track) at.track('ambassador-request');
        } else send.disabled = false;
      }).catch(function() { send.disabled = false; });
    });
    document.addEventListener('at:signedout', function() {
      line.textContent = first; if (btn.hasAttribute('aria-label')) btn.setAttribute('aria-label', first); btn.disabled = false; box.classList.remove('ambassador-asked');
    });
  });
  </script>
)}

{/* The rows' numbers live in public/assets/style.css under .city-box, shared
    with the Plus row (PlusAsk.astro), so the two rows of the box cannot drift. */}
