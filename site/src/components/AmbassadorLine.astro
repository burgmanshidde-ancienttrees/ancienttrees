---
/* The ambassador line under a city intro.
 *
 * Convention: komoot's Pioneer badge (CONVENTIONS.md 2026-10-02): a small seal
 * beside a person's name, tied to one region, earned by what they already did.
 * Google's Local Guides badge is the same shape. Ours is Phosphor's seal-check
 * (the app draws Apple's checkmark.seal.fill) in the moss pill the site already
 * uses for a person's avatar, with one plain sentence.
 *
 * Where we differ, and why this renders so rarely: every reference prints the
 * badge beside a PUBLIC profile, and this site publishes no person's name
 * without their consent (2026-08-11). So this component is only ever handed
 * people who said yes (lib/ambassadors.ts filters on that), and a city with
 * none prints nothing at all, not an empty pill.
 *
 * Hidde, 2026-10-02: "ambassador idea is perfect lets implement it in both app
 * and web." The app shows the same badge beside the name in People and on the
 * person's own My trees header (Screens/AmbassadorBadge.swift).
 */
import { icon } from "../lib/icons";
import { ui } from "../lib/i18n";
import type { Ambassador } from "../lib/ambassadors";

interface Props { people: Ambassador[]; lang?: string }
const { people, lang = "en" } = Astro.props as Props;
const U = ui(lang);
---
{people.length > 0 && (
  <ul class="ambassadors" aria-label="Ambassadors">
    {people.map((p) => (
      <li class="ambassador-line">
        <Fragment set:html={icon("seal-check", "fill", "ic ambassador-seal")} />
        <span>{U.ambassadorLine(p.display_name!, p.place_name)}</span>
      </li>
    ))}
  </ul>
)}

<style>
  .ambassadors { list-style: none; margin: 0.75rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .ambassador-line {
    display: inline-flex; align-items: center; gap: 8px; max-width: 100%;
    font-size: 13px; line-height: 1.4; color: var(--moss);
    background: var(--moss-light); border-radius: 999px; padding: 6px 12px 6px 10px;
  }
  .ambassador-line :global(.ambassador-seal) { width: 16px; height: 16px; flex: none; fill: currentColor; }
</style>
