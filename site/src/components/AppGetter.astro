---
/* The "download the app" control, device-aware since 2026-09-03.
 *
 * Hidde: "kunnen we bijvoorbeeld het mail lijst nog tonen als iemand op de
 * get the app klikt met een android telefoon en met ios naar de appstore en
 * op web de qr code tonen zoals alltrails." Three destinations for one
 * control, because they are not the same offer: an iOS visitor can install
 * today, an Android visitor cannot install anything (there is no Android
 * build), and a desktop visitor is not holding the phone the app runs on.
 *
 * Convention: AllTrails' own desktop dialog is exactly a QR code under
 * "Openen in de app" (CONVENTIONS.md, benchmarked 2026-09-03 alongside the
 * smart-banner table). We take the QR half of that pattern; we do not take
 * the full-screen sheet it lives inside, for the reason already recorded
 * there (search is our only channel and Google names that sheet as the
 * intrusive interstitial it penalises).
 *
 * All three states render in the markup; a small script picks one by
 * `navigator.userAgent` and sets `data-device` on the wrapper, which is what
 * the CSS keys off. Before that script runs (or with JS disabled) the iOS
 * block shows, because it is the only one of the three that is a plain
 * working link with nothing to detect.
 *
 * The QR encodes /app rather than the App Store link directly, so scanning
 * it is not a bet on the scanning phone being an iPhone: it lands the phone
 * on this exact widget, which then shows that phone's own iOS badge or
 * Android waitlist. Generated with the `qrcode` Python library and decoded
 * back with OpenCV before being committed, the same round-trip a phone's
 * camera performs, because a QR code that merely looks right is not the
 * same claim as one that scans right.
 */
import AppStoreBadge from "./AppStoreBadge.astro";
import { SUPABASE_URL, SUPABASE_KEY } from "../lib/site-config";
import { ui } from "../lib/i18n";

interface Props {
  lang?: string;
  ev?: string;
  /** Where the waitlist row records this control opened it, distinct from
   *  the walks overlay's own "walks-modal" source. */
  source?: string;
}
const { lang = "en", ev = "app-cta", source = "app-getter" } = Astro.props;
const t = ui(lang);
---
<div class="app-getter" data-device="ios">
  <div class="app-getter-ios">
    <AppStoreBadge lang={lang} ev={ev} />
  </div>
  <div class="app-getter-android">
    <p class="app-getter-note">{t.androidNote}</p>
    <form class="app-getter-form" data-android-waitlist autocomplete="email">
      <input type="email" class="ag-email" placeholder="you@example.com" aria-label={t.emailLabel} required>
      <button type="submit" class="go-btn">{t.notifyMe}</button>
    </form>
    <p class="app-getter-sent" hidden>{t.waitlistSent}</p>
  </div>
  <div class="app-getter-desktop">
    <img src="/assets/appstore/qr-app.svg" width="150" height="150" alt="" class="app-getter-qr">
    <p class="app-getter-note">{t.scanToOpen}</p>
  </div>
</div>
<script define:vars={{ SB: SUPABASE_URL, SBK: SUPABASE_KEY, source }}>
  (function () {
    // Runs once per page: Astro dedupes an identical non-inline script even
    // when the component is used more than once, so every .app-getter on the
    // page is updated by this one pass.
    var ua = navigator.userAgent || "";
    var isIOS = /iPhone|iPad|iPod/.test(ua)
      || (ua.indexOf("Macintosh") > -1 && navigator.maxTouchPoints > 1);
    var isAndroid = /Android/.test(ua);
    var device = isAndroid ? "android" : (isIOS ? "ios" : "desktop");
    document.querySelectorAll(".app-getter").forEach(function (el) {
      el.dataset.device = device;
    });

    document.addEventListener("submit", function (e) {
      var form = e.target.closest("[data-android-waitlist]");
      if (!form) return;
      e.preventDefault();
      var input = form.querySelector(".ag-email");
      var email = input.value.trim();
      if (!email) return;
      var btn = form.querySelector("button");
      btn.disabled = true;
      try { at.track("waitlist-submit"); } catch (err) {}
      fetch(SB + "/rest/v1/waitlist", {
        method: "POST",
        headers: { "apikey": SBK, "Content-Type": "application/json",
                   "Prefer": "return=minimal" },
        body: JSON.stringify({ email: email, source: source }),
      }).then(function (r) {
        if (r.ok || r.status === 409) {
          form.hidden = true;
          form.nextElementSibling.hidden = false;
        } else {
          btn.disabled = false;
        }
      }).catch(function () { btn.disabled = false; });
    });
  })();
</script>
