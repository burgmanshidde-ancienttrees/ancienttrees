---
// The walking-routes overlay (Hidde, 2026-08-18: "als je op de wandelknop
// drukt er een overlay komt met de app voordelen en dat je je kan inschrijven,
// iets korter dan de landingspagina misschien, waar ook een kruisje in is
// zodat je weer terug kan naar de stad waar je was").
//
// Deliberately NOT a new pattern. This is SignInModal's dialog, the same
// <dialog class="collect-dialog"> with the same close button in the same
// corner, because the site already converges gated features on one modal shape
// (Hidde, 2026-08-14, from AllTrails) and following our own component is what
// "the convention" means here.
//
// Why an overlay rather than the link it replaced: the walking routes left the
// web on 2026-08-18 and the pill used to navigate to /app, which threw away
// the city the visitor was reading. A dialog keeps their place, which is the
// whole reason he asked for the cross.
//
// Shorter than /app on purpose: a headline, four features, one field. The
// full page is one tap away for anyone who wants it.
//
// WHAT THE BULLETS OBEY, measured 2026-08-23 rather than felt. Hidde: "ik wil
// dat je juist de bullets ook onderzoekt van concurenten is hier een soort
// best practice in." There is, and it is consistent across all five apps
// whose copy was read (AllTrails, Komoot Premium, Seek, iNaturalist,
// Geocaching), 24 bullets in total:
//
//   * Verb first, imperative, second person. 22 of the 24.
//   * Every verb DIFFERENT from its neighbours. AllTrails runs Search, Get,
//     Stick, Discover, Celebrate, Post, Capture without a repeat; that is
//     NN/G's rule 4, because a scanning eye reads only the first word or two
//     of each line and four lines opening the same way read as one line.
//   * 7 to 13 words, and roughly EQUAL lengths, or one item dominates.
//   * Parallel: all fragments, no closing full stops.
//   * A short noun label plus one sentence is the web/premium-page shape
//     (Komoot: "Multi-day routes / Easily plan adventures that'll take
//     multiple days"); the bare verb line is the App Store shape.
//
// The label carries the feature NAME and the sentence carries the moment, so
// "Season Radar" is his own name for it from the paywall copy rather than a
// second way of saying alerts.
//
// The count is generated and rounded down; see lib/tree-count.ts for why.
import { roundedTrees } from "../lib/tree-count";

// THE COPY IS A TABLE, NOT A TERNARY, since 2026-09-02, and the shape is the
// fix rather than the translations. It was `const T = es ? {...} : {...}` with
// a `lang` prop bolted on in front of it on 2026-08-22, so the six languages
// that are neither English nor Spanish silently took the English branch. A
// German reader on /de/berlin/dicke-marie tapped "Get the app" and got "City
// walks", "Your log" and "See everything it does" over their own prose, and
// nothing could see it: this file renders from Base.astro, so it is on all 31
// translated sets at once and no per-language template exists to catch it.
//
// So it follows lib/ui-strings.ts, which exists for exactly this and is the
// model: a Record<Lang, ...> that stops compiling when a language is missing,
// and a lookup falling back to the WHOLE English object. Never key by key. A
// half-translated overlay is worse than an English one, because an English
// overlay is a consistent choice and a mixed one reads as a fault.
//
// `locale` lives in the same table as the copy so the two cannot disagree.
// It used to be a second ternary (`es ? "es-ES" : "en-US"`), which gave every
// other language American thousands separators under its own sentences.
import type { Lang } from "../lib/ui-strings";
import AppGetter from "./AppGetter.astro";

interface AppModalStrings {
  /** Takes the formatted count, because the number sits inside the sentence
   *  and every language puts it somewhere else. */
  title: (count: string) => string;
  /** Thousands separators: a full stop in German and Italian, a thin space in
   *  French, nothing in Japanese. */
  locale: string;
  f1n: string; f1: string;
  f2n: string; f2: string;
  f3n: string; f3: string;
  f4n: string; f4: string;
  more: string;
  close: string;
}

// The bullets keep the shape the competitor read of 2026-08-23 settled, in
// every language: a short noun label, then one verb-first line, with each
// verb different from its neighbours and the four lines roughly equal.
const COPY: Record<Lang, AppModalStrings> = {
  en: {
    title: (n) => `Over ${n} old trees worth the walk`,
    locale: "en-US",
    f1n: "Trees near you", f1: "See which remarkable old trees are a few streets away",
    f2n: "Add a tree", f2: "Photograph one we don't have yet and it joins the map",
    f3n: "Your log", f3: "Tick off the trees you have actually visited",
    f4n: "Save for later", f4: "Heart the trees you want to visit and find them again anytime",
    more: "See everything it does",
    close: "Close",
  },
  es: {
    title: (n) => `Más de ${n} árboles viejos que merecen el paseo`,
    locale: "es-ES",
    f1n: "Árboles cerca de ti", f1: "Descubre qué árboles notables están a unas calles",
    f2n: "Añade un árbol", f2: "Fotografía uno que no tengamos y se une al mapa",
    f3n: "Tu registro", f3: "Marca los árboles que has visitado de verdad",
    f4n: "Guarda para después", f4: "Marca con un corazón los árboles que quieres visitar y encuéntralos cuando quieras",
    more: "Ver todo lo que hace",
    close: "Cerrar",
  },
  it: {
    title: (n) => `Più di ${n} alberi secolari che valgono la passeggiata`,
    locale: "it-IT",
    f1n: "Alberi vicino a te", f1: "Scopri quali alberi notevoli si trovano a due passi",
    f2n: "Aggiungi un albero", f2: "Fotografa uno che non abbiamo ancora e si unisce alla mappa",
    f3n: "Il tuo diario", f3: "Segna gli alberi che hai visitato davvero",
    f4n: "Salva per dopo", f4: "Metti un cuore agli alberi che vuoi visitare e ritrovali quando vuoi",
    more: "Guarda tutto quello che fa",
    close: "Chiudi",
  },
  nl: {
    title: (n) => `Meer dan ${n} oude bomen die de wandeling waard zijn`,
    locale: "nl-NL",
    f1n: "Bomen bij jou in de buurt", f1: "Zie welke bijzondere oude bomen een paar straten verderop staan",
    f2n: "Voeg een boom toe", f2: "Fotografeer een boom die we nog niet hebben en hij komt op de kaart",
    f3n: "Jouw logboek", f3: "Vink de bomen af waar je echt voor hebt gestaan",
    f4n: "Bewaar voor later", f4: "Zet een hartje bij bomen die je wilt bezoeken en vind ze later terug",
    more: "Bekijk alles wat hij doet",
    close: "Sluiten",
  },
  de: {
    title: (n) => `Über ${n} alte Bäume, für die sich der Weg lohnt`,
    locale: "de-DE",
    f1n: "Bäume in deiner Nähe", f1: "Sieh, welche bemerkenswerten alten Bäume ein paar Straßen weiter stehen",
    f2n: "Füge einen Baum hinzu", f2: "Fotografiere einen, den wir noch nicht haben, und er kommt auf die Karte",
    f3n: "Dein Logbuch", f3: "Hake die Bäume ab, vor denen du wirklich gestanden hast",
    f4n: "Für später merken", f4: "Markiere Bäume mit einem Herz, die du besuchen willst, und finde sie später wieder",
    more: "Sieh dir an, was sie alles kann",
    close: "Schließen",
  },
  pt: {
    title: (n) => `Mais de ${n} árvores antigas que valem a caminhada`,
    locale: "pt-PT",
    f1n: "Árvores perto de si", f1: "Veja que árvores notáveis estão a duas ruas de distância",
    f2n: "Adicione uma árvore", f2: "Fotografe uma que ainda não temos e ela entra no mapa",
    f3n: "O seu registo", f3: "Marque as árvores que visitou mesmo",
    f4n: "Guarde para depois", f4: "Marque com um coração as árvores que quer visitar e encontre-as mais tarde",
    more: "Veja tudo o que faz",
    close: "Fechar",
  },
  fr: {
    title: (n) => `Plus de ${n} arbres anciens qui valent le détour`,
    locale: "fr-FR",
    f1n: "Des arbres près de vous", f1: "Voyez quels arbres remarquables se trouvent à deux rues",
    f2n: "Ajoutez un arbre", f2: "Photographiez-en un que nous n'avons pas encore et il rejoint la carte",
    f3n: "Votre carnet", f3: "Cochez les arbres devant lesquels vous êtes vraiment passé",
    f4n: "Gardez pour plus tard", f4: "Mettez un cœur aux arbres que vous voulez visiter et retrouvez-les plus tard",
    more: "Voyez tout ce qu'elle fait",
    close: "Fermer",
  },
  // 常体, following the ja block in lib/i18n.ts.
  ja: {
    title: (n) => `歩いて訪ねる価値のある古木が${n}本以上`,
    locale: "ja-JP",
    f1n: "近くの木", f1: "すぐ近くにどんな見事な古木があるかわかる",
    f2n: "木を追加", f2: "まだ登録されていない木を撮影すると地図に加わる",
    f3n: "自分の記録", f3: "実際に訪ねた木に印をつけられる",
    f4n: "あとで見る", f4: "訪ねたい木にハートを付けておけば、あとから見つけられる",
    more: "できることをすべて見る",
    close: "閉じる",
  },
};

interface Props { lang?: string }
const { lang = "en" } = Astro.props as Props;

// The whole English object for an unknown language, never key by key.
const T = COPY[lang as Lang] ?? COPY.en;

const rounded = await roundedTrees();
const title = T.title(rounded.toLocaleString(T.locale));
---
<dialog id="app-dialog" class="collect-dialog signin-dialog app-dialog">
  <button type="button" class="signin-close" id="app-close" aria-label={T.close}>&#10005;</button>
  <p class="signin-mark" aria-hidden="true">&#127795;</p>
  <div id="app-ask">
    <h3>{title}</h3>
    <ul class="app-dialog-list">
      <li><b>{T.f1n}</b> {T.f1}</li>
      <li><b>{T.f2n}</b> {T.f2}</li>
      <li><b>{T.f3n}</b> {T.f3}</li>
      <li><b>{T.f4n}</b> {T.f4}</li>
    </ul>
    <AppGetter lang={lang} ev="walks-app-badge" source="walks-modal" />
    <a class="go-btn ghost signin-more" href="/app" data-ev="app-cta">{T.more}</a>
  </div>
</dialog>
<script is:inline>
  (function() {
    var dlg = document.getElementById('app-dialog');
    if (!dlg) return;
    // No at.track here. Every element that opens this dialog is a
    // [data-app-modal] link that also carries the walks-app event attribute,
    // so the one attribute listener in Base.astro counts the click
    // (FUNNELS.md, 2026-08-14). Tracking it here too counted it twice.
    window.atOpenApp = function() {
      if (dlg.showModal) { dlg.showModal(); } else { location.href = '/app'; }
    };
    document.getElementById('app-close').addEventListener('click', function() { dlg.close(); });
    // Clicking the backdrop closes it, the way every dialog on the site does.
    dlg.addEventListener('click', function(e) { if (e.target === dlg) dlg.close(); });
    document.addEventListener('click', function(e) {
      var t = e.target.closest('[data-app-modal]');
      if (!t) return;
      e.preventDefault();
      window.atOpenApp();
    });
  })();
</script>
