---
// The walking-routes overlay (Hidde, 2026-08-18: "als je op de wandelknop
// drukt er een overlay komt met de app voordelen en dat je je kan inschrijven,
// iets korter dan de landingspagina misschien, waar ook een kruisje in is
// zodat je weer terug kan naar de stad waar je was").
//
// Deliberately NOT a new pattern. This is SignInModal's dialog, the same
// <dialog class="collect-dialog"> with the same close button in the same
// corner, because the site already converges gated features on one modal shape
// (Hidde, 2026-08-14, from AllTrails) and following our own component is what
// "the convention" means here.
//
// Why an overlay rather than the link it replaced: the walking routes left the
// web on 2026-08-18 and the pill used to navigate to /app, which threw away
// the city the visitor was reading. A dialog keeps their place, which is the
// whole reason he asked for the cross.
//
// Shorter than /app on purpose: a headline, four features, one field. The
// full page is one tap away for anyone who wants it.
//
// WHAT THE BULLETS OBEY, measured 2026-08-23 rather than felt. Hidde: "ik wil
// dat je juist de bullets ook onderzoekt van concurenten is hier een soort
// best practice in." There is, and it is consistent across all five apps
// whose copy was read (AllTrails, Komoot Premium, Seek, iNaturalist,
// Geocaching), 24 bullets in total:
//
//   * Verb first, imperative, second person. 22 of the 24.
//   * Every verb DIFFERENT from its neighbours. AllTrails runs Search, Get,
//     Stick, Discover, Celebrate, Post, Capture without a repeat; that is
//     NN/G's rule 4, because a scanning eye reads only the first word or two
//     of each line and four lines opening the same way read as one line.
//   * 7 to 13 words, and roughly EQUAL lengths, or one item dominates.
//   * Parallel: all fragments, no closing full stops.
//   * A short noun label plus one sentence is the web/premium-page shape
//     (Komoot: "Multi-day routes / Easily plan adventures that'll take
//     multiple days"); the bare verb line is the App Store shape.
//
// The label carries the feature NAME and the sentence carries the moment, so
// "Season Radar" is his own name for it from the paywall copy rather than a
// second way of saying alerts.
//
// The count is generated and rounded down; see lib/tree-count.ts for why.
import { SUPABASE_URL, SUPABASE_KEY } from "../lib/site-config";
import { roundedTrees } from "../lib/tree-count";

// `lang` widened this from a Spanish boolean on 2026-08-22. Modal copy is
// chrome, which Contract J lets stay English until a language earns a
// rollout, so an unlisted language gets the English modal rather than a
// half-translated one.
interface Props { es?: boolean; lang?: string }
const { es: esProp = false, lang = "en" } = Astro.props as Props;
const es = esProp || lang === "es";

const rounded = await roundedTrees();
const count = rounded.toLocaleString(es ? "es-ES" : "en-US");

const T = es ? {
  title: `Más de ${count} árboles viejos que merecen el paseo`,
  f1n: "Árboles cerca de ti", f1: "Descubre qué árboles notables están a unas calles",
  f2n: "Paseos por la ciudad", f2: "Sigue una ruta que pasa por los mejores árboles en una tarde",
  f3n: "Tu registro", f3: "Marca los árboles que has visitado de verdad",
  f4n: "Season Radar", f4: "Recibe un aviso la semana que un árbol cercano florece",
  placeholder: "tu@ejemplo.com",
  send: "Avísame",
  note: "Te escribimos el día que abra. Un email. Nada más.",
  sent: "Estás en la lista. Te escribiremos cuando la app esté lista.",
  fail: "No ha salido. Inténtalo de nuevo en un momento.",
  more: "Ver todo lo que hace",
  close: "Cerrar",
} : {
  title: `Over ${count} old trees worth the walk`,
  f1n: "Trees near you", f1: "See which remarkable old trees are a few streets away",
  f2n: "City walks", f2: "Follow a route past the best trees in one afternoon",
  f3n: "Your log", f3: "Tick off the trees you have actually visited",
  f4n: "Season Radar", f4: "Get notified the week a tree nearby comes into blossom",
  placeholder: "you@example.com",
  send: "Tell me first",
  note: "We write to you the day it opens. One email. Nothing else.",
  sent: "You are on the list. We will email you when the app is ready.",
  fail: "That did not go through. Try again in a moment.",
  more: "See everything it does",
  close: "Close",
};
---
<dialog id="app-dialog" class="collect-dialog signin-dialog app-dialog">
  <button type="button" class="signin-close" id="app-close" aria-label={T.close}>&#10005;</button>
  <p class="signin-mark" aria-hidden="true">&#127795;</p>
  <div id="app-ask">
    <h3>{T.title}</h3>
    <ul class="app-dialog-list">
      <li><b>{T.f1n}</b> {T.f1}</li>
      <li><b>{T.f2n}</b> {T.f2}</li>
      <li><b>{T.f3n}</b> {T.f3}</li>
      <li><b>{T.f4n}</b> {T.f4}</li>
    </ul>
    <form id="app-wl" class="signin-form" autocomplete="email">
      <input type="email" id="app-wl-email" placeholder={T.placeholder} aria-label="Email address" required>
      <button type="submit" class="go-btn">{T.send}</button>
    </form>
    <p class="signin-fine" id="app-wl-note">{T.note}</p>
    <a class="go-btn ghost signin-more" href="/app" data-ev="app-cta">{T.more}</a>
  </div>
  <div id="app-sent" hidden>
    <h3>{T.sent}</h3>
  </div>
</dialog>
<script is:inline define:vars={{ FAIL: T.fail, SB: SUPABASE_URL, SBK: SUPABASE_KEY }}>
  (function() {
    var dlg = document.getElementById('app-dialog');
    if (!dlg) return;
    // No at.track here. Every element that opens this dialog is a
    // [data-app-modal] link that also carries the walks-app event attribute,
    // so the one attribute listener in Base.astro counts the click
    // (FUNNELS.md, 2026-08-14). Tracking it here too counted it twice.
    window.atOpenApp = function() {
      if (dlg.showModal) { dlg.showModal(); } else { location.href = '/app'; }
    };
    document.getElementById('app-close').addEventListener('click', function() { dlg.close(); });
    // Clicking the backdrop closes it, the way every dialog on the site does.
    dlg.addEventListener('click', function(e) { if (e.target === dlg) dlg.close(); });
    document.addEventListener('click', function(e) {
      var t = e.target.closest('[data-app-modal]');
      if (!t) return;
      e.preventDefault();
      window.atOpenApp();
    });
    var f = document.getElementById('app-wl');
    var note = document.getElementById('app-wl-note');
    f.addEventListener('submit', function(e) {
      e.preventDefault();
      var email = document.getElementById('app-wl-email').value.trim();
      if (!email) return;
      note.textContent = '...';
      try { at.track('waitlist-submit'); } catch (err) {}
      fetch(SB + '/rest/v1/waitlist', {
        method: 'POST',
        headers: { 'apikey': SBK, 'Content-Type': 'application/json',
                   'Prefer': 'return=minimal' },
        body: JSON.stringify({ email: email, source: 'walks-modal' })
      }).then(function(r) {
        if (r.ok || r.status === 409) {
          document.getElementById('app-ask').hidden = true;
          document.getElementById('app-sent').hidden = false;
        } else { note.textContent = FAIL; }
      }).catch(function() { note.textContent = FAIL; });
    });
  })();
</script>
