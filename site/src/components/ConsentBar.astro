---
// The cookie question, and Google Analytics behind it (Hidde, 2026-10-12:
// "i think its time for use to start implementing google analytics i find
// cloudflare quite useless", then "id rather use google analytics im used
// to it").
//
// Convention: the bottom consent bar AllTrails and komoot show European
// visitors, with Accept and Decline the same size and the same weight, which
// is what the EDPB and the Dutch AP ask for (refusing must be as easy as
// accepting). A bar rather than the one sheet on purpose: a consent question
// may not block the page it is asking about (no cookie wall), so it sits
// over the foot of the page and the reader can read on and ignore it.
// Ignoring it is a no. CONVENTIONS.md, "Asking for analytics cookies".
//
// Google's "basic" consent mode: gtag.js is not even fetched until somebody
// presses Accept, so a visitor who declines or ignores the bar sends Google
// nothing at all. Google signals and ad personalisation stay off.
//
// Only on ancienttrees.app and never in an automated browser, the same gate
// as every other measurement here, so CI and previews never see the bar.
import { chrome } from "../lib/ui-strings";
import { GA_MEASUREMENT_ID } from "../lib/site-config";

interface Props { lang?: string }
const { lang = "en" } = Astro.props as Props;
const t = chrome(lang);
---
{GA_MEASUREMENT_ID && (
<div id="consent-bar" class="consent-bar" role="region" aria-label={t.cookies} hidden>
  <p class="consent-p">{t.consentTitle} <a href="/privacy#cookies">{t.privacy}</a></p>
  <div class="consent-btns">
    <button type="button" class="consent-b" data-consent="yes">{t.consentAccept}</button>
    <button type="button" class="consent-b" data-consent="no">{t.consentDecline}</button>
  </div>
</div>
<script define:vars={{ GA_ID: GA_MEASUREMENT_ID }}>
(function () {
  if (location.hostname !== "ancienttrees.app") { return; }
  if (navigator.webdriver) { return; }
  var bar = document.getElementById("consent-bar");
  function load() {
    if (window.__atGa) { return; }
    window.__atGa = true;
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    window.gtag("js", new Date());
    window.gtag("config", GA_ID, { allow_google_signals: false, allow_ad_personalization_signals: false });
    var s = document.createElement("script");
    s.async = true;
    s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
    document.head.appendChild(s);
  }
  function dropGaCookies() {
    document.cookie.split(";").forEach(function (c) {
      var name = c.split("=")[0].trim();
      if (name.indexOf("_ga") === 0) {
        document.cookie = name + "=; Max-Age=0; path=/; domain=.ancienttrees.app";
        document.cookie = name + "=; Max-Age=0; path=/";
      }
    });
  }
  var choice = null;
  try { choice = localStorage.getItem("at_consent"); } catch (e) {}
  if (choice === "yes") { load(); }
  else if (choice !== "no" && bar) { bar.hidden = false; }
  if (bar) {
    bar.addEventListener("click", function (e) {
      var b = e.target.closest ? e.target.closest("[data-consent]") : null;
      if (!b) { return; }
      var yes = b.getAttribute("data-consent") === "yes";
      try { localStorage.setItem("at_consent", yes ? "yes" : "no"); } catch (err) {}
      bar.hidden = true;
      if (yes) { load(); } else { dropGaCookies(); }
    });
  }
  // The footer's Cookies link reopens the question, so changing your mind is
  // one tap from every page, as easy as the first answer was.
  document.addEventListener("click", function (e) {
    var a = e.target.closest ? e.target.closest("[data-consent-open]") : null;
    if (!a || !bar) { return; }
    e.preventDefault();
    bar.hidden = false;
  });
})();
</script>
)}
<style>
  .consent-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 900;
    background: var(--cream); color: var(--ink); box-shadow: 0 -2px 16px rgba(26,32,18,0.12);
    padding: 14px var(--gutter) calc(14px + env(safe-area-inset-bottom));
    display: flex; align-items: center; gap: 16px; }
  .consent-bar[hidden] { display: none; }
  .consent-p { margin: 0; flex: 1 1 auto; font-size: 15px; line-height: 1.4; color: var(--ink); }
  .consent-p a { color: var(--ink); }
  .consent-btns { display: flex; gap: 10px; flex: none; }
  .consent-b { min-height: 44px; padding: 0 1.2rem; border: 0; border-radius: 999px; cursor: pointer;
    font: inherit; font-size: 15px; font-weight: 600; background: var(--cream-dark); color: var(--ink); }
  .consent-b:hover { background: #e0ded5; }
  @media (max-width: 600px) {
    .consent-bar { flex-direction: column; align-items: stretch; gap: 12px; }
    .consent-btns > .consent-b { flex: 1 1 0; }
  }
</style>
