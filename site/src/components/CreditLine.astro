---
/** One photo credit, printed from creditPieces(): the photographer's name
 *  linked to where the photograph came from, the licence label linked to its
 *  deed, each only when the address is known. Used by TreeCard and PhotoFigure
 *  so the two cannot disagree (compliance audit, 2026-11-10: CC BY and BY-SA
 *  ask for a link to the licence and the source where practicable).
 *  Reference: Wikimedia Commons' own "Use this file" credit, name and licence
 *  both linked. */
import { creditPieces } from "../lib/images";

interface Props {
  line: string;
  photo: { url?: string | null; attribution?: string | null; attribution_url?: string | null; license?: string | null };
}
const { line, photo } = Astro.props;
const c = creditPieces(line, photo);
---
{c.before}{c.nameHref ? <a href={c.nameHref} rel="noopener">{c.name}</a> : c.name}{c.between}{c.licence && (c.licenceHref ? <a href={c.licenceHref} rel="license noopener">{c.licence}</a> : c.licence)}{c.after}
