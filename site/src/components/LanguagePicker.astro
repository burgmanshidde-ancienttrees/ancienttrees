---
// The language switcher, built to the convention rather than invented.
//
// What it replaces, and why: the city pages carried a full SENTENCE in the
// other language ("このページは次の言語でもご覧いただけます 日本語."), which put
// two languages on one page and read as a fault to whichever reader you were.
// Hidde spotted it on the English Tokyo page.
//
// Convention check, run 2026-08-22 against the two references CLAUDE.md names
// for this kind of interaction. AllTrails ships a <select> in the footer whose
// options are AUTONYMS, the language written in its own language, with the
// region in brackets where variants exist: "Deutsch (Deutschland)",
// "Español (Latinoamérica)". komoot does the same thing, as a plain line at
// the very bottom. Neither uses flags, because a flag is a country and several
// of these languages have no single country. Neither redirects on
// Accept-Language, and neither do we: you get the page you asked for.
//
// The insight that fixes the mixed-language problem is that a LIST OF NAMES is
// not mixed language. "English · Deutsch · 日本語" reads as a set of labels in
// any language you happen to speak. A sentence does not.
//
// Rewritten 2026-09-17, on Hidde's "maak het zoals de concurrenten en
// toekomstbestendig", and it needed both halves.
//
// Like the competitors: it now offers EVERY language on every page that has
// one, which is what AllTrails does on all fourteen of theirs. Until today it
// read languagesForCity() and offered only the languages with a real overlay,
// so /aachen showed no picker at all. That was right while an untranslated
// city had nowhere to go, and wrong the moment the fallback layer landed and
// /es/aachen started existing.
//
// Future-proof: it takes the ENGLISH PATH rather than a city slug, and asks
// pathInEveryLanguage() where that page lives. So it works on a city, a tree,
// a question page, the map and the cities index without knowing which it is,
// it renders nothing on a page type that has no translated route yet rather
// than offering a 404, and when the next page type ships in seven languages
// the only edit is one line in that function.
import { LANG_NAME, pathInEveryLanguage } from "../lib/i18n";

interface Props {
  /** The language of the page this renders on. "en" is the canonical page. */
  current: string;
  /** This page's ENGLISH path, e.g. "/cadiz", "/cadiz/oldest-tree", "/explore". */
  enPath: string;
}
const { current, enPath } = Astro.props as Props;

const variants = pathInEveryLanguage(enPath);
const langs = Object.keys(variants).length ? ["en", ...Object.keys(variants).sort()] : [];
const href = (l: string) => (l === "en" ? enPath : variants[l]);
---
{langs.length > 1 && (
  <nav class="lang-pick" aria-label="Language">
    {langs.map((l, i) => (
      <>
        {i > 0 && <span class="lang-sep" aria-hidden="true">·</span>}
        {l === current
          ? <span class="lang-cur" aria-current="true">{LANG_NAME[l] ?? l}</span>
          : <a href={href(l)} hreflang={l} lang={l}>{LANG_NAME[l] ?? l}</a>}
      </>
    ))}
  </nav>
)}
