---
// The filter row over a map, and the species sheet its species chip opens:
// /explore and the city map (Hidde, 2026-11-01: "put the filters also on city
// map"). What the chips do is lib/map-filters-js.ts; the page wires it to its
// own map with atMapFilters().
//
// Convention: Google Maps' row of capsule chips over the top of the map
// (CONVENTIONS.md), which our own app draws too; AllTrails and Airbnb use a
// Filters button and sheet, the right shape for eight filters, not four.
//
// It is the APP'S chip, redrawn here rather than reinvented (Hidde,
// 2026-09-17: "de filters zien er totaal slecht uit neem de app als
// voorbeeld"). FilterChip.swift draws a 34-tall capsule carrying an icon and
// a 13pt medium label inside a 44-tall target, so the pill is its own element
// inside each button: 34 drawn, 44 hit. Four chips, because four is what the
// app's row carries today and a row of eight is a Filters sheet wearing the
// wrong clothes.
import Sheet from "./Sheet.astro";
import { icon } from "../lib/icons";
import { ui } from "../lib/i18n";

interface Props { lang?: string }
const { lang = "en" } = Astro.props;
const U = ui(lang);

/** The row's icons, Phosphor's bold set like the bookmark beside them
 * (never drawn by hand): seal-check, leaf and ticket, the app's
 * checkmark.seal, leaf and ticket in MapTab.filterRow. */
const ic = (name: string, extra = "") => icon(name, "bold", "mf-ic mf-ic-solid" + extra);
const ICON = {
  seal: ic("seal-check"),
  leaf: ic("leaf"),
  ticket: ic("ticket"),
  caret: ic("caret-down", " mf-caret"),
};
---
<div class="map-filters" role="group" aria-label={U.mapFilterGroup}>
  <button type="button" class="mf" data-f="fav" data-label={U.mapFilterFav} aria-pressed="false">
    <span class="mf-pill"><Fragment set:html={icon("bookmark-simple", "bold", "mf-ic mf-ic-solid")} />{U.mapFilterFav}</span>
  </button>
  <button type="button" class="mf" data-f="mine" data-label={U.mapFilterMine} aria-pressed="false">
    <span class="mf-pill"><Fragment set:html={ICON.seal} />{U.mapFilterMine}</span>
  </button>
  {/* The species chip opens a list you can type into, the app's
      SpeciesPicker (Hidde, 2026-10-31: "can we improve this also on app
      please thing cross platform always"). */}
  <button type="button" class="mf mf-species" id="mf-species-wrap" aria-haspopup="dialog" aria-controls="sp-sheet">
    <span class="mf-pill">
      <Fragment set:html={ICON.leaf} />
      <span class="mf-label" id="mf-species-label">{U.mapFilterSpecies}</span>
      <Fragment set:html={ICON.caret} />
    </span>
  </button>
  {/* Last, on Hidde's word (2026-09-12: "zet free to visit maar als
      laatst"), after the app's own order. */}
  <button type="button" class="mf" data-f="free" data-label={U.mapFilterFree} aria-pressed="false">
    <span class="mf-pill"><Fragment set:html={ICON.ticket} />{U.mapFilterFree}</span>
  </button>
  <span class="mf-count" id="mf-count" hidden></span>
</div>
<Sheet lang={lang} class="people-sheet sp-sheet" id="sp-sheet" aria-labelledby="sp-h">
  <h3 class="at-sheet-h" id="sp-h">{U.mapFilterSpecies}</h3>
  <label class="people-search"><Fragment set:html={icon("magnifying-glass", "bold", "ic")} /><input type="search" id="sp-q" placeholder={U.speciesSearchPrompt} aria-label={U.speciesSearchPrompt} autocomplete="off" /></label>
  <button type="button" class="sp-any" id="sp-any" hidden>{U.anySpecies}</button>
  <p class="people-empty" id="sp-empty" hidden>{U.speciesNoMatch}</p>
  <ul class="sp-list" id="sp-list"></ul>
</Sheet>
