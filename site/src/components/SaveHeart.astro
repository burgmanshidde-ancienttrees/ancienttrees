---
import { icon } from "../lib/icons";
// The save heart, everywhere a tree renders (Hidde, 2026-08-14: "please make
// the ux better", closing audit gap #2: AllTrails puts the heart on every
// card in every list, ours lived on the tree page alone). One component, one
// markup, painted and handled by TREE_ACTIONS_JS via delegation, so any page
// that renders this must also include TREE_ACTIONS_JS in its scripts. The
// sign-in sheet is no longer on that list: Base renders it on every page since
// 2026-09-18, because a component twelve pages had to remember existed on 58
// percent of the site.
//
// Labels ride on data attributes so the Spanish pages stay Spanish without a
// second component (paint() reads data-l-save / data-l-saved).
// The heart also carries what /saved needs to draw the same card the tree was
// saved FROM (Hidde, 2026-08-18: "het is wel leuk als de saved trees of het
// tree component altijd de foto gebruikt als die er is"). A save has always
// stored a name and a url; it now stores the photograph and the meta line too,
// so the saved list is the same card rather than a poorer cousin.
//
// treeUrl matters beyond the picture: the handler used location.pathname,
// which is the CITY page when you save from a city list, so every tree saved
// from a list linked back to the city instead of to itself.
interface Props {
  treeId: string;
  treeName: string;
  compact?: boolean;
  labelSave?: string;
  labelSaved?: string;
  treeUrl?: string;
  photo?: string;
  meta?: string;
  /** "round" is the app's bar circle (SaveHeart.swift, look .inBar): 52pt,
   *  hairline border, glyph only. The label stays in the markup, visually
   *  hidden, because the paint script writes Save/Saved into it and a screen
   *  reader still needs a word. */
  look?: "pill" | "round" | "card";
  /* "card" is the heart on a list card (2026-10-04): a white circle over the
   * photograph's top right, Airbnb's and AllTrails' heart and the app's
   * SaveHeart look .onPhoto. Glyph only, the word stays for screen readers. */
}
const { treeId, treeName, compact = false, labelSave = "Save", labelSaved = "Saved",
        treeUrl, photo, meta, look = "pill" } = Astro.props;
// Phosphor's outline and filled hearts, the app's heart / heart.fill pair
// (2026-09-24: no hand-drawn icons). CSS shows one or the other on aria-pressed.
// A BOOKMARK, the app's SaveHeart glyph since 2026-10-09 (Hidde: the list
// is "Want to visit", and a bookmark is what you put on a place to go).
const off = icon("bookmark-simple", "bold", "heart hi-off");
const on = icon("bookmark-simple", "fill", "heart hi-on");
---
<button
  class={`save-btn heart-btn${compact ? " heart-compact" : ""}${look === "round" ? " heart-round" : ""}${look === "card" ? " heart-card" : ""}`}
  type="button"
  data-tree={treeId}
  data-name={treeName}
  data-l-save={labelSave}
  data-l-saved={labelSaved}
  data-url={treeUrl}
  data-photo={photo}
  data-meta={meta}
  aria-pressed="false"
  aria-label={`${labelSave} ${treeName}`}
>
  <Fragment set:html={off + on} />
  <span class={look === "round" || look === "card" ? "sr-only" : undefined}>{labelSave}</span>
</button>
