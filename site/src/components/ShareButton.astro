---
import { icon } from "../lib/icons";
// One share control, used by every page type. See share-js.ts for why it is
// this shape and not a row of social icons: both references open the system
// sheet from a single round button, and a page that offers eight networks is
// a page from 2014.
interface Props {
  url: string;
  title: string;
  /// The accessible name. A prop because the site publishes in seven
  /// languages and a hard-coded English label would be wrong on six of them.
  label?: string;
  /// What it says once the link is copied, for the browsers with no system
  /// share sheet. On the button rather than in share-js.ts for the reason the
  /// label is: the script runs on eight languages and cannot hold words.
  copied?: string;
}
const { url, title, label = "Share", copied = "Link copied" } = Astro.props as Props;
---
<button type="button" class="share-btn" data-share data-share-url={url}
        data-share-title={title} data-share-copied={copied}
        aria-label={label} title={label}>
  <Fragment set:html={icon("export")} />
</button>
