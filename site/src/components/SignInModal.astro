---
// The one sign-in surface (Hidde, 2026-08-14, from AllTrails' modal: "will
// you also make a page like this whenever you use loginned features"). Every
// signed-in feature opens THIS dialog where the visitor stands, instead of
// navigating away: AllTrails converges save, send-to-phone and open-in-app on
// one modal, and this is ours. Offered in our honest order: one email for a
// magic link (our equivalent of their Google one-tap), the account page as
// More options, the app as the dark button.
//
// Open it from any script with atOpenSignIn(treeName), or any element carrying
// data-signin. The email flow happens inline (same OTP endpoint the account
// page uses) and the magic link returns to the CURRENT page; signin-js.ts
// parses the token hash on every page that includes this component, so
// logging in never loses the visitor's place.
//
// Trimmed to ONE job on 2026-08-20. It used to offer three: the email form,
// "More options", and "Get the app" as a filled dark button. "More options"
// linked to /account, which carries the same single email form and nothing
// more, so it was a fork in a road the visitor was already walking down. The
// app stays, as a plain link rather than a second primary button, because it
// is a different decision and it should not compete with this one.
//
// And the subtitle names the tree when there is one to name, because the tree
// somebody just reached for is the reason the dialog is open. It used to report
// a save that had already happened ("... is saved on this device only"); since
// 2026-08-30 saving needs an account (Hidde: "bewaren moet niet werken als je
// uitgelogd bent"), so nothing has been saved yet and the line asks rather than
// reports. Saying a tree was saved when it was not is the one thing this
// sentence must never do.
//
// The copy lives in lib/signin-strings.ts, in all eight languages we publish
// in. It used to be a `const T = es ? {...} : {...}` ternary here, written for
// the one-city Spanish test; a `lang` prop was bolted onto that on 2026-08-22
// without widening the copy, so from the seven-language rollout until
// 2026-09-02 every reader who was not Spanish or English got an English
// dialog, including the sentence about what personal data we store. A Record
// typed by Lang cannot be forgotten the way a ternary can: leave a language
// out and the build stops.
import { signInCopy } from "../lib/signin-strings";

interface Props { lang?: string }
const { lang = "en" } = Astro.props as Props;
const T = signInCopy(lang);
---
<dialog id="signin-dialog" class="collect-dialog signin-dialog">
  <button type="button" class="signin-close" id="signin-close" aria-label={T.close}>&#10005;</button>
  <p class="signin-mark" aria-hidden="true">&#127795;</p>
  <div id="signin-ask">
    <h3 id="signin-title" data-generic={T.title} data-feedback={T.titleFeedback}>{T.title}</h3>
    <p id="signin-sub" data-generic={T.sub} data-named={T.subNamed} data-feedback={T.subFeedback}>{T.sub}</p>
    {/* Google publishes this mark and its guidelines, so the button uses
    the asset rather than a pill with the words alone. CONVENTIONS.md,
    "A sign-in button": the provider ships it, use it. Hidde made this
    correction on 2026-08-20 and it was applied to the iOS app and not
    here, so the web button stayed a bare pill for a fortnight. */}
    <button type="button" class="oauth-btn" id="signin-google"><svg class="oauth-mark" viewBox="0 0 18 18" width="18" height="18" aria-hidden="true" focusable="false"><path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z"/><path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/><path fill="#FBBC05" d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z"/><path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"/></svg><span>{T.google}</span></button>
    <p class="signin-or">{T.or}</p>
    <form id="signin-form" class="signin-form" autocomplete="email">
      <input type="email" id="signin-email" placeholder={T.placeholder} aria-label={T.emailLabel} required>
      <button type="submit" class="go-btn">{T.send}</button>
    </form>
    <a class="signin-applink" href="/app" data-ev="app-cta">{T.app}</a>
    <p class="signin-fine" set:html={T.fine}></p>
  </div>
  <div id="signin-sent" hidden>
    <h3>{T.sentTitle}</h3>
    <p>{T.sentBody1}<strong id="signin-sent-to"></strong>{T.sentBody2}</p>
  </div>
</dialog>
