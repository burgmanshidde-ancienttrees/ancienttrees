---
// The one sign-in surface (Hidde, 2026-08-14, from AllTrails' modal: "will
// you also make a page like this whenever you use loginned features"). Every
// signed-in feature opens THIS dialog where the visitor stands, instead of
// navigating away: AllTrails converges save, send-to-phone and open-in-app on
// one modal, and this is ours. Offered in our honest order: one email for a
// magic link (our equivalent of their Google one-tap), the account page as
// More options, the app as the dark button.
//
// Open it from any script with atOpenSignIn(treeName), or any element carrying
// data-signin. The email flow happens inline (same OTP endpoint the account
// page uses) and the magic link returns to the CURRENT page; signin-js.ts
// parses the token hash on every page that includes this component, so
// logging in never loses the visitor's place.
//
// Trimmed to ONE job on 2026-08-20. It used to offer three: the email form,
// "More options", and "Get the app" as a filled dark button. "More options"
// linked to /account, which carries the same single email form and nothing
// more, so it was a fork in a road the visitor was already walking down. The
// app stays, as a plain link rather than a second primary button, because it
// is a different decision and it should not compete with this one.
//
// And the subtitle names the tree when there is one to name. A save that just
// happened is the reason the dialog is open, and "The Wertheimpark Wingnut is
// saved on this device only" is a sentence about the visitor. The generic line
// is a sentence about us.
interface Props { es?: boolean }
const { es = false } = Astro.props;
const T = es ? {
  title: "Tus árboles en todos tus dispositivos",
  sub: "Una cuenta gratuita, un email, sin contraseña. Tus árboles guardados te siguen a cualquier dispositivo.",
  subNamed: "%s está guardado solo en este dispositivo. Una cuenta gratuita, un email, sin contraseña, y tus árboles te siguen a todas partes.",
  placeholder: "tu@ejemplo.com",
  send: "Envíame un enlace de acceso",
  google: "Continuar con Google",
  or: "o",
  app: "Descarga la app",
  fine: 'Solo guardamos tu dirección de email, para los enlaces de acceso y nada más. <a href="/privacy">Privacidad</a>',
  sentTitle: "Mira tu bandeja de entrada",
  sentBody1: "Hemos enviado un enlace de acceso a ",
  sentBody2: ". Funciona una vez, caduca en 15 minutos y te trae de vuelta aquí.",
} : {
  title: "Keep your trees on every device",
  sub: "One free account, one email, no password. Your saved trees follow you everywhere.",
  subNamed: "%s is saved on this device only. One free account, one email, no password, and your trees follow you everywhere.",
  placeholder: "you@example.com",
  send: "Email me a sign-in link",
  google: "Continue with Google",
  or: "or",
  app: "Get the app",
  fine: 'We store only your email address, for sign-in links and nothing else. <a href="/privacy">Privacy</a>',
  sentTitle: "Check your inbox",
  sentBody1: "We sent a sign-in link to ",
  sentBody2: ". It works once, expires in 15 minutes, and brings you straight back here.",
};
---
<dialog id="signin-dialog" class="collect-dialog signin-dialog">
  <button type="button" class="signin-close" id="signin-close" aria-label="Close">&#10005;</button>
  <p class="signin-mark" aria-hidden="true">&#127795;</p>
  <div id="signin-ask">
    <h3>{T.title}</h3>
    <p id="signin-sub" data-generic={T.sub} data-named={T.subNamed}>{T.sub}</p>
    <button type="button" class="oauth-btn" id="signin-google">{T.google}</button>
    <p class="signin-or">{T.or}</p>
    <form id="signin-form" class="signin-form" autocomplete="email">
      <input type="email" id="signin-email" placeholder={T.placeholder} aria-label="Email address" required>
      <button type="submit" class="go-btn">{T.send}</button>
    </form>
    <a class="signin-applink" href="/app" data-ev="app-cta">{T.app}</a>
    <p class="signin-fine" set:html={T.fine}></p>
  </div>
  <div id="signin-sent" hidden>
    <h3>{T.sentTitle}</h3>
    <p>{T.sentBody1}<strong id="signin-sent-to"></strong>{T.sentBody2}</p>
  </div>
</dialog>
