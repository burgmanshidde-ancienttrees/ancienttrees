---
// THE SIGN-IN SHEET'S CONTENTS, once, for both surfaces that show them.
//
// Hidde, 2026-09-17, looking at /account on his phone after the deploy: "het
// lijkt niet echt live". It was live; he was looking at the PAGE, which had
// been given the sheet's button weights and not its shape, so it carried no
// icon, no headline, no continue-in-the-app and no second screen. Two surfaces
// for one act, kept in step by hand, drifting exactly as far as the last edit.
//
// CLAUDE.md already says how this ends: "user-facing features ship as shared
// components, because parity by hand does not survive contact with the page
// count". So the dialog and the account page now render the same file, and the
// only difference between them is the prefix on the ids and whether the
// headline is an h1 or an h3.
//
// The prefix exists because both are on /account at once: the page includes the
// dialog as well, and two elements cannot share an id. `acct-form` and
// `acct-email` keep their exact names, because account.astro's own script binds
// the submit and drives the sent/expired states off them.
import { signInCopy } from "../lib/signin-strings";
import { APPLE_SIGNIN } from "../lib/site-config";

interface Props { lang?: string; prefix?: string }
const { lang = "en", prefix = "signin" } = Astro.props as Props;
const T = signInCopy(lang);
const p = prefix;
// A page needs its h1; a dialog must not steal one from the page behind it.
const Heading = p === "signin" ? "h3" : "h1";
---
<img class="signin-icon" src="/assets/app-icon.png" alt="" width="56" height="56" loading="lazy" />
<Heading id={`${p}-title`} data-generic={T.title} data-feedback={T.titleFeedback} data-contribute={T.titleContribute} data-expired={T.titleExpired} data-app={T.appTitle}>{T.title}</Heading>
<p id={`${p}-sub`} class="signin-sub" data-generic={T.sub} data-named={T.subNamed} data-feedback={T.subFeedback} data-contribute={T.subContribute} data-expired={T.subExpired}>{T.sub}</p>

{/* Continue in the app: the loud slot on a phone, hidden everywhere else,
    revealed by signin-js. A laptop cannot honour it. */}
<a class="oauth-btn oauth-loud" id={`${p}-openapp`} href="/open" hidden data-ev="app-open"><span>{T.openApp}</span></a>

{/* Google is the front screen and Apple is behind More options, which is
    what AllTrails does and what Hidde asked for on 2026-09-17: "Google hoort
    daar Apple is de optie die vertoond wordt als je more options klikt". An
    earlier version of this file had them the other way round, arguing that
    Apple's Human Interface Guidelines demand the top slot. They do not: that
    rule binds an APP that offers a third-party sign-in, reviewed by Apple, and
    says nothing about a website. Following the reference beats reasoning from a
    guideline that does not apply here. */}
<button type="button" class="oauth-btn oauth-loud" id={`${p}-google`}><svg class="oauth-mark" viewBox="0 0 18 18" width="18" height="18" aria-hidden="true" focusable="false"><path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z"/><path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/><path fill="#FBBC05" d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z"/><path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"/></svg><span>{T.google}</span></button>

{/* The rule separates CONTINUING from SIGNING IN, so it appears only where
    there is an app button above it to separate. */}
<p class="signin-rule" id={`${p}-rule`} hidden><span>{T.or}</span></p>

{APPLE_SIGNIN && (
  <button type="button" class="oauth-btn oauth-quiet" id={`${p}-apple`} hidden><svg class="oauth-mark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M17.05 12.04c-.02-2.4 1.96-3.55 2.05-3.6-1.12-1.64-2.86-1.86-3.48-1.89-1.48-.15-2.89.87-3.64.87-.75 0-1.91-.85-3.14-.83-1.61.02-3.1.94-3.93 2.38-1.68 2.91-.43 7.22 1.2 9.58.8 1.16 1.75 2.46 3 2.41 1.21-.05 1.66-.78 3.12-.78 1.46 0 1.87.78 3.14.76 1.3-.02 2.12-1.18 2.91-2.34.92-1.34 1.3-2.64 1.32-2.71-.03-.01-2.53-.97-2.55-3.85z"/><path fill="currentColor" d="M14.72 4.7c.66-.8 1.11-1.92.99-3.03-.95.04-2.11.63-2.8 1.43-.61.71-1.15 1.85-1.01 2.94 1.07.08 2.15-.54 2.82-1.34z"/></svg><span>{T.apple}</span></button>
)}

{/* A button, not a field. The address is asked for on a step of its own. */}
<button type="button" class="oauth-btn oauth-quiet" id={`${p}-emailbtn`} hidden><span>{T.emailBtn}</span></button>

<button type="button" class="oauth-btn oauth-quiet" id={`${p}-more`}><span>{T.more}</span></button>

<div id={`${p}-rest`} hidden>
  <form id={`${p}-form`} class="signin-form" autocomplete="email">
    <input type="email" id={`${p}-email`} placeholder={T.placeholder} aria-label={T.emailLabel} required>
    <button type="submit" class="oauth-btn oauth-quiet"><span>{T.send}</span></button>
  </form>
  <a class="signin-applink" href="/app" data-ev="app-cta">{T.app}</a>
</div>

{/* Our statement of what personal data we hold. CLAUDE.md forbids softening or
    shortening it, and it is the same sentence on both surfaces because it is
    the same promise. */}
<p class="signin-fine" set:html={T.fine}></p>
