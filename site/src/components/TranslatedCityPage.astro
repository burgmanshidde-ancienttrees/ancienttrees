---
// The one translated-city implementation, shared by every language.
//
// Extracted 2026-08-22 from site/src/pages/es/[city].astro, which shipped as a
// deliberate second copy of the English template carrying a note that ten
// copies would be a maintenance bug. Contract J v1.13 turned that note into a
// rule when the site went from one translated language to seven.
//
// Everything factual still comes from the canonical English city file. This
// component renders it; data/i18n/<lang>/<slug>.json supplies only text, and
// ui(lang) supplies the chrome labels with English fallback per key.
import TreeCard from "./TreeCard.astro";
import LanguagePicker from "./LanguagePicker.astro";
import ShareButton from "./ShareButton.astro";
import Base from "../layouts/Base.astro";
import { TREE_ACTIONS_JS } from "../lib/tree-actions-js";
import { VISITED_SYNC_JS } from "../lib/visited-sync-js";
import { renderableTrees, treeSlugsForCity, hasQuestionPage, type CityEntry } from "../lib/trees";
import { usablePhoto } from "../lib/images";
import { speciesIcon } from "../lib/species-icons";
import { breadcrumbSchema, ldScript, SITE_SCHEMA, BASE_URL } from "../lib/schema";
import { mapHead } from "../lib/map";
import { type WalkMarker } from "../lib/walks";
import { cityMapScript } from "../lib/city-map-script";
import { SHEET_JS } from "../lib/sheet-js";
import { SHARE_JS } from "../lib/share-js";
import { hreflangForCity, QUESTION_SLUG, ui, cityTranslation, type CityTranslation } from "../lib/i18n";
import { getCollection } from "astro:content";
import { cityIsRenderable } from "../lib/trees";
import { nearbyCitiesFor, cityCentre } from "../lib/other-cities";

interface Props { lang: string; city: CityEntry; tr: CityTranslation; fallback?: boolean }
const { lang, city, tr, fallback = false } = Astro.props as Props;


const U = ui(lang);
const cslug = city.id;
/** Where this city's tree and question pages live. A translated city has them
 * in its own language; a fallback city does not, because only real
 * translations render tree pages (i18n.ts allTreePathsFor, 2026-09-17), so its
 * links point at the English ones. Getting this wrong is how 25,208 dead links
 * happened, so it is one helper rather than a decision at each call site.
 *
 * TREE pages only. The question page still renders as a fallback, so its link
 * stays in the reader's language whether or not the city is translated. */
const leaf = (slug: string) => (fallback ? `/${cslug}/${slug}` : `/${lang}/${cslug}/${slug}`);
const trees = renderableTrees(city);
const tslugs = treeSlugsForCity(city);
const selfUrl = `${BASE_URL}/${lang}/${cslug}`;
// A fallback page is the English text on a second URL, so it points its
// canonical at the English page. That is Google's own answer for the same
// language on two URLs, and it is why these pages carry no hreflang and stay
// out of the sitemap: they exist to be navigated to, never to compete.
const canonical = fallback ? `${BASE_URL}/${cslug}` : selfUrl;

// The overlay may name the country in its own language; the English city file
// is the fallback, which is honest rather than wrong and shows up as one
// English word on an otherwise translated page.
const countryLabel = (tr as CityTranslation & { country?: string }).country ?? city.data.country;

const markers: WalkMarker[] = trees.map((t, i) => ({
  lat: t.location.latitude!,
  lng: t.location.longitude!,
  label: String(i + 1),
  icon: speciesIcon(t),
  name: tr.trees[t.id].name,
  id: t.id,
  area: (t.location.neighbourhood ?? "").trim(),
  shot: Boolean(usablePhoto(t)),
  ...(t.paid_entry ? { paid: true } : {}),
}));

const crumbItems: [string, string | null][] = [
  [U.home, BASE_URL],
  [tr.city, null],
];

const listElements = trees.map((t, i) => ({
  "@type": "ListItem",
  position: i + 1,
  name: tr.trees[t.id].name,
  url: `${BASE_URL}${leaf(tslugs[t.id])}`,
  item: {
    "@type": "TouristAttraction",
    name: tr.trees[t.id].name,
    description: tr.trees[t.id].story.slice(0, 200),
    geo: { "@type": "GeoCoordinates", latitude: t.location.latitude, longitude: t.location.longitude },
  },
}));
const graph = [
  ...SITE_SCHEMA,
  { "@type": "ItemList", name: tr.title, itemListElement: listElements },
  { "@type": "FAQPage", mainEntity: tr.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
  breadcrumbSchema(crumbItems, selfUrl),
];
const headExtra = mapHead() + (fallback ? "" : "\n" + hreflangForCity(cslug, "city")) + "\n" + ldScript(graph);

const avgLat = markers.reduce((s, m) => s + m.lat, 0) / markers.length;
const avgLng = markers.reduce((s, m) => s + m.lng, 0) / markers.length;

const qslug = QUESTION_SLUG[lang] ?? "oldest-tree";

// The eight closest cities, the same foot the English city page carries
// (2026-09-24). Every renderable place has a page in this language, translated
// or fallback (allCityPathsFor), so the links stay in the reader's language.
const nearby = nearbyCitiesFor(
  cityCentre(city.data),
  (await getCollection("cities"))
    .filter(cityIsRenderable)
    .filter((e) => e.id !== cslug && e.data.trees.length > 0)
    .map((e) => ({ slug: e.id, city: e.data.city, ...cityCentre(e.data) })),
).map((c) => ({ ...c, city: cityTranslation(lang, c.slug)?.city || c.city }));
// Contract B v1.18, in every language: a one-tree place has no question page.
const cityHasQuestion = hasQuestionPage(city);
---
<Base title={tr.title} description={tr.meta_description} canonical={canonical} headExtra={headExtra} footer={false} lang={lang}>
  <div class="split">
    <aside class="panel" id="sheet">
      <div class="sheet-grab">
      <div class="panel-head">
        <nav class="crumbs" aria-label="Breadcrumb"><a href={`/${lang}/cities`}>{U.citiesCrumb}</a> › <span>{tr.city}</span></nav>
        <button type="button" class="sheet-back">{U.backToTrees(trees.length)}</button>
        <p class="eyebrow">{countryLabel}</p>
        <div class="page-head">
          <h1>{U.heading("")}<em>{tr.city}</em></h1>
          <ShareButton url={selfUrl} title={U.heading(tr.city)} label={U.share} copied={U.shareCopied} />
        </div>
        <p class="sheet-count">{U.treesOnMap(trees.length)}</p>
      </div>
      </div>
      <div class="sheet-body">
      <div class="city-intro">
        <p class="lede">{tr.intro}</p>
        <button type="button" class="city-intro-more">{U.readMore}</button>
        <p class="passport" id="passport" hidden>
          <strong><span id="passport-count">0</span> / {trees.length}</strong> {U.visitedOf(trees.length, tr.city)}
          <span class="passport-total" id="passport-total"></span>
        </p>
      </div>
      {trees.map((t, i) => {
        const x = tr.trees[t.id];
        return (
          <TreeCard tree={t} citySlug={cslug} treeSlug={tslugs[t.id]} index={i + 1}
                    variant="full" headingLevel={2} lang={lang} canTick fallback={fallback}
                    overrides={{ name: x.name, species: x.species, age: x.age_estimate, story: x.story }} />
        );
      })}
      <div class="panel-foot">
        <p class="subtle-suggest"><b>{U.mappingAll}</b> {U.missingOrWrong(tr.city)} <a href="/contribute?kind=tree">{U.tellUs}</a>.</p>
        <div class="take-with-you">
          <strong>{U.goingThere}</strong> <a href={`/${cslug}.gpx`} download>{U.downloadTrees(trees.length)}</a> {U.worksOffline}
        </div>
        {/* Between the offline file and the FAQ, exactly where the English
            city page puts it. Translated 2026-09-12. */}
        <div class="app-pitch">
          <strong>{U.appPitchCityTitle}</strong>
          <p>{U.appPitchCityBody}</p>
          <a class="go-btn" href="/app" data-app-modal data-ev="app-cta">{U.getTheApp}</a>
        </div>
        <h2>{U.faqHeading}</h2>
        <dl class="faq">
          {tr.faq.map((f) => (
            <Fragment>
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </Fragment>
          ))}
          {cityHasQuestion && (
            <Fragment>
              <dt>{U.moreOnOldest}</dt>
              <dd><a href={`/${lang}/${cslug}/${qslug}`}>{U.oldestQuestion(tr.city)}</a> {U.fullAnswer}</dd>
            </Fragment>
          )}
          {nearby.length > 0 && (
            <Fragment>
              <dt>{U.nearbyCities}</dt>
              <dd>
                {nearby.map((c) => (
                  <Fragment>
                    <a href={`/${lang}/${c.slug}`}>{c.city}</a>{" · "}
                  </Fragment>
                ))}
                <a href={`/${lang}/cities`}>{U.allCities}</a>
              </dd>
            </Fragment>
          )}
        </dl>
        <p class="suggest">{U.suggestTree} <a href="/contribute?kind=tree">{U.sendIt}</a>.</p>
        {/* Bottom of the sheet, the same position as the English city page
            (Hidde, 2026-09-19). It matters more here than there: a reader on
            /ja/rome already has the language they wanted, so the row of other
            languages is the last thing they need and it was the first thing
            they got. */}
        <div class="panel-lang"><LanguagePicker current={lang} enPath={`/${cslug}`} /></div>
      </div>
      </div>
    </aside>
    <div class="stage">
      <div id="map" class="map"></div>
      <div class="walks" id="walk">
        <div class="map-tools">
          {/* The walking-routes pill is pulled from the map, matching the
              English city page (Hidde, 2026-09-03: "de walkingroutes
              verwijzing op de stadskaarten nog even weghalen op web want
              die hebben we voorlopig nog niet"). Re-add when walks actually
              ship for real users. */}
          <button type="button" class="map-gps" id="gps-btn" aria-pressed="false" aria-label={U.whereAmI}>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="gps-ic"><circle cx="12" cy="12" r="3.2" fill="currentColor"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/><circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="2" fill="none"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <Fragment slot="scripts" set:html={TREE_ACTIONS_JS + VISITED_SYNC_JS + cityMapScript(markers, [avgLat, avgLng], null, [], []) + SHEET_JS + SHARE_JS} />
</Base>
