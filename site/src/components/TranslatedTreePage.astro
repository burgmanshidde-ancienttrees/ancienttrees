---// The one translated-tree implementation, shared by every language
// (Contract J v1.13). Extracted from the Spanish template on 2026-08-22.

// Spanish tree page: sibling of ../../[city]/[tree].astro for translated
// cities. Facts (coordinates, photo, licence) from the canonical city file,
// text from the overlay. Season block deliberately omitted (its generated
// labels are English); the collect dialog is translated but points at the
// same English /app page, which is where the product actually is.
import Base from "../layouts/Base.astro";
import SaveHeart from "./SaveHeart.astro";
import SignInModal from "./SignInModal.astro";
import { TREE_ACTIONS_JS } from "../lib/tree-actions-js";
import { SIGNIN_JS } from "../lib/signin-js";
import { cityIsRenderable, renderableTrees, treeSlugsForCity, distLabel, type CityEntry, type Tree } from "../lib/trees";
import { haversineKm } from "../lib/walks";
import { usablePhoto, thumbUrl } from "../lib/images";
import PhotoFigure from "./PhotoFigure.astro";
import { speciesIcon } from "../lib/species-icons";
import { breadcrumbSchema, ldScript, SITE_SCHEMA, BASE_URL } from "../lib/schema";
import { locationIsApproximate, metaForTree } from "../lib/tree-copy";
import { mapHead, singlePinScript } from "../lib/map";
import { hreflangForCity, QUESTION_SLUG, ui, type CityTranslation, type TreeTranslation } from "../lib/i18n";
import { hasWalksPage } from "../lib/city-walks";
import { treeSources } from "../lib/tree-sources";

function esc(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}


interface Props {
  lang: string;
  city: CityEntry;
  tree: Tree;
  x: TreeTranslation;
  allTrees: Tree[];
  tr: CityTranslation;
}
const { lang, city, tree, x, allTrees, tr } = Astro.props as Props;
const U = ui(lang);
const qslug = QUESTION_SLUG[lang] ?? "oldest-tree";

const cslug = city.id;
// The walk link opens the app overlay, since 2026-09-02 (Hidde: "stuur ze
// maar gewoon naar de app"), the same as its English twin. AppModal renders
// from Base.astro in this page's own language, so the dialog it opens is
// translated even though this link is not a page any more.
//
// The sticky bar's second link used to go to /[city]/walks as well while
// reading "More trees", which was two mistakes in one: it is not a walk
// promise, and it pointed at a page that no longer exists. It goes to the
// city page, which is where more trees actually are.
const cityHasWalksPage = hasWalksPage(city);
const tslugs = treeSlugsForCity(city);
const tslug = tslugs[tree.id];
const loc = tree.location;
const canonical = `${BASE_URL}/${lang}/${cslug}/${tslug}`;

const title = `${x.name}, ${tr.city}`.length <= 60 ? `${x.name}, ${tr.city}` : x.name;
// Answer before hook, in this page's own language. Until 2026-09-02 this was
// an inline copy of metaFromStory called metaEs, written when Spanish was the
// only translation, so seven languages shared a helper named after one of them
// and none of them answered what the tree is before hooking. The lead template
// per language lives in i18n.ts's metaLead.
const description = metaForTree(
  tree, tr.city, U.metaLead,
  { species: x.species, age_estimate: x.age_estimate, story: x.story });

function kmBetween(a: { latitude: number; longitude: number }, b: { latitude: number; longitude: number }): number {
  return haversineKm([a.latitude, a.longitude], [b.latitude, b.longitude]);
}
const here = { latitude: loc.latitude!, longitude: loc.longitude! };
const nearby = allTrees
  .filter((t) => t.id !== tree.id)
  .sort((a, b) => kmBetween(here, { latitude: a.location.latitude!, longitude: a.location.longitude! }) - kmBetween(here, { latitude: b.location.latitude!, longitude: b.location.longitude! }))
  .slice(0, 3);

const crumbItems: [string, string | null][] = [
  [U.home, BASE_URL],
  [tr.city, `${BASE_URL}/${lang}/${cslug}`],
  [x.name, null],
];

const photo = usablePhoto(tree);
let ogImage = "";
if (photo?.url) ogImage = `\n<meta property="og:image" content="${esc(thumbUrl(photo.url, 1200))}">`;

const isApprox = locationIsApproximate(tree);
const graph = [
  ...SITE_SCHEMA,
  {
    "@type": "TouristAttraction",
    name: x.name,
    description: x.story.slice(0, 300),
    isAccessibleForFree: (tree.access ?? "").toLowerCase().includes("free"),
    geo: { "@type": "GeoCoordinates", latitude: loc.latitude, longitude: loc.longitude },
  },
  breadcrumbSchema(crumbItems, canonical),
];
const headExtra = mapHead() + ogImage + "\n" + hreflangForCity(cslug, "tree", tslug) + "\n" + ldScript(graph);
// The sources are facts about the tree, not text about it, so they come from
// the canonical city file and are identical in every language. Only the
// heading and the line above them are looked up.
const sources = treeSources(tree);
const scripts = singlePinScript(loc.latitude!, loc.longitude!);
---
<Base title={title} description={description} canonical={canonical} headExtra={headExtra} lang={lang}>
  <main class="content-page has-tree-bar">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">{U.home}</a> › <a href={`/${lang}/${cslug}`}>{tr.city}</a> › <span>{x.name}</span></nav>
    {/* The app's tree page, ported 2026-09-04, identical to its English twin:
        picture first and full bleed, facts in one card, the closing paragraph
        as chips. Only the labels are looked up; the shape is the shape. */}
    {photo && photo.url ? (
      <PhotoFigure photo={photo} alt={x.name} lang={lang} variant="hero"
        widths={[700, 1100, 1600]} sizes="(max-width: 760px) 100vw, 760px" />
    ) : (
      <figure class="tree-noph tree-hero">
        <span class="tree-noph-art" aria-hidden="true"><Fragment set:html={`<svg viewBox="0 0 40 40">${speciesIcon(tree)}</svg>`} /></span>
        <figcaption>
          <b>{x.species}</b>
          {/* Never "con tu nombre". We do not publish a submitter's name, on
              any channel, ruled 2026-08-11; the English page never promised it
              and this one did. A photographer's credit is a different thing and
              is owed by the licence, not by us. */}
          <span>{U.noPhotoLicence}{" "}
          <a href="/contribute">{U.sendYours}</a> {U.willAppear}</span>
        </figcaption>
      </figure>
    )}
    <div class="tree-head">
      <h1>{x.name}</h1>
      <p class="tree-sub">{x.species}</p>
      <p class="tree-place">{[loc.neighbourhood, tr.city].filter(Boolean).join(", ")}</p>
    </div>
    <div class="fact-card">
      <div class="fact"><b>{x.age_estimate || U.unknownAge}</b><span>{U.factAge}</span></div>
      <div class="fact"><b>{x.species}</b><span>{U.labelSpecies}</span></div>
      <div class="fact"><b>{isApprox ? U.pinApproximate : U.pinExact}</b><span>{U.factPin}</span></div>
    </div>
    <div class="action-row">
      <a class="go-btn" href={`https://www.google.com/maps/dir/?api=1&destination=${loc.latitude},${loc.longitude}`} target="_blank" rel="noopener">{U.takeMeThere}</a>
      {cityHasWalksPage && (
        <a class="action-link" href="/app" data-app-modal data-ev="walks-app">{U.walkMoreTrees(tr.city)} {U.inTheApp}</a>
      )}
    </div>
    <div class="prose-block"><p>{x.story}</p></div>
    <dl class="facts">
      <dt>{U.labelSpecies}</dt><dd>{x.species}</dd>
      <dt>{U.labelAge}</dt><dd>{x.age_estimate}</dd>
      <dt>{U.labelLocation}</dt><dd>{loc.address ?? ""} ({loc.neighbourhood ?? ""})</dd>
      <dt>{U.labelAccess}</dt><dd>{x.access}</dd>
      <dt>{U.labelGettingThere}</dt><dd>{x.transport}</dd>
    </dl>
    <div class="map-embed"><div id="map" class="map"></div></div>
    <p class="go-note">{U.goNote} {x.transport}</p>
    {isApprox && (
      <p class="approx-note">
        {U.approxNote}{" "}
        <a href="/contribute?kind=correction">{U.knowExactly}</a>
      </p>
    )}
    {sources.length > 0 && (
      <section class="tree-sources">
        <h2>{U.sourcesHeading}</h2>
        <p>{U.sourcesLine}</p>
        <ul>
          {sources.map((s) => (
            <li>{s.href ? <a href={s.href} target="_blank" rel="noopener">{s.label}</a> : <span>{s.label}</span>}</li>
          ))}
        </ul>
      </section>
    )}
    <h2>{U.nearbyTrees}</h2>
    <div class="near-cards">
      {nearby.map((t) => (
        <a class="near-card" href={`/${lang}/${cslug}/${tslugs[t.id]}`}>
          <b>{tr.trees[t.id].name}</b>
          <span>{tr.trees[t.id].age_estimate} · {U.distanceAway(distLabel({ latitude: loc.latitude!, longitude: loc.longitude! }, { latitude: t.location.latitude!, longitude: t.location.longitude! }))}</span>
        </a>
      ))}
    </div>
    <section class="discover-more">
      <h2>{U.discoverMore}</h2>
      <div class="dm-chips">
        <a class="dm-chip" href={`/${lang}/${cslug}`}>{U.allTreesLink(allTrees.length, tr.city)}</a>
        <a class="dm-chip" href={`/${lang}/${cslug}/${qslug}`}>{U.whichIsOldest(tr.city)}</a>
      </div>
    </section>
    <div class="report">
      <strong>{U.couldUseHelp}</strong>
      <p class="report-line">{U.researchedRemotely}</p>
      <a class="report-btn" href="/contribute?kind=correction">{U.somethingWrong}</a>
      <a class="report-btn" href="/contribute?kind=tree">{U.suggestAnother}</a>
    </div>
    <div class="tree-bar" aria-label={U.actions}>
      <SaveHeart treeId={x.id} treeName={x.name} labelSave={U.cardSave} labelSaved={U.cardSaved} />
      <a class="tb-link dir-link" href={`https://www.google.com/maps/dir/?api=1&destination=${loc.latitude},${loc.longitude}`} target="_blank" rel="noopener">{U.takeMeThere}</a>
      <a class="tb-link" href={`/${lang}/${cslug}`}>{U.moreTrees}</a>
    </div>
    <SignInModal lang={lang} />
</main>
  <Fragment slot="scripts" set:html={scripts} />
</Base>
