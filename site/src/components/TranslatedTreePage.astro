---// The one translated-tree implementation, shared by every language
// (Contract J v1.13). Extracted from the Spanish template on 2026-08-22.

// Spanish tree page: sibling of ../../[city]/[tree].astro for translated
// cities. Facts (coordinates, photo, licence) from the canonical city file,
// text from the overlay. Season block deliberately omitted (its generated
// labels are English); the collect dialog is translated but points at the
// same English /app page, which is where the product actually is.
import Base from "../layouts/Base.astro";
import { TREE_ACTIONS_JS } from "../lib/tree-actions-js";
import { SHARE_JS } from "../lib/share-js";
import { WORTHIT_JS } from "../lib/worthit-js";
import { cityIsRenderable, renderableTrees, treeSlugsForCity, distSpanBetween, type CityEntry, type Tree } from "../lib/trees";
import { haversineKm } from "../lib/walks";
import { usablePhotos, thumbUrl } from "../lib/images";
import { ADD_PHOTO_JS } from "../lib/add-photo-js";
import { breadcrumbSchema, ldScript, SITE_SCHEMA, BASE_URL } from "../lib/schema";
import { metaForTree, girthLabel } from "../lib/tree-copy";
import { mapHead } from "../lib/map";
import { treePageScript } from "../lib/tree-page-js";
import { DOWNSIZE_JS } from "../lib/image-downsize-js";
import TreeDetail from "./TreeDetail.astro";
import { hreflangForCity, QUESTION_SLUG, ui, type CityTranslation, type TreeTranslation } from "../lib/i18n";
import { cityHasQuestionPage } from "../lib/question-page";
import { placeParts } from "../lib/place-line";

function esc(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}


interface Props {
  lang: string;
  city: CityEntry;
  tree: Tree;
  x: TreeTranslation;
  allTrees: Tree[];
  tr: CityTranslation;
}
const { lang, city, tree, x, allTrees, tr, fallback = false } = Astro.props as any;
const U = ui(lang);
const qslug = QUESTION_SLUG[lang] ?? "oldest-tree";
// Contract B v1.18, in every language: a one-tree place has no question page.
const cityHasQuestion = cityHasQuestionPage(allTrees.length);

const cslug = city.id;
const tslugs = treeSlugsForCity(city);
const tslug = tslugs[tree.id];
const loc = tree.location;
const selfUrl = `${BASE_URL}/${lang}/${cslug}/${tslug}`;
// English text on a second URL: canonical to the English page, no hreflang,
// and out of the sitemap. See i18n.ts fallbackCityTranslation.
const canonical = fallback ? `${BASE_URL}/${cslug}/${tslug}` : selfUrl;

const title = `${x.name}, ${tr.city}`.length <= 60 ? `${x.name}, ${tr.city}` : x.name;
// Answer before hook, in this page's own language. Until 2026-09-02 this was
// an inline copy of metaFromStory called metaEs, written when Spanish was the
// only translation, so seven languages shared a helper named after one of them
// and none of them answered what the tree is before hooking. The lead template
// per language lives in i18n.ts's metaLead.
const description = metaForTree(
  tree, tr.city, U.metaLead,
  { species: x.species, age_estimate: x.age_estimate, story: x.story });

function kmBetween(a: { latitude: number; longitude: number }, b: { latitude: number; longitude: number }): number {
  return haversineKm([a.latitude, a.longitude], [b.latitude, b.longitude]);
}
const here = { latitude: loc.latitude!, longitude: loc.longitude! };
const nearby = allTrees
  .filter((t) => t.id !== tree.id)
  .sort((a, b) => kmBetween(here, { latitude: a.location.latitude!, longitude: a.location.longitude! }) - kmBetween(here, { latitude: b.location.latitude!, longitude: b.location.longitude! }))
  .slice(0, 3);

const crumbItems: [string, string | null][] = [
  [U.home, BASE_URL],
  [tr.city, `${BASE_URL}/${lang}/${cslug}`],
  [x.name, null],
];

const shots = usablePhotos(tree);
// Same set as the English twin, because the photographs are the tree's rather
// than the page's. Only the labels are looked up.
const photo = shots[0] ?? null;
let ogImage = "";
if (photo?.url) ogImage = `\n<meta property="og:image" content="${esc(thumbUrl(photo.url, 1200))}">`;

const girth = girthLabel((tree as any).girth_cm);
const graph = [
  ...SITE_SCHEMA,
  {
    "@type": "TouristAttraction",
    name: x.name,
    description: x.story.slice(0, 300),
    isAccessibleForFree: (tree.access ?? "").toLowerCase().includes("free"),
    geo: { "@type": "GeoCoordinates", latitude: loc.latitude, longitude: loc.longitude },
  },
  breadcrumbSchema(crumbItems, canonical),
];
const headExtra = mapHead() + ogImage + (fallback ? "" : "\n" + hreflangForCity(cslug, "tree", tslug)) + "\n" + ldScript(graph);
// THE HEART ON THIS PAGE HAD NO SCRIPT BEHIND IT EITHER. TREE_ACTIONS_JS and
// SIGNIN_JS were imported at the top of this file and never put in the slot,
// so every translated tree page rendered a save button that painted nothing
// and did nothing, in seven languages. Found 2026-09-12 while wiring the tick,
// the same hour another session found the vote and the share button inert for
// the same reason. Both halves are here: the list is now the English page's.
// SIGNIN_JS left this list on 2026-09-18: the sheet and its script are Base's
// now, on every page, so there is no list to forget it from.
// VISITED_SYNC_JS left with the tick (2026-09-24): collecting is the app's.
const scripts = treePageScript(loc.latitude!, loc.longitude!)
  + WORTHIT_JS + SHARE_JS + TREE_ACTIONS_JS + DOWNSIZE_JS + ADD_PHOTO_JS;
const nearbyCards = nearby.map((t) => ({
  name: tr.trees[t.id].name,
  url: `/${lang}/${cslug}/${tslugs[t.id]}`,
  photo: usablePhotos(t)[0]?.url ?? null,
  meta: U.distanceAway(distSpanBetween(
    { latitude: loc.latitude!, longitude: loc.longitude! },
    { latitude: t.location.latitude!, longitude: t.location.longitude! })),
}));
// Names only, as the app labels its chips (2026-09-24).
const chips = [
  { href: `/${lang}/${cslug}`, label: tr.city, icon: "buildings" },
  ...(cityHasQuestion ? [{ href: `/${lang}/${cslug}/${qslug}`, label: U.chipOldest, icon: "hourglass" }] : []),
];
// The bare number, and a cap on the prose fallback. Same rule as the English
// page: the label carries the unit, and an age_estimate that runs to a
// sentence is cut at its first clause, because everything after the comma is
// provenance and belongs in the story (2026-09-04).
const ageLo = typeof tree.age_min === "number" && tree.age_min > 0 ? tree.age_min : null;
const ageHi = typeof tree.age_max === "number" && ageLo && tree.age_max > ageLo ? tree.age_max : null;
const ageNumber = ageLo ? (ageHi ? `${ageLo}-${ageHi}` : `${ageLo}`) : null;
const ageLabel = ageNumber ? U.factYearsOld : U.factAge;
const ageText = (x.age_estimate || "").split(/[,;(]/)[0].trim();
const ageValue = ageNumber ?? (ageText.length > 24 ? "" : ageText) || U.unknownAge;

---
<Base title={title} description={description} canonical={canonical} headExtra={headExtra} lang={lang}>
  <TreeDetail
    lang={lang} tree={tree} name={x.name} species={x.species} speciesUrl={null}
    story={x.story} access={x.access ?? ""} transport={x.transport ?? ""}
    ageLabel={ageLabel} ageValue={ageValue} girth={girth} girthLabel={U.labelGirth}
    recognise={null} address={loc.address ?? null}
    place={placeParts(loc.neighbourhood, tr.city, null).place}
    cityName={tr.city} cityUrl={`/${lang}/${cslug}`} crumbs={crumbItems} canonical={canonical}
    shots={shots} nearby={nearbyCards} chips={chips} />
  <Fragment slot="scripts" set:html={scripts} />
</Base>
