---
// ONE way to show a tree, everywhere (Hidde, 2026-08-18: "kunnen we niet een
// centraal component maken zodat we bomen overal op dezelfde manier weergeven
// ... ik denk dat de stadslijst nu het beste is ... en als we in de toekomst
// daar verbeteringen doorvoeren zorgen dat dat overal gebeurt consistent, of
// het nou andere taal of andere pagina is").
//
// Before this there were two: the city page's .tree-card, which he judged the
// best, and a smaller .entry used on the park, species and collection pages,
// with a 96px square thumb and one sentence. Every improvement to one of them
// missed the other, which is the same failure the 2026-08-14 audit found with
// hearts and the sign-in dialog and drew the same conclusion from: a
// user-facing thing that renders on nine page types in two languages has to
// be a component, because parity by hand does not survive the page count.
//
// The city card wins, as he said. What changes per page is how much TEXT it
// carries, and that is not a style choice: the story is 150-250 unique words
// and the city page is its canonical home, so repeating it on the species,
// park and collection pages would put the same paragraphs on four URLs, which
// SEO_GEO_BLUEPRINT.md's P3 forbids and Google reads as thin duplication.
// Hence one component, one look, two text lengths.
import { usablePhoto, imgSrcset, thumbUrl, creditRequired, creditText, creditLinkParts } from "../lib/images";
import { ui } from "../lib/i18n";
import { bestTimeShort } from "../lib/phenology";
import SaveHeart from "./SaveHeart.astro";

interface Props {
  tree: any;
  citySlug: string;
  treeSlug: string;
  /** The map number. Present on the city page, absent everywhere else, and it
   *  is what the meta/story indent lines up with, so no number means no indent. */
  index?: number;
  /** "full" gives the whole story, and belongs only on the tree's own city
   *  page. "compact" gives its first sentence. */
  variant?: "full" | "compact";
  /** Overrides the text entirely, for a collection's own line about the tree. */
  note?: string;
  /** The city page heads its cards with h2; pages that group by city already
   *  spent their h2 on the city name. */
  headingLevel?: 2 | 3;
  /** A species page repeating one species name down the whole page is noise. */
  omitSpecies?: boolean;
  /** True when `note` already states the tree's age as computed from its
   *  age_min/age_max bounds (the "oldest" ranking modes in collection-rank.ts).
   *  Without this, the card also prints the tree's own hand-written
   *  `age_estimate` in tree-meta, and the two can name different numbers for
   *  the same tree on the same card (REVIEW.md BLOCKER, 2026-09-26: General
   *  Sherman read "roughly 2,300 to 2,700 years" in tree-meta and "Roughly
   *  2,200 to 3,200 years old." one line below it). */
  omitAge?: boolean;
  /** Any language with a data/i18n/<lang>/ directory; "en" is the canonical
   * English page. Widened from an "en" | "es" union on 2026-08-22 when
   * Contract J went to seven languages. */
  lang?: string;
  /** True when this card sits on a FALLBACK page: the city has no overlay in
   * `lang`, so its tree pages do not exist there (i18n.ts allTreePathsFor,
   * 2026-09-17) and the card must link at the English URL. Without it this
   * card produced 20,984 dead links the moment the fallback tree pages went. */
  fallback?: boolean;
  /** A translated city page carries its own translated name, species and age. */
  overrides?: { name?: string; species?: string; age?: string; story?: string };
  /** The tick, on the pages that are the web's answer to the app's map screen:
   *  the city page, where the pins and the passport counter read the same
   *  answer. Off elsewhere, because the app's own card shows the ticked state
   *  and offers the action from the map, not from a list of suggestions. A page
   *  that passes this must also ship VISITED_SYNC_JS (qa.py checks). */
  canTick?: boolean;
}

const {
  tree, citySlug, treeSlug, index, variant = "compact", note,
  headingLevel = 3, omitSpecies = false, omitAge = false, lang = "en", overrides, canTick = false, fallback = false,
} = Astro.props as Props;

// Labels come from the one shared table rather than a ternary, which is what
// stopped scaling the moment there was a third language. ui() falls back to
// English per key, so an unwritten label shows English instead of blank.
const U = ui(lang);
const L = { more: U.cardMore, save: U.cardSave, saved: U.cardSaved,
            treeLabels: U.treeLabels, seen: U.seenIt, done: U.seenItDone };

const name = overrides?.name ?? tree.name;
const species = overrides?.species ?? tree.species ?? "";
const age = overrides?.age ?? tree.age_estimate ?? "";
const story = overrides?.story ?? tree.story ?? "";
const photo = usablePhoto(tree);
// The photographer's name as a link when the record asks for it (attribution_url).
const creditLine = photo && creditRequired(photo.license) ? creditText(photo.attribution, photo.license) : null;
const creditLink = creditLine && photo?.attribution_url
  ? { href: photo.attribution_url, ...creditLinkParts(U.photoCredit(creditLine), photo.attribution, photo.license) }
  : null;
// The href is functional rather than cosmetic, so it generalises properly:
// English lives at the root, every other language under its own prefix.
const href = lang === "en" || fallback ? `/${citySlug}/${treeSlug}` : `/${lang}/${citySlug}/${treeSlug}`;

// A compact card takes the first sentence. Splitting on ". " alone cut
// "Quercus robur. It stands..." in the wrong place on any story opening with
// an abbreviation, so the split needs a following capital.
function firstSentence(s: string): string {
  const m = s.match(/^.*?[.!?](?=\s+[A-Z"'(])/);
  const out = (m ? m[0] : s).trim();
  return out.length > 200 ? out.slice(0, 197).trimEnd() + "..." : out;
}

const text = note ?? (variant === "full" ? story : firstSentence(story));
// ONE SHAPE ON EVERY LIST (Hidde, 2026-10-04, choosing variant 3 of three
// mockups: "versie 3 ziet er goed uit ... verwerk gelijk consistent over alle
// lijsten"). AllTrails' list card: the photograph full width at the top with
// the heart on it, then the map number beside a bold name (Hidde, same day:
// "moet het getal niet ... bij de titel", so it sits there on every card), one meta line and two
// lines of story. A tree without a photograph gets NO empty frame (variant 2
// tried that, and three of Barcelona's first four cards were blank boxes):
// the heart moves to the end of the name row. The whole story stays in the HTML and is clamped to two
// lines by CSS, so Contract C's story is still on the page for search.
//
// THE WHOLE CARD OPENS THE TREE, on every page, the city page included
// (Hidde, 2026-10-04, on a Barcelona card: "the save and I've seen this one
// clutter this page ... the app just makes the whole tile clickable"). The
// references agree with the app: Airbnb's and AllTrails' list cards are one
// link each, with the heart as a small icon on the photograph and nothing else
// to press (CONVENTIONS.md 2026-10-04). So the action row and the "Read more
// and get directions" line are gone: the tree page has both, and the card's
// one job is to get you there. Ticking a tree off lives on its page; the card
// only SHOWS that you have, as the app's `ticked` badge does.
//
// The stretched-link pattern rather than an anchor around the card, because
// the card still holds the heart and sometimes a credit link, and interactive
// content cannot be nested inside a link. On the city page a tap on the card
// used to select the pin instead; the pin itself still does that, and hovering
// a card on a desktop lights its pin (city-map-script.ts).
const linkName = true;
// The meta line is the same three facts in the same order on every page, which
// is most of what "shown the same way" means to a reader.
const metaParts = [omitSpecies ? "" : species, omitAge ? "" : age, (tree.location?.neighbourhood ?? "").trim()]
  .map((s) => (s ?? "").trim())
  .filter(Boolean);
const bestTime = bestTimeShort(tree);

function esc(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}
// The app's `ticked` mark, drawn the way collection-js.ts draws it on /saved.
const SEEN_MARK = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12.5l2.2 2.2L16 9.8" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9.4" fill="none" stroke="#fff" stroke-width="1.6" opacity="0.6"/></svg>';
const metaHtml = metaParts.map(esc).join(" &middot; ") + (bestTime ?? "");
---
<article
  class:list={["tree-card", "tree-card-link", { "tree-card-nonum": index === undefined, "tree-card-nophoto": !(photo && photo.url) }]}
  id={index === undefined ? undefined : `tree-${index}`}
  data-tree-id={tree.id}
>
  {photo && photo.url && (
    <Fragment>
      <div class="tree-card-photo">
        <img {...imgSrcset(photo.url, [500, 900], "(max-width: 800px) 100vw, 560px")} alt={name} loading="lazy" />
        <SaveHeart treeId={tree.id} treeName={name} look="card" labelSave={L.save} labelSaved={L.saved}
                   treeUrl={href}
                   photo={photo?.url ? thumbUrl(photo.url, 500) : undefined}
                   meta={metaParts.join(" \u00b7 ") || undefined} />
        {canTick && <span class="tree-card-seen" data-tree={tree.id} hidden><Fragment set:html={SEEN_MARK} /><span>{L.done}</span></span>}
      </div>
      {creditLine && (creditLink
        ? <p class="tree-card-credit">{creditLink.before}<a href={creditLink.href} rel="noopener">{creditLink.name}</a>{creditLink.after}</p>
        : <p class="tree-card-credit">{U.photoCredit(creditLine)}</p>
      )}
    </Fragment>
  )}
  <div class="tree-card-top">
    {!(photo && photo.url) && <SaveHeart treeId={tree.id} treeName={name} look="card" labelSave={L.save} labelSaved={L.saved}
                treeUrl={href}
                photo={photo?.url ? thumbUrl(photo.url, 500) : undefined}
                meta={metaParts.join(" \u00b7 ") || undefined} />}
    {index !== undefined && <span class="tree-num">{index}</span>}
    {headingLevel === 2 ? (
      <h2 class="tree-name">
        {linkName ? <a href={href}>{name}</a> : name}
        {tree.label && <span class="tree-label">{L.treeLabels[tree.label] ?? tree.label}</span>}
      </h2>
    ) : (
      <h3 class="tree-name">
        {linkName ? <a href={href}>{name}</a> : name}
        {tree.label && <span class="tree-label">{L.treeLabels[tree.label] ?? tree.label}</span>}
      </h3>
    )}
  </div>
  {metaHtml && <p class="tree-meta" set:html={metaHtml} />}
  {text && <p class="tree-story">{text}</p>}
  {canTick && !(photo && photo.url) && <p class="tree-card-seen-line" data-tree={tree.id} hidden><span class="tree-card-seen"><Fragment set:html={SEEN_MARK} /><span>{L.done}</span></span></p>}
</article>
