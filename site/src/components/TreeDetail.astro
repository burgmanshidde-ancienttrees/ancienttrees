---
// THE TREE PAGE, ONE BODY FOR EIGHT LANGUAGES (2026-09-24).
//
// Convention: our own app's tree page, TreeDetail.swift, taken literally (Hidde,
// 2026-09-24: "look at the design of the detail tree page of the app and
// literally translate that to web - there are so much more not needed info on
// the web page that can be deleted and the design of the app is better"). He
// approved the mockup of this layout the same day, with one change of his own:
// the big button is Open in the app, not Take me there.
//
// Top to bottom, as the app draws it: share and report above the picture; the
// picture full bleed with the map in its corner; the name, the place and the
// thumb; one card for age and species; the story; how to get in and how to get
// there; Something's wrong; Discover more; and a bar pinned to the bottom.
//
// What the web keeps that the app does not have, and why, so nobody tidies it
// away: the breadcrumbs and "Trees nearby" (Contract A's internal links, which
// are how Google finds the rest of a city), the scientific name under the
// common one (Contract A's fact block), the address and recognition line in
// the getting-there block (the recognition line is how somebody standing in a
// park tells our tree from its neighbours), and the season chart on English
// pages, which is one of the four verbs.
//
// What went, because it was on the web only and said nothing the page did not
// already say: the duplicate facts list, the note under the map, the walk link,
// the app pitch, the two help boxes at the foot, and the Sources list.
//
// THE SEAL CAME BACK on 2026-10-10 (Hidde: "make the collect this tree and
// uncollect more consistent on web and app"): the same circle the app's bar
// carries, opening the same sheet, with the same question before a tree leaves
// your collection. The board he approved is "Collected, and the way back".
//
// Both tree templates build their data and hand it here, so a control added to
// this file reaches every language by construction, which is the fault
// check_every_language_gets_the_same_controls() in qa.py exists to catch.
import Breadcrumbs from "./Breadcrumbs.astro";
import PhotoFigure from "./PhotoFigure.astro";
import { OPEN_APP_URL } from "../lib/site-config";
import AddPhoto from "./AddPhoto.astro";
import WorthIt from "./WorthIt.astro";
import SaveHeart from "./SaveHeart.astro";
import ShareButton from "./ShareButton.astro";
import Sheet from "./Sheet.astro";
import { latinHtml } from "../lib/latin";
import { imgSrcset, photoDims } from "../lib/images";
import { locationIsApproximate } from "../lib/tree-copy";
import { icon } from "../lib/icons";
import { ui } from "../lib/i18n";
import { treeSources } from "../lib/tree-sources";
import { officialRegister } from "../lib/official-register";
import type { Tree } from "../lib/trees";

interface Props {
  lang: string;
  tree: Tree;
  name: string;
  /** The species as stored, "Common (Scientific)". */
  species: string;
  speciesUrl?: string | null;
  story: string;
  access: string;
  transport: string;
  ageLabel: string;
  ageValue: string;
  girth?: string | null;
  girthLabel: string;
  recognise?: string | null;
  address?: string | null;
  /** The district, last in the breadcrumb and plain text: there is no page
   * for it, so it must not look like a link (lib/place-line.ts placeDistrict). */
  district?: string | null;
  /** First in the breadcrumb, a link when the country has a page. Null on the
   * translated pages, which have no country pages. */
  country?: string | null;
  countryUrl?: string | null;
  cityName: string;
  cityUrl: string;
  crumbs: [string, string | null][];
  canonical: string;
  shots: any[];
  nearby: { name: string; url: string; meta: string; photo?: string | null }[];
  /** The nearest trees of the same place, nearest first, for the borrowed
   * note under an empty notes block (tree-notes-js.ts). */
  nearNotes?: { id: string; name: string; url: string }[];
  /** The park this tree stands in, when we publish a page about it: the one
   * link under the title since 2026-10-24 (CONVENTIONS.md, "Under the title:
   * the last step"). */
  parkName?: string | null;
  parkUrl?: string | null;
  chips: { href: string; label: string; icon: string }[];
  seasonHtml?: string;
}
const p = Astro.props as Props;
const U = ui(p.lang);
const tree = p.tree;
const loc = tree.location;
const photo = p.shots[0] ?? null;
const isApprox = locationIsApproximate(tree);
// The per-tree sources, back on 2026-10-01 after Google's 09-28 demotion
// (Hidde: "punt 1 klinkt als een goed idee"). They were taken off on 09-24 as
// noise; Google's own self-assessment asks whether a page shows "clear
// sourcing", and for a site whose stories are written at scale the visible
// sources are the evidence that each one was checked. Facts, not text, so
// identical in every language; only the heading and line are looked up.
const sources = treeSources(tree);
const register = officialRegister(tree as any);

// "Moreton Bay Fig (Ficus macrophylla)" -> the name a reader knows. The card
// shows only that, exactly as the app's card does (Hidde, 2026-09-24: "maak
// het zoals app"); the scientific name is in the story and the species page.
const m = /^(.*?)\s*\(([^)]+)\)\s*$/.exec(p.species || "");
const spCommon = m ? m[1] : p.species;

// ANOTHER DOMAIN ON PURPOSE (2026-10-19, CONVENTIONS.md "Open in app from the
// website"): iOS opens the app from a universal link only when it is tapped on
// a different domain, so a link to ancienttrees.app/open from ancienttrees.app
// always went to the App Store. AllTrails does the same with its link domains.
const openUrl = `${OPEN_APP_URL}?tree=${encodeURIComponent(tree.id)}`;
const google = `https://www.google.com/maps/dir/?api=1&destination=${loc.latitude},${loc.longitude}&travelmode=walking`;
const expandUrl = `${p.cityUrl}#tree=${encodeURIComponent(tree.id)}`;
const movedTemplate = U.pinMoved(987654).replace("987654", "{m}");
const visibleCrumbs = p.crumbs.slice(0, -1);
// A PORTRAIT OR SQUARE LEAD on a desktop stands beside the facts at its own
// shape instead of being cut into the wide strip (Hidde, 2026-10-13, on the
// Munch-eika: "portrait trees really come out bad on desktop"; option A of the
// benchmark, Wikipedia and Unsplash; half the photographed trees are portrait).
// 4:3 stays in the strip on a desktop (Hidde, 2026-10-15: beside the facts it
// came out small with a gap under it; the hero itself is to be discussed),
// while the phone keeps 4:3 at its own shape (HERO_OWN_SHAPE_BELOW, images.ts).
// Landscape keeps the strip. Decided from the stored
// size, so the page is laid out right before the picture arrives.
const leadDims = photoDims(photo);
const tall = !!(photo && photo.url && leadDims.width && leadDims.width / leadDims.height < 1.25);
// NEVER TALLER THAN 3:4 (Hidde, 2026-10-14, on a 9:16 phone photo of the Su
// Fundale oak: "this page doesnt seem balanced ... it looks better at the other
// page", the 3:4 Sa Tuppa cork oak). A taller photo is cropped to 3:4 around
// its middle, so the column keeps one proportion beside the facts.
const tallAr = tall ? Math.max(leadDims.width / leadDims.height, 0.75) : 0;
// The seal, empty and filled, painted by aria-pressed like the bookmark.
const sealOff = icon("camera", "bold", "ic seal-off");
const sealOn = icon("seal-check", "fill", "ic seal-on");
// ACCESS ONLY WHEN THERE IS SOMETHING TO MEET (Hidde, 2026-10-24: "free public
// space we can leave that out, lets only say something when its paid").
// AllTrails prints "Fee required" on a trail that charges and nothing on one
// that does not. A line that is only "Free, public park" says nothing a
// visitor must know; hours, a gate, a ticket, a view-only spot or a desk do.
// The same line is rendered in every language, so the test reads the English
// data field, never the translation.
const accessPlainFree = /^free\b/i.test(p.access || "") &&
  !/\d|gate|book|reception|ticket|closed|fenc|private|view|hour|open(ing)? (from|at)|permission|ask|entrance|locked|behind|except|but|however|not /i.test(p.access || "");
const accessRow = !tree.paid_entry && !!p.access && !accessPlainFree;
// Under the title, the park once: when the district IS the park, the link
// alone (Villa Bellini is not "Villa Bellini · Villa Bellini").
const parkLink = p.parkUrl && p.parkName ? { name: p.parkName, url: p.parkUrl } : null;
const districtShown = p.district && !(parkLink && p.district.toLowerCase() === parkLink.name.toLowerCase()) ? p.district : null;
const noPhoto = !(photo && photo.url);
const nearNotesJson = JSON.stringify((p.nearNotes ?? []).slice(0, 12));
---
<main class:list={["content-page", "td-page", { "td-tall": tall, "td-nophoto-page": noPhoto }]}
  style={tall ? `--td-ar:${tallAr.toFixed(4)}` : undefined}>
  {/* WHERE YOU ARE, a thin row, and nothing else (Hidde, 2026-09-24: the
      white bar holding share "is logical in the app because of the back
      button, not on the web"). AllTrails' trail page on mobile web, read the
      same day: breadcrumbs under the header, then the photograph carrying its
      actions as round buttons in its top-right corner. */}
  <div class="td-top"><Breadcrumbs items={visibleCrumbs} /></div>

  {/* THE PICTURE, full bleed, and the map in its corner (TreeDetail.swift
      `hero`, MapInset.swift: 72 points, radius 10, a 2 point white rim). The
      #map element is moved into the side card on a desktop by
      tree-page-js.ts, so there is only ever one map on the page. */}
  <div class="td-hero">
    {photo && photo.url ? (
      <PhotoFigure photo={photo} photos={p.shots} alt={p.name} lang={p.lang} variant="hero"
        widths={[700, 1100, 1600]} sizes="(max-width: 900px) 100vw, 720px">
        <Fragment slot="overlay">
          <a class="td-back" href={p.cityUrl} aria-label={U.goBack} title={U.goBack}><Fragment set:html={icon("arrow-left")} /></a>
          <div class="td-tools">
            <ShareButton url={p.canonical} title={p.name} label={U.share} copied={U.shareCopied} />
            <WorthIt treeId={tree.id} city={p.cityName} treeName={p.name} part="flag" lang={p.lang} />
          </div>
          <div class="td-inset"><div id="map" class="map td-map"></div></div>
          <button type="button" class="td-inset-hit" aria-label={U.showOnMap}></button>
          <button type="button" class="td-photo-back" aria-label={U.showPhoto}>
            <img {...imgSrcset(photo.url, [250], "72px")} alt="" loading="lazy" />
          </button>
          <a class="td-expand" href={expandUrl} aria-label={U.openFullMap} title={U.openFullMap}><Fragment set:html={icon("arrows-out-simple")} /></a>
        </Fragment>
      </PhotoFigure>
    ) : (
      <figure class="tree-noph tree-hero td-nophoto">
        {/* NO PHOTOGRAPH: THE MAP IS THE PICTURE (Hidde, 2026-10-24, CONVENTIONS.md
            "A tree page without a photograph: the map is the picture"). Google
            Maps always opens a place on the map; AllTrails' preview map stands
            alone when a trail has no photos; none of them draws an empty frame.
            The one #map element fills the stage, non-interactive, the whole
            stage a link to the city map on this tree; at its foot one card
            carries the ask and the existing Add a photo control. No inset, no
            swap button: the hero is the map. */}
        <div class="photo-stage">
          <div class="td-inset"><div id="map" class="map td-map"></div></div>
          <a class="td-inset-hit" href={expandUrl} aria-label={U.openFullMap} title={U.openFullMap}></a>
          <a class="td-back" href={p.cityUrl} aria-label={U.goBack} title={U.goBack}><Fragment set:html={icon("arrow-left")} /></a>
          <div class="td-tools">
            <ShareButton url={p.canonical} title={p.name} label={U.share} copied={U.shareCopied} />
            <WorthIt treeId={tree.id} city={p.cityName} treeName={p.name} part="flag" lang={p.lang} />
          </div>
          <div class="td-hero-ask">
            <div class="td-hero-ask-t"><b>{U.noPhotoYet}</b><span>{U.noPhotoAsk}</span></div>
            <div class="td-addphoto">
              <AddPhoto treeId={tree.id} treeName={p.name} lat={loc.latitude!} lng={loc.longitude!} lang={p.lang} />
            </div>
          </div>
        </div>
      </figure>
    )}
  </div>

  <div class="td-grid">
    <div class="td-body">
      {/* ONE GROUP at 8: what this tree IS. */}
      <div class="td-group">
        <h1>{p.name}{(tree as any).label && <span class="tree-label">{(tree as any).label}</span>}</h1>
        <div class="tree-place-row">
          {/* THE LAST STEP ONLY (Hidde, 2026-10-24: "is de home portugal
              lisbon crumble wel nodig als portugal en lisbon ook onder de
              titel staan?"; CONVENTIONS.md "Under the title: the last step,
              not the path again"). AllTrails, read on the Wayback copy of the
              Muir Woods page: the crumb at the top carries the path, the line
              under the title carries the direct holder as one link. The crumb
              above stays (blueprint line 36). Here: the district, plain
              because it has no page, the park as a link where a park page
              exists, and the thumb. The 2026-10-08 country-city-district line
              is superseded. Without a district the city stands in, so the
              row never shows a lone thumb. */}
          <p class="tree-place">
            {districtShown && <span class="tree-place-district">{districtShown}</span>}
            {!districtShown && !parkLink && <a href={p.cityUrl}>{p.cityName}</a>}
            {districtShown && parkLink && <span class="tree-place-sep" aria-hidden="true">·</span>}
            {parkLink && <a href={parkLink.url}>{parkLink.name}</a>}
          </p>
          <span class="tree-place-dot" aria-hidden="true">·</span>
          <WorthIt treeId={tree.id} city={p.cityName} treeName={p.name} part="vote" lang={p.lang} />
        </div>
        <div class="tree-block">
          <div class="tb-cols">
            <div class="tb-col tb-age"><span>{p.ageLabel}</span><b>{p.ageValue}</b></div>
            {p.girth ? (
              <div class="tb-col tb-girth"><span>{p.girthLabel}</span><b>{p.girth}</b></div>
            ) : (
              <Fragment>
                {p.speciesUrl ? (
                  <a class="tb-col tb-species" href={p.speciesUrl}><span>{U.labelSpecies}</span><b>{spCommon}<Fragment set:html={icon("caret-right", "bold", "ic fact-go")} /></b></a>
                ) : (
                  <div class="tb-col tb-species"><span>{U.labelSpecies}</span><b>{spCommon}</b></div>
                )}
              </Fragment>
            )}
          </div>
          {p.girth && p.speciesUrl && <a class="tb-row tb-species" href={p.speciesUrl}><span>{U.labelSpecies}</span><b>{spCommon}<Fragment set:html={icon("caret-right", "bold", "ic fact-go")} /></b></a>}
          {p.girth && !p.speciesUrl && <div class="tb-row tb-species"><span>{U.labelSpecies}</span><b>{spCommon}</b></div>}
          {isApprox && (
            <p class="tb-loc tb-loc-approx">
              <b>{U.locApprox}</b>{" "}
              <button type="button" class="td-pin-open">{U.pinShowUs}</button>
            </p>
          )}
          {tree.paid_entry && (
            <p class="tb-ticket">
              <Fragment set:html={icon("ticket", "fill", "ic tb-ticket-ic")} />
              <span class="tb-ticket-txt"><b>{U.ticketNeeded}</b><span>{p.access}</span></span>
            </p>
          )}
        </div>
      </div>

      {/* YOUR PHOTOGRAPHS OF THIS TREE, under the facts, as on the app's tree
          page (TreeDetail.swift yourPhotos). The tree's own picture stays the
          lead, yours is yours: CONVENTIONS.md, "Your own photograph of a place
          somebody else maps". Filled by ADD_PHOTO_JS from the account; hidden
          for anybody with none (Hidde, 2026-10-12: "i see the original photo
          not the photo i had taken"). */}
      <section class="td-yours" id="td-yours" hidden data-one={U.yourPhoto} data-many={U.yourPhotos} data-more={U.photoMore} data-deleted={U.photoDeleted} data-more-icon={icon("dots-three", "bold")}>
        <h2 class="td-yours-h"></h2>
        <div class="td-yours-row"></div>
      </section>

      {/* THE STORY, collapsed to about six lines with Read more (Hidde,
          2026-10-24, lifting his 09-27 wish for the full text: "look at the
          page holistically"). AllTrails and Google Maps both truncate the
          description and put the practical rows before the long text. The
          inline script at the foot collapses only a story that is really
          longer than the window, so a short one never gets a button. */}
      <div class="td-story-wrap">
        <div class="prose-block td-story"><p set:html={latinHtml(p.story)} /></div>
        <button type="button" class="td-story-more" data-more={U.readMore} data-less={U.readLess} hidden>{U.readMore}</button>
      </div>

      {/* FROM PEOPLE WHO STOOD HERE (2026-10-24; CONVENTIONS.md "Notes from
          visitors on a tree page"): komoot's Tips, AllTrails' reviews. One
          note per person per tree, dated, live at once, no replies or likes.
          Filled by TREE_NOTES_JS; what is rendered here is the empty state's
          ghost example (Apple HIG: show what the content will look like),
          replaced by the real notes, or by the nearest tree's real note when
          this tree has none (Airbnb). One button, the guidance inside the
          sheet (Hidde: "the text and button dont really work together").
          Above Getting there since 16:09 the same day (Hidde: "onder getting
          there te veel niet interessante info om zo hoog te staan, dus
          omwisselen"). The photo offer leads the row and is the filled pill
          (Hidde, same message: "de add photo moet meer aandacht krijgen");
          the note is the quiet one. Google Maps keeps Add a photo and Write a
          review together under the place. */}
      <section class="td-section td-notes" id="td-notes" data-tree={tree.id} data-near={nearNotesJson}
        data-yours={U.noteYours} data-visitor={U.noteVisitor} data-none={U.notesNone} data-borrowed={U.notesBorrowed}
        data-signin={U.noteSignIn} data-saving={U.noteSaving} data-failed={U.noteFailed} data-add={U.noteAdd}
        data-save={U.noteSave} data-shown-as={U.noteShownAs("{name}")} data-shown-anon={U.noteShownAnon}
        data-leaf-icon={icon("leaf", "fill")}>
        <h2>{U.notesHeading}</h2>
        <div class="td-notes-body">
          <div class="td-note td-note-ghost" aria-hidden="true">
            <span class="td-note-ghost-l">{U.notesExampleLabel}</span>
            <p>{U.notesExample}</p>
          </div>
        </div>
        <div class="td-notes-btns">
          {photo && photo.url && (
            <AddPhoto treeId={tree.id} treeName={p.name} lat={loc.latitude!} lng={loc.longitude!} lang={p.lang} />
          )}
          <button type="button" class="addphoto-btn quiet td-note-ask" id="td-note-ask">{U.noteAsk}</button>
        </div>
      </section>

      {/* GETTING THERE: ONE BLOCK WITH A HEADING, as the app draws it (Hidde,
          2026-10-24: "the app section of getting there looks better, should
          we get that one in web as well?"). Four rows, icon left: the address,
          how to recognise it (its own row since today), access only when there
          is something to meet (accessRow above), transport. A ticket stays
          high in the facts card. */}
      {(p.address || p.recognise || accessRow || p.transport) && (
        <section class="td-access td-section">
          <h2>{U.gettingThere}</h2>
          {p.address && <p><Fragment set:html={icon("map-pin")} /><span class="td-address">{p.address}</span></p>}
          {p.recognise && <p><Fragment set:html={icon("eye")} /><span class="which-one">{p.recognise}</span></p>}
          {accessRow && <p><Fragment set:html={icon("person-simple-walk")} /><span class="td-clamp td-clamp-2" data-more={U.readMore}>{p.access}</span></p>}
          {p.transport && <p><Fragment set:html={icon("train-simple")} /><span class="td-clamp td-clamp-2" data-more={U.readMore}>{p.transport}</span></p>}
        </section>
      )}

      {p.seasonHtml && <Fragment set:html={p.seasonHtml} />}

      {/* The official register lives HERE, as the first source, and not in
          the fact card (Hidde, 2026-10-08: "they should just be on the website
          less prominent, they are just there for Google"). It sat in the card
          beside age and species for two days; a designation is evidence, so
          it goes with the evidence. Gone from the app entirely. */}
      {(sources.length > 0 || register) && (
        <section class="td-section tree-sources">
          <h2>{U.sourcesHeading}</h2>
          <p>{U.sourcesLine}</p>
          <ul>
            {register && <li class="tree-sources-register">{U.labelRegister}: {register.url ? <a href={register.url} target="_blank" rel="noopener">{register.name}</a> : <span>{register.name}</span>}</li>}
            {sources.map((s) => (
              <li>{s.href ? <a href={s.href} target="_blank" rel="noopener">{s.label}</a> : <span>{s.label}</span>}</li>
            ))}
          </ul>
          <p class="tree-sources-how"><a href="/sources">{U.howWeCheck}</a></p>
        </section>
      )}

      <WorthIt treeId={tree.id} city={p.cityName} treeName={p.name} part="report" lang={p.lang} />

      {p.nearby.length > 0 && (
        <section class="td-section">
          <h2>{U.nearbyTrees}</h2>
          <div class="td-near">
            {p.nearby.map((n) => (
              <a class="td-near-card" href={n.url}>
                <span class="td-near-ph">
                  {n.photo
                    ? <img {...imgSrcset(n.photo, [330, 500], "200px")} alt="" loading="lazy" />
                    : <Fragment set:html={icon("tree")} />}
                </span>
                <b>{n.name}</b>
                <span class="td-near-meta" set:html={n.meta} />
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="td-section discover-more">
        <h2>{U.discoverMore}</h2>
        <div class="dm-chips">
          {p.chips.map((c) => (
            <a class="dm-chip" href={c.href}><Fragment set:html={icon(c.icon)} />{c.label}</a>
          ))}
        </div>
      </section>
    </div>

    {/* THE SIDE CARD on a desktop holds what the phone's pinned bar holds. */}
    <aside class="td-side">
      <div class="td-stick">
        <a class="td-open" href={openUrl} rel="nofollow" data-ev="app-open"><Fragment set:html={icon("device-mobile")} />{U.openInApp}</a>
        <div class="td-sec">
          <a class="dir-link" href={google} target="_blank" rel="noopener"><Fragment set:html={icon("arrow-bend-up-right")} />{U.takeMeThere}</a>
          <SaveHeart treeId={tree.id} treeName={p.name} labelSave={U.cardSave} labelSaved={U.cardSaved} />
        </div>
        <button type="button" class="seen-btn td-collect-wide" data-tree={tree.id} data-name={p.name}
          data-l-seen={U.seenIt} data-l-done={U.seenItDone} aria-pressed="false">
          <Fragment set:html={sealOff} /><Fragment set:html={sealOn} /><span class="seen-text">{U.seenIt}</span>
        </button>
        {/* The side map's way out to the whole map, as AllTrails and Airbnb
            put an expand control in the corner of a detail page's map
            (Hidde, 2026-10-05: "the map is not clickable"). The phone's
            inset already carries the same link. */}
        <div class="td-side-map"><a class="td-side-expand" href={expandUrl} aria-label={U.openFullMap} title={U.openFullMap}><Fragment set:html={icon("arrows-out-simple")} /></a></div>
      </div>
    </aside>
  </div>

  {/* THE BAR (actionBar): the loud button, then two 52 point circles. */}
  <div class="td-bar" aria-label={U.actions}>
    <a class="td-open" href={openUrl} rel="nofollow" data-ev="app-open"><Fragment set:html={icon("device-mobile")} />{U.openInApp}</a>
    <a class="dir-link td-round" href={google} target="_blank" rel="noopener" aria-label={U.takeMeThere} title={U.takeMeThere}><Fragment set:html={icon("arrow-bend-up-right")} /></a>
    <button type="button" class="seen-btn td-round" data-tree={tree.id} data-name={p.name}
      data-l-seen={U.seenIt} data-l-done={U.seenItDone} aria-pressed="false" title={U.seenIt}>
      <Fragment set:html={sealOff} /><Fragment set:html={sealOn} /><span class="seen-text sr-only">{U.seenIt}</span>
    </button>
    <SaveHeart treeId={tree.id} treeName={p.name} labelSave={U.cardSave} labelSaved={U.cardSaved} look="round" />
  </div>

  {/* THE COLLECT SHEET (TreeDetail.swift collectChoice): three panes, one
      shown at a time by tree-actions-js.ts. A bottom sheet on a phone and a
      centred dialog on a laptop, the two places each platform puts a choice. */}
  <Sheet lang={p.lang} class="collect-dlg" data-tree={tree.id} data-lang={p.lang} data-removed={U.uncollected} aria-label={U.collectTitle(p.name)}>
    {/* Three ways to collect, the app's sheet (Hidde, 2026-10-10: "make
        photo, from library and last collect without photograph"). A laptop
        has no camera to point at a tree, so there the first two become one
        "Choose a photograph" (.only-touch / .only-fine in style.css). */}
    <div data-pane="choose">
      <span class="at-sheet-tile"><Fragment set:html={icon("camera", "bold")} /></span>
      <h3 class="at-sheet-h">{U.collectTitle(p.name)}</h3>
      <p class="at-sheet-p">{U.collectLead}</p>
      <div class="at-sheet-btns">
        <button type="button" class="sheet-b sheet-b--primary only-touch" data-act="camera"><Fragment set:html={icon("camera", "bold")} />{U.collectCamera}</button>
        <button type="button" class="sheet-b sheet-b--secondary only-touch" data-act="photo"><Fragment set:html={icon("image", "bold")} />{U.collectLibrary}</button>
        <button type="button" class="sheet-b sheet-b--primary only-fine" data-act="photo"><Fragment set:html={icon("image", "bold")} />{U.collectPhoto}</button>
        {/* No "Collect without a photograph" since 2026-10-14 (Hidde: collecting
            with a photograph makes it special and gets people taking them).
            Trees collected without one before then stay collected. Same in
            the app's collectChoice. */}
      </div>
    </div>
    <div data-pane="done" hidden>
      <span class="at-sheet-tile"><Fragment set:html={icon("seal-check", "bold")} /></span>
      <h3 class="at-sheet-h">{U.collectedTitle(p.name)}</h3>
      <p class="at-sheet-p collect-on" data-on={U.collectedOn("{d}")} hidden></p>
      <div class="at-sheet-btns">
        <button type="button" class="sheet-b sheet-b--primary only-touch" data-act="camera"><Fragment set:html={icon("camera", "bold")} />{U.collectCamera}</button>
        <button type="button" class="sheet-b sheet-b--secondary only-touch" data-act="photo"><Fragment set:html={icon("image", "bold")} />{U.collectLibrary}</button>
        <button type="button" class="sheet-b sheet-b--primary only-fine" data-act="photo"><Fragment set:html={icon("image", "bold")} />{U.collectPhoto}</button>
        <button type="button" class="sheet-b sheet-b--redq" data-act="uncollect">{U.uncollect}</button>
      </div>
    </div>
  </Sheet>

  {/* Which maps app, asked once on an iPhone (DirectionsAsk): equal choices,
      so both are grey, and the cross is the cancel. */}
  {/* Delete one of YOUR photographs of this tree (2026-10-12). Google Maps:
      your photo, More, "Delete this photo", confirm; Apple Photos asks the
      same once. CONVENTIONS.md, "Deleting your own photograph". */}
  <Sheet lang={p.lang} class="own-del" id="own-del" aria-labelledby="own-del-h">
    <h3 class="at-sheet-h" id="own-del-h">{U.photoDeleteTitle}</h3>
    <p class="at-sheet-p">{U.photoDeleteBody}</p>
    <div class="at-sheet-btns">
      <button type="button" class="sheet-b sheet-b--red" data-own-del-yes>{U.photoDeleteBtn}</button>
      <button type="button" class="sheet-b sheet-b--quiet" data-own-del-no>{U.cancel}</button>
    </div>
  </Sheet>
  {/* THE NOTE SHEET (CONVENTIONS.md "One button, the guidance inside the
      sheet"; mock tree-mock/note-sheet.html): the prompt is the field's
      placeholder, two examples under it, the name and date it will show,
      Add note. Editing your own note reopens it prefilled with Save and
      Delete. The sheet is Sheet.astro like every overlay (sheetcheck). */}
  <Sheet lang={p.lang} class="note-dlg" id="note-dlg" aria-labelledby="note-dlg-h">
    <h3 class="at-sheet-h" id="note-dlg-h">{U.noteSheetTitle}</h3>
    <p class="at-sheet-p">{p.name}</p>
    <textarea class="note-field" id="note-field" maxlength="1000" rows="4" placeholder={U.notePlaceholder}></textarea>
    <p class="note-eg">{U.noteExamples}</p>
    <p class="note-who" id="note-who"></p>
    <div class="at-sheet-btns">
      <button type="button" class="sheet-b sheet-b--primary" id="note-send">{U.noteAdd}</button>
      <button type="button" class="sheet-b sheet-b--redq" id="note-del" hidden>{U.noteDelete}</button>
      <button type="button" class="sheet-b sheet-b--quiet" id="note-cancel">{U.cancel}</button>
    </div>
    <p class="note-status" id="note-status" role="status" hidden></p>
  </Sheet>
  <Sheet lang={p.lang} class="dir-pick" aria-label={U.dirTitle}>
    <h3 class="at-sheet-h">{U.dirTitle}</h3>
    <div class="at-sheet-btns">
      <button type="button" class="sheet-b sheet-b--secondary" value="apple">{U.appleMaps}</button>
      <button type="button" class="sheet-b sheet-b--secondary" value="google">{U.googleMaps}</button>
    </div>
  </Sheet>

  {isApprox && (
    <dialog class="pin-dlg" aria-label={U.pinTitle}
      data-tree={tree.id} data-name={p.name} data-city={p.cityName}
      data-zoom={U.pinZoom} data-moved={movedTemplate} data-send={U.pinSend}
      data-sending={U.pinSending} data-done={U.pinDone} data-failed={U.pinFailed}>
      <div class="pin-head">
        <button type="button" class="pin-cancel">{U.cancel}</button>
        <b>{U.pinTitle}</b>
      </div>
      <div class="pin-map"></div>
      <span class="pin-target" aria-hidden="true"></span>
      <div class="pin-card">
        <p class="pin-help">{U.pinHelp}</p>
        <p class="pin-moved">{U.pinZoom}</p>
        <button type="button" class="pin-send" disabled>{U.pinSend}</button>
        <p class="pin-note" role="status"></p>
        <p class="pin-acct" hidden>{U.pinNeedsAccount}</p>
      </div>
    </dialog>
  )}
</main>
<script is:inline>
  (function() {
    document.querySelectorAll('.td-clamp').forEach(function(el) {
      if (el.scrollHeight <= el.clientHeight + 1) { el.classList.add('open'); return; }
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'td-more'; b.textContent = el.getAttribute('data-more') || 'Read more';
      b.addEventListener('click', function() { el.classList.add('open'); b.remove(); });
      (el.closest('.td-access p') || el).insertAdjacentElement('afterend', b);
    });
    // The story: collapsed only when it is clearly longer than the window
    // (about six lines), so a short story never gets a Read more.
    var w = document.querySelector('.td-story-wrap');
    if (w) {
      var st = w.querySelector('.td-story'), btn = w.querySelector('.td-story-more');
      if (st && btn && st.scrollHeight > 240) {
        w.classList.add('is-collapsed');
        btn.hidden = false;
        btn.addEventListener('click', function() {
          var c = w.classList.toggle('is-collapsed');
          btn.textContent = btn.getAttribute(c ? 'data-more' : 'data-less');
          if (c) { try { w.scrollIntoView({ block: 'nearest' }); } catch (e) {} }
        });
      }
    }
  })();
</script>
