---
import { ui } from "../lib/i18n";
// "Worth the visit?" — a vote, and beside it a separate way to report a problem.
//
// Split apart 2026-08-16 on Hidde's instruction: "je kunt een boom niet leuk
// vinden of niet de moeite vinden zonder dat er iets mis is." The first version
// (his own design of 2026-08-14) hung four chips off the thumbs-down under the
// heading "What was wrong?", and one of those chips was "Not that special",
// which is an opinion rather than a fault. So the control asked everyone who
// simply was not impressed to file a fault report, and gave everyone who loved
// the tree but found the pin wrong no way in at all.
//
// The convention, checked against the standing references before rebuilding:
// Google Maps keeps its rating and its "Suggest an edit" as two separate entry
// points; AllTrails separates the star rating from reporting conditions;
// YouTube and Reddit separate the vote from Report. Everywhere, opinion and
// error report are siblings, never nested. Nesting hides the report from the
// people most likely to have one and interrogates the people least likely.
//
// THE SAME CONTROL AS THE APP, since 2026-09-11 (Hidde: "zorg dat deze pagina
// gelijk wordt getrokken met de app die is goed"). On 2026-09-04 he moved the
// app's thumb up beside the place name and took the question away ("de worth
// the visit tekst mag helemaal weg, zet die thumb omhoog gewoon naast de
// stadsnaam"), put "Something's wrong" low on the page, and the app had
// already dropped the thumbs-down. The website kept all of it for a week. So
// the two halves now render in two places, chosen with `part`:
//
//   part="vote"    one thumb, inline beside the place, nothing else. The
//                  pressed state IS the confirmation, which is what the script
//                  already said; "Thanks, counted" is gone with it.
//   part="report"  "Something's wrong" and its chips, low on the page.
//   (no part)      both, for any page that has no place line to sit in.
//
// There is no thumbs-down on either surface. "Not worth it" is what a missing
// thumb already says, and the fault chips carry every reason that is a fault.
//
// Where a report goes is unchanged: the same Supabase submissions table the
// /contribute form uses (kind 'feedback'), where Step 0b picks it up, and a
// dead or wrong-location report gets checked the same day.
//
// THE VOTE RENDERS IN EVERY LANGUAGE SINCE 2026-09-12. Until then this
// component was imported by the English tree page alone, so roughly 2,800
// translated tree pages carried no thumb at all: the one control on the page
// that asks the reader the only question this project really wants answered,
// missing from every page that was not in English. The report half stays
// English-only for now, because its chips are typed sentences rather than
// looked-up labels, and the translated pages carry their own report links
// instead; that is the remaining half of this gap and it is written down.
//
// Both halves carry the tree on their own box, because worthit-js.ts scopes
// everything to the nearest `.worthit` and reads the tree from it; the vote
// state is shared per tree, so the two boxes never disagree.
//
// SEVEN LANGUAGES SINCE 2026-09-12. Every string below used to be typed into
// this markup in English, which is why the control could only ever appear on
// English pages: putting it on a translated one would have shipped English
// chips under a Dutch heading. Hidde, told the vote was on none of the 907
// translated tree pages: "zet het op de vertaalde pagina's alles consistent."
// Nothing about the control changed, and no new copy was written: the English
// strings moved into UIStrings unaltered and were translated from there.
//
// THE THUMB IS DRAWN, NOT TYPED (2026-09-12, Hidde: "op de site is de duim een
// gele emoji, in de app een lijntekening, wil je die ook gelijk hebben"). An
// emoji is somebody else's artwork: yellow on Apple, a different yellow on
// Android, a third on Windows, and it ignores every colour this site owns. It
// was also the only emoji left anywhere in the site's markup. So it is now the
// same outline-fills-on-press pair the app draws (`hand.thumbsup` and
// `hand.thumbsup.fill`) and the same pair the save heart on this site already
// draws: one path, `fill: none` with the ink stroke while nothing is cast,
// filled moss once it is. The cuff line vanishes into the fill, which is what
// makes the pressed state read as solid rather than as an outline with paint
// in it.
interface Props {
  treeId: string;
  city: string;
  treeName: string;
  compact?: boolean;
  part?: "vote" | "report";
  /** The page's language. Defaults to English, so every existing call site
   * keeps the words it already had. */
  lang?: string;
}
const { treeId, city, treeName, compact = false, part, lang = "en" } = Astro.props;
const U = ui(lang);
const REASONS = [
  { reason: "dead or gone", label: U.worthDead, q: U.worthDeadQ, ph: U.worthDeadPh },
  { reason: "wrong location", label: U.worthWrongLoc, q: U.worthWrongLocQ, ph: U.worthWrongLocPh },
  { reason: "could not tell which tree", label: U.worthWhichTree, q: U.worthWhichTreeQ, ph: U.worthWhichTreePh },
  { reason: "could not reach it", label: U.worthCouldNotReach, q: U.worthCouldNotReachQ, ph: U.worthCouldNotReachPh },
  { reason: "something else", label: U.worthSomethingElse, q: U.worthSomethingElseQ, ph: U.worthSomethingElsePh },
];
const showVote = part !== "report";
const showReport = part !== "vote";
const cls = ["worthit", compact ? "worthit-compact" : "", part === "vote" ? "worthit-inline" : ""].filter(Boolean).join(" ");
---
{/* The second thanks travels on the box rather than living in
    worthit-js.ts: a string inside the script is a string in one
    language, and this control now renders in eight (2026-09-12). */}
<div class={cls} data-tree={treeId} data-city={city} data-name={treeName}
     data-thanks-detail={U.worthThanksDetail}>
  <div class="worthit-row">
    {showVote && (
      <button type="button" class="worthit-btn" data-vote="up" aria-label={U.worthVote(treeName)}>
        <svg class="thumb" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path class="thumb-hand" d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/>
          <path class="thumb-cuff" d="M7 10v12"/>
        </svg>
        {/* The count sits ON the control, which is the other half of the
            convention the app follows: nobody anywhere draws a number that is
            only a number beside a separate button that casts. Empty until the
            page has an answer, and empty at zero. */}
        <span class="worthit-n" hidden></span>
      </button>
    )}
    {showReport && (
      <button type="button" class="worthit-report" aria-expanded="false">{U.worthReport}</button>
    )}
  </div>
  {showReport && (
    <Fragment>
      <div class="worthit-why" hidden>
        <span class="worthit-q">{U.worthWhatsWrong}</span>
        {/* data-reason stays ENGLISH in every language on purpose: it is the
            value written to the submissions table, where Step 0b reads it and
            groups reports by kind. Translating it would split one report kind
            into seven. Only what the reader sees is looked up. */}
        {REASONS.map((r) => (
          <button type="button" class="worthit-chip" data-reason={r.reason} data-q={r.q} data-ph={r.ph}>{r.label}</button>
        ))}
      </div>
      <span class="worthit-thanks" hidden>{U.worthThanks}</span>
      <form class="worthit-detail" hidden>
        <label class="worthit-q" for={`wd-${treeId}`}>{U.worthDetailLabel}</label>
        <textarea id={`wd-${treeId}`} rows="2" placeholder=""></textarea>
        <button type="submit" class="worthit-chip">{U.worthSend}</button>
      </form>
    </Fragment>
  )}
</div>
