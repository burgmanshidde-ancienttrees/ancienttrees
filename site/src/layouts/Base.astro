---
// Ported from PAGE_SHELL/FOOTER, build_site.py:783-901. Two deliberate
// simplifications versus the Python version, neither changing what a
// visitor or a crawler sees:
//  1. Nav/footer links are root-absolute (/explore, /cities, ...) instead
//     of the %%ROOTPATH%% relative-depth scheme; the target URLs are
//     identical, this just removes the per-page depth computation.
//  2. TITLE_MAX/DESC_MAX are enforced by throwing at build time (the Astro
//     equivalent of build_site.py's ERRORS.append(), which collected and
//     reported at the very end of the build instead).
import {
  AUTH_ENABLED,
  SUPABASE_URL,
  SUPABASE_KEY,
  ANALYTICS_TOKEN,
  TITLE_MAX,
  DESC_MAX,
} from "../lib/site-config";

export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: "article" | "website";
  headExtra?: string;
  /** City pages pass false: the split-panel/map layout has no room for the
   * standard footer (render_page(..., footer=False), build_site.py:3659). */
  footer?: boolean;
}

const { title, description, canonical, ogType = "article", headExtra = "", footer = true } = Astro.props;

if (title.length > TITLE_MAX) {
  throw new Error(`${canonical}: title exceeds ${TITLE_MAX} chars (${title.length}): ${JSON.stringify(title)}`);
}
if (description.length > DESC_MAX) {
  throw new Error(`${canonical}: description exceeds ${DESC_MAX} chars (${description.length})`);
}

const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="google-site-verification" content="uVA_hyHOJQWM3wH90g2QwP5qw2pk1WlPrtZ-lZKq2Hc">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="alternate" type="application/atom+xml" title="Ancient Trees: newest trees" href="https://ancienttrees.app/feed.xml">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content={ogType}>
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="Ancient Trees">
{!headExtra.includes("og:image") && (
  <meta property="og:image" content="https://ancienttrees.app/og-default.png" />
)}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Gabarito:wght@400..900&display=swap" rel="stylesheet">
{/* Real files at stable URLs, not a data: URI. Google fetches a favicon as
    its own request when it crawls, so a data: URI gives it nothing to fetch
    and the search result falls back to a generic grey globe: that is exactly
    what ancienttrees.app looked like in a live Google result on 2026-08-09,
    beside competitors showing their own mark. Keep these paths stable. */}
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="alternate icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href="/assets/style.css">
<Fragment set:html={headExtra} />
</head>
<body>
<header class="bar">
  <a href="/" class="bar-logo"><svg width="25" height="22" viewBox="0 0 68 64" fill="none" aria-hidden="true"><ellipse cx="34" cy="24" rx="24" ry="16" fill="#3A5222"/><circle cx="20" cy="23" r="11" fill="#4A6B2A"/><circle cx="48" cy="23" r="11" fill="#4A6B2A"/><circle cx="34" cy="12" r="11" fill="#5B7F35"/><circle cx="25" cy="15" r="7" fill="#86A34D"/><circle cx="51" cy="14" r="3.2" fill="#D9A13F"/><path d="M31 62 h5.6 l-1.2-16 c2.6-1.8 5.4-4.4 7-6.6 l-1.6-1.4 c-1.8 2-4 3.8-5.6 4.6 l-.3-5.8 h-2 l-.4 8.4 c-1.6-.9-3.6-2.7-5-4.4 l-1.6 1.4 c1.8 2.5 4.4 4.9 6.4 6z" fill="#6B4F33"/></svg><span>Ancient Trees</span></a>
  <nav class="bar-links">
    <a href="/explore" class="only-desktop">Map</a>
    <details class="nav-drop">
      <summary><span class="sum-desktop">Explore</span><span class="sum-mobile">Menu</span></summary>
      <div class="nav-drop-menu">
        <a href="/explore" class="only-mobile"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg></span>Map</a>
        <a href="/cities"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V8l5-3v16M9 21V10l6 2v9M15 21V7l5 2v12"/><path d="M2 21h20"/></svg></span>Cities</a>
        <a href="/countries"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 3 2.6 15 0 18M12 3c-2.6 3-2.6 15 0 18"/></svg></span>Countries</a>
        <a href="/species"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20C6 10 12 4 20 4c0 8-6 14-16 16z"/><path d="M4 20c4-6 8-9 12-11"/></svg></span>Species</a>
        <a href="/parks"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12"/><path d="M12 12c0-4 3-7 7-7 0 4-3 7-7 7z"/><path d="M12 12c0-3.5-2.5-6-6-6 0 3.5 2.5 6 6 6z"/></svg></span>Parks</a>
        <a href="/collections"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h12a1 1 0 0 1 1 1v16l-7-4-7 4V5a1 1 0 0 1 1-1z"/></svg></span>Collections</a>
        <a href="/contribute"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg></span>Suggest a tree</a>
        {AUTH_ENABLED && (
          <a href="/account" class="only-mobile"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg></span>Log in</a>
        )}
      </div>
    </details>
    {AUTH_ENABLED && <a href="/account" class="bar-login only-desktop">Log in</a>}
    <a href="/app" class="bar-cta">Get the app</a>
  </nav>
</header>
<slot />
{footer && (
<footer>
  <div class="footer-cols">
    <div class="footer-col footer-about">
      <span class="footer-logo">Ancient Trees</span>
      <p>We are on a mission to map every remarkable tree in the world, and we could use your help. If you know a good tree, or spot a mistake on one of these pages, <a href="/contribute">tell us</a>. We work on this database every day.</p>
    </div>
    <div class="footer-col">
      <h4>Explore</h4>
      <a href="/explore">Map</a>
      <a href="/in-season">In season now</a>
      <a href="/cities">Cities</a>
      <a href="/countries">Countries</a>
      <a href="/species">Species</a>
      <a href="/collections">Collections</a>
    </div>
    <div class="footer-col">
      <h4>Ancient Trees</h4>
      <a href="/app">The app</a>
      <a href="/contribute">Suggest a tree</a>
      <a href="/privacy">Privacy</a>
    </div>
  </div>
  <span class="footer-note">&copy; {year} Ancient Trees, ancienttrees.app. Map &copy; OpenFreeMap, OpenMapTiles, OpenStreetMap contributors. Walking routes by Valhalla via FOSSGIS, on OpenStreetMap data. Photos carry their own credits and open licences.</span>
</footer>
)}
<script define:vars={{ SB_URL: SUPABASE_URL, SB_KEY: SUPABASE_KEY }}>
window.at = window.at || {};
at.track = function (name, detail) {
  try {
    // Only the real site measures. Smoke tests load these pages in headless
    // Chrome on 127.0.0.1 on every push, and preview sessions serve them on
    // localhost; both were being counted as visitors (found 2026-08-08 while
    // asking why 74% of "traffic" was NL). One hostname check removes every
    // machine visitor at the root instead of filtering them per tool.
    if (location.hostname !== "ancienttrees.app") { return; }
    if (localStorage.getItem("at_notrack") === "1") { return; }
    var ev = { name: String(name).slice(0, 40), path: location.pathname.slice(0, 120) };
    if (detail) { ev.detail = String(detail).slice(0, 60); }
    var body = JSON.stringify(ev);
    navigator.sendBeacon
      ? navigator.sendBeacon(SB_URL + "/rest/v1/events?apikey=" + SB_KEY, new Blob([body], { type: "application/json" }))
      : fetch(SB_URL + "/rest/v1/events", { method: "POST", keepalive: true, headers: { apikey: SB_KEY, "Content-Type": "application/json", Prefer: "return=minimal" }, body: body });
  } catch (e) {}
};
document.addEventListener("click", function (e) {
  var a = e.target && e.target.closest ? e.target.closest("a, button") : null;
  if (!a) return;
  var h = a.getAttribute("href") || "";
  if (h.indexOf("google.com/maps/dir") !== -1) { at.track("directions"); }
  else if (h.indexOf("/app") === 0 || h === "app" || h === "../app" || h === "./app") { at.track("app-cta"); }
});
</script>
<slot name="scripts" />
{ANALYTICS_TOKEN && (
  <script define:vars={{ token: ANALYTICS_TOKEN }}>
    (function () {
      try {
        if (location.hostname !== "ancienttrees.app") { return; }
        var p = new URLSearchParams(location.search);
        if (p.get("notrack") === "1") { localStorage.setItem("at_notrack", "1"); }
        else if (p.get("notrack") === "0") { localStorage.removeItem("at_notrack"); }
        if (localStorage.getItem("at_notrack") === "1") { return; }
      } catch (e) {}
      var s = document.createElement("script");
      s.defer = true;
      s.src = "https://static.cloudflareinsights.com/beacon.min.js";
      s.setAttribute("data-cf-beacon", JSON.stringify({ token: token }));
      document.head.appendChild(s);
    })();
  </script>
)}
</body>
</html>
