---
// Ported from PAGE_SHELL/FOOTER, build_site.py:783-901. Two deliberate
// simplifications versus the Python version, neither changing what a
// visitor or a crawler sees:
//  1. Nav/footer links are root-absolute (/explore, /cities, ...) instead
//     of the %%ROOTPATH%% relative-depth scheme; the target URLs are
//     identical, this just removes the per-page depth computation.
//  2. TITLE_MAX/DESC_MAX are enforced by throwing at build time (the Astro
//     equivalent of build_site.py's ERRORS.append(), which collected and
//     reported at the very end of the build instead).
import { STYLE_HREF } from "../lib/asset-hash";
import {
  AUTH_ENABLED,
  SUPABASE_URL,
  SUPABASE_KEY,
  ANALYTICS_TOKEN,
  TITLE_MAX,
  DESC_MAX,
} from "../lib/site-config";

export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: "article" | "website";
  headExtra?: string;
  /** City pages pass false: the split-panel/map layout has no room for the
   * standard footer (render_page(..., footer=False), build_site.py:3659). */
  footer?: boolean;
  /** Page language for the html lang attribute. Translated pages (/es/...)
   * pass their own; everything else stays English. The chrome this layout
   * renders (nav, footer) is English either way, which is a known limit of
   * the translation test, not an oversight. */
  lang?: string;
}

const { title, description, canonical, ogType = "article", headExtra = "", footer = true, lang = "en" } = Astro.props;

if (title.length > TITLE_MAX) {
  throw new Error(`${canonical}: title exceeds ${TITLE_MAX} chars (${title.length}): ${JSON.stringify(title)}`);
}
if (description.length > DESC_MAX) {
  throw new Error(`${canonical}: description exceeds ${DESC_MAX} chars (${description.length})`);
}

const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang={lang}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="google-site-verification" content="uVA_hyHOJQWM3wH90g2QwP5qw2pk1WlPrtZ-lZKq2Hc">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="alternate" type="application/atom+xml" title="Ancient Trees: newest trees" href="https://ancienttrees.app/feed.xml">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content={ogType}>
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="Ancient Trees">
{!headExtra.includes("og:image") && (
  <meta property="og:image" content="https://ancienttrees.app/og-default.png" />
)}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
{/* Gabarito is self-hosted since 2026-08-16: the @font-face rules live at the
    top of /assets/style.css and the woff2 files sit beside it. The Google
    Fonts <link> that stood here was a render-blocking stylesheet on a foreign
    host that then pointed at a second foreign host for the file itself, which
    is two DNS+TLS round trips in front of first paint. Preloading the latin
    subset here (the stylesheet only reveals it one parse later) closes the
    last gap; latin-ext is deliberately NOT preloaded, since most pages never
    need it and unicode-range keeps it unfetched. */}
<link rel="preload" href="/assets/gabarito-latin.woff2" as="font" type="font/woff2" crossorigin>
{/* Real files at stable URLs, not a data: URI. Google fetches a favicon as
    its own request when it crawls, so a data: URI gives it nothing to fetch
    and the search result falls back to a generic grey globe: that is exactly
    what ancienttrees.app looked like in a live Google result on 2026-08-09,
    beside competitors showing their own mark. Keep these paths stable. */}
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="alternate icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href={STYLE_HREF}>
<Fragment set:html={headExtra} />
</head>
<body>
<header class="bar">
  <a href="/" class="bar-logo"><svg width="25" height="22" viewBox="0 0 68 64" fill="none" aria-hidden="true"><ellipse cx="34" cy="24" rx="24" ry="16" fill="#3A5222"/><circle cx="20" cy="23" r="11" fill="#4A6B2A"/><circle cx="48" cy="23" r="11" fill="#4A6B2A"/><circle cx="34" cy="12" r="11" fill="#5B7F35"/><circle cx="25" cy="15" r="7" fill="#86A34D"/><circle cx="51" cy="14" r="3.2" fill="#D9A13F"/><path d="M31 62 h5.6 l-1.2-16 c2.6-1.8 5.4-4.4 7-6.6 l-1.6-1.4 c-1.8 2-4 3.8-5.6 4.6 l-.3-5.8 h-2 l-.4 8.4 c-1.6-.9-3.6-2.7-5-4.4 l-1.6 1.4 c1.8 2.5 4.4 4.9 6.4 6z" fill="#6B4F33"/></svg><span>Ancient Trees</span></a>
  <nav class="bar-links">
    <a href="/explore" class="bar-map">Map</a>
    <details class="nav-drop">
      <summary aria-label="Menu"><span class="sum-desktop">Explore</span><span class="sum-mobile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></span></summary>
      <div class="nav-drop-menu">
        <p class="nav-group">Browse</p>
        <a href="/cities"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V8l5-3v16M9 21V10l6 2v9M15 21V7l5 2v12"/><path d="M2 21h20"/></svg></span>Cities</a>
        <a href="/countries"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 3 2.6 15 0 18M12 3c-2.6 3-2.6 15 0 18"/></svg></span>Countries</a>
        <a href="/species"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20C6 10 12 4 20 4c0 8-6 14-16 16z"/><path d="M4 20c4-6 8-9 12-11"/></svg></span>Species</a>
        <a href="/parks"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12"/><path d="M12 12c0-4 3-7 7-7 0 4-3 7-7 7z"/><path d="M12 12c0-3.5-2.5-6-6-6 0 3.5 2.5 6 6 6z"/></svg></span>Parks</a>
        <a href="/collections"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h12a1 1 0 0 1 1 1v16l-7-4-7 4V5a1 1 0 0 1 1-1z"/></svg></span>Collections</a>
        <a href="/contribute"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg></span>Suggest a tree</a>
      </div>
    </details>
    {/* What is YOURS hangs off the account, not off Explore (Hidde,
        2026-08-18: "is het niet conventie om het yours kopje als items onder
        account te hebben"). It is: Strava, AllTrails and Google Maps all put
        the saved list behind the avatar, because Explore is where you browse
        the site and the account is where you find your own things. */}
    {AUTH_ENABLED && (
      <details class="nav-drop nav-acct">
        <summary id="bar-login" aria-label="Account"><span class="mi acct-avatar" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg></span><span class="acct-word">Account</span></summary>
        <div class="nav-drop-menu">
          <p class="nav-group">Yours</p>
          <a href="/account#saved"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21C6.5 16.3 3.5 13 3.5 9.6 3.5 7 5.5 5 8 5c1.6 0 3.1.8 4 2.1C12.9 5.8 14.4 5 16 5c2.5 0 4.5 2 4.5 4.6 0 3.4-3 6.7-8.5 11.4z"/></svg></span>Saved trees</a>
          <a href="/account"><span class="mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg></span>Your account</a>
        </div>
      </details>
    )}
    <a href="/app" class="bar-cta" data-ev="app-cta">Get the app</a>
  </nav>
</header>
<slot />
{footer && (
<footer>
  <div class="footer-cols">
    <div class="footer-col footer-about">
      <span class="footer-logo">Ancient Trees</span>
      <p>We are on a mission to map every remarkable tree in the world, and we could use your help. If you know a good tree, or spot a mistake on one of these pages, <a href="/contribute">tell us</a>. We work on this database every day.</p>
    </div>
    <div class="footer-col">
      <h4>Explore</h4>
      <a href="/explore">Map</a>
      <a href="/in-season">In season now</a>
      <a href="/cities">Cities</a>
      <a href="/countries">Countries</a>
      <a href="/species">Species</a>
      <a href="/collections">Collections</a>
    </div>
    <div class="footer-col">
      <h4>Ancient Trees</h4>
      <a href="/app">The app</a>
      <a href="/contribute">Suggest a tree</a>
      <a href="/privacy">Privacy</a>
    </div>
  </div>
  <span class="footer-note">&copy; {year} Ancient Trees, ancienttrees.app. Map &copy; OpenFreeMap, OpenMapTiles, OpenStreetMap contributors. Walking routes by Valhalla via FOSSGIS, on OpenStreetMap data. Photos carry their own credits and open licences.</span>
</footer>
)}
<script define:vars={{ SB_URL: SUPABASE_URL, SB_KEY: SUPABASE_KEY }}>
window.at = window.at || {};
at.track = function (name, detail) {
  try {
    // Only the real site measures. Smoke tests load these pages in headless
    // Chrome on 127.0.0.1 on every push, and preview sessions serve them on
    // localhost; both were being counted as visitors (found 2026-08-08 while
    // asking why 74% of "traffic" was NL). One hostname check removes every
    // machine visitor at the root instead of filtering them per tool.
    if (location.hostname !== "ancienttrees.app") { return; }
    if (localStorage.getItem("at_notrack") === "1") { return; }
    var ev = { name: String(name).slice(0, 40), path: location.pathname.slice(0, 120) };
    if (detail) { ev.detail = String(detail).slice(0, 60); }
    var body = JSON.stringify(ev);
    // NOT sendBeacon, and this is the whole reason every funnel number read
    // zero from launch until 2026-08-16. A beacon carrying a Blob of type
    // application/json is not a CORS-simple request, so the browser must
    // preflight it, and sendBeacon cannot preflight: the request is dropped
    // silently and sendBeacon still returns true, so nothing anywhere could
    // see it fail. Measured on the live site: the same insert by fetch
    // returns 201, the beacon returns status 0. fetch with keepalive:true
    // survives the page unload the beacon was there for, and can set the
    // headers PostgREST needs.
    fetch(SB_URL + "/rest/v1/events", { method: "POST", keepalive: true, headers: { apikey: SB_KEY, "Content-Type": "application/json", Prefer: "return=minimal" }, body: body });
  } catch (e) {}
};
document.addEventListener("click", function (e) {
  var a = e.target && e.target.closest ? e.target.closest("a, button") : null;
  if (!a) return;
  var h = a.getAttribute("href") || "";
  if (h.indexOf("google.com/maps/dir") !== -1) { at.track("directions"); }
  else if (h.indexOf("/app") === 0 || h === "app" || h === "../app" || h === "./app") { at.track("app-cta"); }
});
</script>
<slot name="scripts" />
{ANALYTICS_TOKEN && (
  <script define:vars={{ token: ANALYTICS_TOKEN }}>
    (function () {
      try {
        if (location.hostname !== "ancienttrees.app") { return; }
        // Automated browsers are not an audience. The hostname gate above
        // already keeps CI out (the smoke test renders 127.0.0.1), but six
        // headless pageviews still showed up in the beacon on 2026-08-09, so
        // something automated is loading the live site: our own research
        // agents' browser sessions, a checker, a bot that does not spoof.
        // navigator.webdriver is the standard flag every automation tool sets,
        // and one polluted number is worse than a missing one.
        if (navigator.webdriver) { return; }
        var p = new URLSearchParams(location.search);
        if (p.get("notrack") === "1") { localStorage.setItem("at_notrack", "1"); }
        else if (p.get("notrack") === "0") { localStorage.removeItem("at_notrack"); }
        if (localStorage.getItem("at_notrack") === "1") { return; }
      } catch (e) {}
      var s = document.createElement("script");
      s.defer = true;
      s.src = "https://static.cloudflareinsights.com/beacon.min.js";
      s.setAttribute("data-cf-beacon", JSON.stringify({ token: token }));
      document.head.appendChild(s);
    })();
  </script>
<script>
// One listener tracks every element carrying data-ev, so adding a funnel
// step is an attribute, never a new script (FUNNELS.md, 2026-08-14).
document.addEventListener('click', function(e) {
  var t = e.target.closest('[data-ev]');
  if (t) { try { at.track(t.getAttribute('data-ev')); } catch (err) {} }
});
// The nav must know who you are (2026-08-14 consistency pass): AllTrails
// swaps Log in for your avatar; ours swaps the word, which is the honest
// minimum for a site without profile pictures. Session shape is the one
// /account and the save sync already use.
// Two <details> menus do not know about each other, so opening Account while
// Explore stood open stacked one panel over the other (Hidde's screenshot,
// 2026-08-18). Every menu bar closes its siblings; this is that, in four
// lines, plus a click outside and Escape, which is the rest of the same
// convention.
(function() {
  var drops = document.querySelectorAll('header.bar details.nav-drop');
  drops.forEach(function(d) {
    d.addEventListener('toggle', function() {
      if (!d.open) return;
      drops.forEach(function(o) { if (o !== d) o.open = false; });
    });
  });
  document.addEventListener('click', function(e) {
    if (e.target.closest('header.bar details.nav-drop')) return;
    drops.forEach(function(d) { d.open = false; });
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') drops.forEach(function(d) { d.open = false; });
  });
})();
(function() {
  try {
    var s = JSON.parse(localStorage.getItem('ancienttrees_session'));
    if (!s || s.expires_at <= Date.now() / 1000) return;
    document.querySelectorAll('#bar-login, .nav-drop-menu a[href="/account"]').forEach(function(a) {
      var label = a.querySelector('span:not(.mi)') || a;
      if (label === a) { a.textContent = 'Account'; }
      else { label.textContent = 'Account'; }
    });
    document.documentElement.dataset.signedIn = '1';
  } catch (e) {}
})();
</script>

)}
</body>
</html>
