---
// Contract C — City page. Ported from build_city_page(), build_site.py:3416-3662.
// Single-segment file route (see ARCHITECTURE.md's routing note): emits
// {city}.html directly, matching the current site and avoiding Astro's
// directory-format default.
import { getCollection, type CollectionEntry } from "astro:content";
import { checkCountPromises } from "../lib/count-promises";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { cityIsRenderable, renderableTrees, treeSlugsForCity, oldestTree, type CityEntry } from "../lib/trees";
import { speciesCommon } from "../lib/species";
import { usablePhoto, metaImageUrls, ogImageUrl } from "../lib/images";
import { speciesIcon } from "../lib/species-icons";
import { breadcrumbSchema, ldScript, SITE_SCHEMA, BASE_URL } from "../lib/schema";
import { fitTitle } from "../lib/title";
import { submitLink, ageToken } from "../lib/tree-copy";
import { mapHead } from "../lib/map";
import TreeCard from "../components/TreeCard.astro";
import SignInModal from "../components/SignInModal.astro";
import { TREE_ACTIONS_JS } from "../lib/tree-actions-js";
import { SIGNIN_JS } from "../lib/signin-js";
import { type WalkMarker } from "../lib/walks";
import { cityMapScript } from "../lib/city-map-script";
import { SHEET_JS } from "../lib/sheet-js";
import { otherCitiesFor } from "../lib/other-cities";
import { byCityListOrder } from "../lib/city-order";
import { cityTranslation, hreflangLinks } from "../lib/i18n";

function esc(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

export async function getStaticPaths() {
  const allCities = (await getCollection("cities")).filter(cityIsRenderable);
  const intros = await getCollection("countries");
  const speciesIntros = await getCollection("species");
  const collections = await getCollection("collectionPages");

  const countryPages = new Map<string, string>();
  const byCountryCount = new Map<string, number>();
  for (const c of allCities) byCountryCount.set(c.data.country, (byCountryCount.get(c.data.country) ?? 0) + 1);
  for (const intro of intros) {
    if ((byCountryCount.get(intro.data.country) ?? 0) >= 3) countryPages.set(intro.data.country, intro.data.slug);
  }
  const speciesPages = new Map(speciesIntros.map((i) => [i.data.common_name, i.data.slug]));

  return allCities.map((city) => {
    const canonical = `${BASE_URL}/${city.id}`;
    checkCountPromises(city.data, canonical);
    const intro = city.data.intro;
    if (!intro) throw new Error(`${city.id}: city intro (60-100 words, unique) is required by Contract C`);
    const wc = intro.split(/\s+/).filter(Boolean).length;
    if (wc < 60 || wc > 100) throw new Error(`${city.id}: city intro is ${wc} words, Contract C requires 60-100`);
    if (!city.data.faq || city.data.faq.length === 0) {
      throw new Error(`${city.id}: FAQ block (3-4 real questions) is required by Contract C`);
    }
    return {
      params: { city: city.id },
      props: { city, allCities, countryPages, speciesPages, collections },
    };
  });
}

interface Props {
  city: CityEntry;
  allCities: CityEntry[];
  countryPages: Map<string, string>;
  speciesPages: Map<string, string>;
  collections: CollectionEntry<"collectionPages">[];
}
const { city, allCities, countryPages, speciesPages, collections } = Astro.props as Props;

const cityName = city.data.city;
const country = city.data.country;
const cslug = city.id;
const trees = renderableTrees(city);
const canonical = `${BASE_URL}/${cslug}`;
const tslugs = treeSlugsForCity(city);

// The second half of a search-result title is the most expensive text on the
// site, and until 2026-08-10 all 95 city pages spent it on the same four
// words ("Remarkable Trees Worth Visiting"), which distinguish this page from
// nothing. At position ~10 the title is the one lever we hold: we cannot make
// Google rank us higher today, we can give a person a reason to click.
//
// So the tail carries the city's oldest documented age instead, which is
// concrete, different per city, and already the fact the page is built
// around. Two guards: the age comes from the same oldestTree() the question
// page uses, so the title and that page can never name different trees; and
// below 200 years it is dropped, because "Oldest 100 Years" on Cadiz is
// honest and sells the page worse than saying nothing (14 cities take that
// fallback).
const oldestHere = oldestTree(trees, city.data);
const oldestAge = oldestHere ? ageToken(oldestHere) : null;
const oldestYears = oldestAge ? parseInt(oldestAge.replace(/,/g, ""), 10) : 0;
const ageHook = oldestYears >= 200 ? oldestAge : null;
const title = fitTitle([
  ...(ageHook ? [
    `Ancient Trees in ${cityName}: ${trees.length} to See, Oldest ${ageHook} Years`,
    `Ancient Trees in ${cityName}: ${trees.length} Trees, Oldest ${ageHook} Years`,
  ] : []),
  `Ancient Trees in ${cityName}: ${trees.length} Remarkable Trees Worth Visiting`,
  `Ancient Trees in ${cityName}: ${trees.length} Trees Worth Visiting`,
  `Ancient Trees in ${cityName}`,
]);
const description =
  city.data.meta_description ||
  `The oldest and most remarkable trees in ${cityName}, ${country}: verified locations, real stories, and how to reach each one.`;
const intro = city.data.intro!;

const countryUrl = countryPages.has(country) ? `${BASE_URL}/${countryPages.get(country)}` : null;
const crumbItems: [string, string | null][] = [
  ["Home", BASE_URL],
  [country, countryUrl],
  [cityName, null],
];

const markers: WalkMarker[] = trees.map((t, i) => {
  const cphoto = usablePhoto(t);
  return {
    lat: t.location.latitude!,
    lng: t.location.longitude!,
    label: String(i + 1),
    icon: speciesIcon(t),
    name: t.name,
    id: t.id,
    area: (t.location.neighbourhood ?? "").trim(),
    shot: Boolean(cphoto),
  };
});

const faq = city.data.faq!;
const cityCollections = collections.filter((c) => c.data.entries.some((e) => e.city_slug === cslug));
const coll = cityCollections[0] ?? null;
let collLinkText: { phrase: string; verb: string } | null = null;
if (coll) {
  const n = coll.data.entries.filter((e) => e.city_slug === cslug).length;
  collLinkText = { phrase: n === 1 ? "One of these trees" : `${n} of these trees`, verb: n === 1 ? "appears" : "appear" };
}

const otherCities = otherCitiesFor(cslug, allCities);
// The visible "more cities" link list uses data/city-list.json's declared
// order (unsorted, unlimited), matching build_city_page's other_cities
// param directly (build_site.py:3502-3506). The favourites/tree-count rank
// sort is a DIFFERENT list, used only by the map's zoom-out chooser overlay
// inside cityMapScript (build_site.py:1561, "_ranked"); conflating the two
// was a real bug caught by diffing against the real build.
const moreCitiesList = byCityListOrder(otherCities.map((c) => ({ ...c, slug: c.slug })));

const speciesHere = new Map<string, number>();
for (const t of trees) speciesHere.set(speciesCommon(t), (speciesHere.get(speciesCommon(t)) ?? 0) + 1);
const citySpeciesLinks = [...speciesHere.entries()]
  .filter(([common, n]) => n >= 3 && speciesPages.has(common))
  .map(([common]) => [common, speciesPages.get(common)!] as const);

const listElements = trees.map((t, i) => {
  const p = usablePhoto(t);
  return {
    "@type": "ListItem",
    position: i + 1,
    name: t.name,
    url: `${BASE_URL}/${cslug}/${tslugs[t.id]}`,
    item: {
      "@type": "TouristAttraction",
      name: t.name,
      description: (t.story ?? "").slice(0, 200),
      ...(p?.url ? { image: metaImageUrls(p.url) } : {}),
      geo: { "@type": "GeoCoordinates", latitude: t.location.latitude, longitude: t.location.longitude },
    },
  };
});
// The page's own face: whichever tree photo the city cards already use. Google
// picks a result thumbnail from the page, and with neither og:image nor a
// schema image it was falling back to our logo on 94 of 95 city pages.
const facePhotoUrl = (() => {
  const hero = city.data.hero_tree_id ? trees.find((t) => t.id === city.data.hero_tree_id) : undefined;
  const p = (hero && usablePhoto(hero)) || trees.map((t) => usablePhoto(t)).find(Boolean);
  return p?.url ?? null;
})();
const cityOgImage = facePhotoUrl ? `\n<meta property="og:image" content="${esc(ogImageUrl(facePhotoUrl))}">` : "";
const graph = [
  ...SITE_SCHEMA,
  { "@type": "ItemList", name: title, itemListElement: listElements,
    ...(facePhotoUrl ? { image: metaImageUrls(facePhotoUrl) } : {}) },
  { "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
  breadcrumbSchema(crumbItems, canonical),
];
// When a translation of this city exists, both language versions must name
// each other (hreflang is only honoured when reciprocal), and the visitor
// gets a visible way across, which is also what keeps the /es/ page from
// being an orphan under qa.py's inbound-link rule.
const esTr = cityTranslation("es", cslug);
const headExtra = mapHead() + cityOgImage + (esTr ? "\n" + hreflangLinks("es", `/${cslug}`, `/es/${cslug}`) : "") + "\n" + ldScript(graph);

const avgLat = markers.reduce((s, m) => s + m.lat, 0) / markers.length;
const avgLng = markers.reduce((s, m) => s + m.lng, 0) / markers.length;

---
<Base title={title} description={description} canonical={canonical} headExtra={headExtra} footer={false}>
  <div class="split">
    <aside class="panel" id="sheet">
      <div class="sheet-grab">
        <div class="panel-head">
          <Breadcrumbs items={crumbItems} />
          <button type="button" class="sheet-back">← All {trees.length} trees</button>
          <p class="eyebrow">{country}</p>
          <h1>Ancient Trees in <em>{cityName}</em></h1>
          <p class="sheet-count">{trees.length} trees on the map</p>
        </div>
      </div>
      <div class="sheet-body">
      <div class="city-intro">
        <p class="lede">{intro}</p>
        {esTr && <p class="lang-alt">Esta página también está disponible <a href={`/es/${cslug}`}>en español</a>.</p>}
        <p class="passport" id="passport" hidden>
          <strong><span id="passport-count">0</span> of {trees.length}</strong> visited in {cityName}
          <span class="passport-total" id="passport-total"></span>
          <button type="button" class="passport-save" id="passport-save">Save or move to another device</button>
        </p>
      </div>
      {trees.map((t, i) => (
        <TreeCard tree={t} citySlug={cslug} treeSlug={tslugs[t.id]} index={i + 1}
                  variant="full" headingLevel={2} />
      ))}
      <div class="panel-foot">
        <p class="subtle-suggest"><b>We are mapping every remarkable tree in the world.</b> Know one in {cityName} we missed, or spot a mistake here? <a href={submitLink("tree")}>Tell us</a>.</p>
        <div class="take-with-you">
          <strong>Going there?</strong> <a href={`/${cslug}.gpx`} download>Download all {trees.length} trees</a> as a map file and open it in Google Maps, Organic Maps or any hiking app. Works offline, no app needed.
        </div>
        <div class="app-pitch">
          <strong>Walk them with the app</strong>
          <p>The walking routes, your saved trees, and the collection of the ones you have stood in front of: the Ancient Trees app.</p>
          <a class="go-btn" href="/app" data-ev="app-cta">Get the app</a>
        </div>

        <h2>Frequently asked</h2>
        <dl class="faq">
          {faq.map((f) => (
            <Fragment>
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </Fragment>
          ))}
          <dt>More on the oldest tree</dt>
          <dd><a href={`/${cslug}/oldest-tree`}>What is the oldest tree in {cityName}?</a> The full answer, with map and directions.</dd>
          {citySpeciesLinks.length > 0 && (
            <Fragment>
              <dt>Species on this list</dt>
              <dd>
                {citySpeciesLinks.map(([common, spSlug], i) => (
                  <Fragment>
                    {i > 0 && " · "}
                    <a href={`/species/${spSlug}`}>Every {common.toLowerCase()} on the site</a>
                  </Fragment>
                ))}
              </dd>
            </Fragment>
          )}
          <dt>More like this</dt>
          <dd>
            {coll && collLinkText ? (
              <Fragment>{collLinkText.phrase} also {collLinkText.verb} in <a href={`/collections/${coll.data.slug}`}>{coll.data.title}</a>.</Fragment>
            ) : (
              <Fragment>Browse <a href="/collections">themed collections</a> of remarkable trees.</Fragment>
            )}
          </dd>
          {moreCitiesList.length > 0 && (
            <Fragment>
              <dt>Ancient trees in more cities</dt>
              <dd>
                {moreCitiesList.map((c, i) => (
                  <Fragment>
                    {i > 0 && " · "}
                    <a href={`/${c.slug}`}>{c.city}</a>
                  </Fragment>
                ))}
              </dd>
            </Fragment>
          )}
        </dl>
        <p class="suggest">Know a tree that belongs on this list? <a href={submitLink("tree")}>Send it in</a>. Suggestions feed curation; the list itself stays editorial.</p>
      </div>
      </div>
    </aside>
    <div class="stage">
      <div id="map" class="map"></div>
      <div class="walks" id="walk">
        <div class="map-tools">
          <a class="map-cta" href="/app" data-ev="walks-app">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="map-cta-ic"><path d="M5 19c0-2.2 1.8-4 4-4h6c2.2 0 4-1.8 4-4s-1.8-4-4-4H9" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/><circle cx="5" cy="19" r="2.2" fill="currentColor"/><circle cx="19" cy="5" r="2.2" fill="currentColor"/></svg>
            <span class="map-cta-text">Walking routes<span class="map-cta-sub">in the app</span></span>
          </a>
          <button type="button" class="map-gps" id="gps-btn" aria-pressed="false" aria-label="Where am I">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="gps-ic"><circle cx="12" cy="12" r="3.2" fill="currentColor"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/><circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="2" fill="none"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <SignInModal />
  <Fragment slot="scripts" set:html={TREE_ACTIONS_JS + SIGNIN_JS + cityMapScript(markers, [avgLat, avgLng], null, otherCities, []) + SHEET_JS} />
</Base>
