---
// Contract A — Tree page. Ported from build_tree_page(), build_site.py:3127-3312.
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { cityIsRenderable, renderableTrees, treeSlugsForCity, distLabel, type CityEntry, type Tree } from "../../lib/trees";
import { haversineKm } from "../../lib/walks";
// THE LINK UNDER THE ACTION BAR POINTED AT A PROMOTION, and did it on every
// tree page on the site.
//
// It read "See the walking route past X's other trees" and went to `/x#walk`.
// That anchor was the city page's walk picker until 2026-08-18, when the walks
// came off the web; the same anchor now holds the block that says walking
// routes are in the app. So the sentence promised a route on this website and
// delivered an advertisement, and on a city with no walk at all it promised one
// that has never existed. Hidde found it on Oahu (2026-08-28).
//
// Contract K put the walks back on the web on 2026-08-24 at /[city]/walks, and
// took them off again on 2026-09-02: the walks are the Plus product and every
// walk control on the website now opens the app overlay. The line stays, says
// plainly that the route is in the app, counts the walks from the same helper
// that feeds the app, and says nothing at all when a city has no walk.
import { pageWalksFor, hasWalksPage } from "../../lib/city-walks";
import { speciesCommon, speciesPageSlugs } from "../../lib/species";
import { parkKey, groupTreesByPark, parkGroupKey, PARK_MIN_TREES } from "../../lib/parks";
import { usablePhoto, metaImageUrls, ogImageUrl } from "../../lib/images";
import PhotoFigure from "../../components/PhotoFigure.astro";
import { speciesIcon } from "../../lib/species-icons";
import { breadcrumbSchema, ldScript, SITE_SCHEMA, BASE_URL } from "../../lib/schema";
import { fitTitle } from "../../lib/title";
import { ageToken, metaForTree, submitLink, locationIsApproximate } from "../../lib/tree-copy";
import { treeSources } from "../../lib/tree-sources";
import WorthIt from "../../components/WorthIt.astro";
import SignInModal from "../../components/SignInModal.astro";
import SaveHeart from "../../components/SaveHeart.astro";
import ShareButton from "../../components/ShareButton.astro";
import { SHARE_JS } from "../../lib/share-js";
import { SIGNIN_JS } from "../../lib/signin-js";
import { WORTHIT_JS } from "../../lib/worthit-js";
import { TREE_ACTIONS_JS } from "../../lib/tree-actions-js";
import { seasonBlock } from "../../lib/phenology";
import { mapHead, singlePinScript } from "../../lib/map";
import { hreflangForCity, ui } from "../../lib/i18n";

function esc(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

export async function getStaticPaths() {
  const allCities = (await getCollection("cities")).filter(cityIsRenderable);
  const intros = await getCollection("countries");
  const speciesIntros = await getCollection("species");

  const countryPages = new Map<string, string>();
  const byCountryCount = new Map<string, number>();
  for (const c of allCities) byCountryCount.set(c.data.country, (byCountryCount.get(c.data.country) ?? 0) + 1);
  for (const intro of intros) {
    if ((byCountryCount.get(intro.data.country) ?? 0) >= 3) countryPages.set(intro.data.country, intro.data.slug);
  }
  const speciesPages = speciesPageSlugs(allCities, speciesIntros);
  // Park pages existed for 20 parks and no tree page linked to one, so a
  // visitor standing on a tree in the Hortus could not reach the page about
  // the Hortus (Hidde, 2026-08-18: "dat je ook makkelijk kan doorklikken naar
  // de stad / land / park / species, dat lijkt me een hele logische").
  // A park intro can outlive its page: a tree count can drop below
  // PARK_MIN_TREES (Amsterdam's Hortus, 2026-08-23) while the intro file
  // stays on disk, and this map must agree with parks/[slug].astro's own
  // filter or a tree links to a park page that never builds.
  const parkIntros = await getCollection("parks");
  const parkGroups = groupTreesByPark(allCities);
  const parkPages = new Map(
    parkIntros
      .filter((i) => (parkGroups.get(parkGroupKey(i.data.city_slug, i.data.park))?.trees.length ?? 0) >= PARK_MIN_TREES)
      .map((i) => [parkGroupKey(i.data.city_slug, i.data.park), i.data]),
  );

  const paths: { params: { city: string; tree: string }; props: any }[] = [];
  for (const city of allCities) {
    const trees = renderableTrees(city);
    const tslugs = treeSlugsForCity(city);
    for (const tree of trees) {
      const wc = (tree.story ?? "").split(/\s+/).filter(Boolean).length;
      if (wc < 150 || wc > 250) {
        throw new Error(`${city.id}/${tslugs[tree.id]}: story is ${wc} words, CLAUDE.md Step 3 requires 150-250`);
      }
      paths.push({
        params: { city: city.id, tree: tslugs[tree.id] },
        props: { city, tree, allTrees: trees, countryPages, speciesPages, parkPages },
      });
    }
  }
  return paths;
}

interface Props {
  city: CityEntry;
  tree: Tree;
  allTrees: Tree[];
  countryPages: Map<string, string>;
  speciesPages: Map<string, string>;
  parkPages: Map<string, any>;
}
const { city, tree, allTrees, countryPages, speciesPages, parkPages } = Astro.props as Props;
// The park this tree stands in, when we publish a page about it.
const parkName = parkKey(tree);
const parkPage = parkName ? (parkPages as Map<string, any>).get(parkGroupKey(city.id, parkName)) ?? null : null;

const cityName = city.data.city;
const country = city.data.country;
const cslug = city.id;
// Whether this city has walks worth mentioning at all: the same
// WALKS_PAGE_MIN_TREES test that used to decide whether /[city]/walks got
// built, kept after that page was retired because it is still the honest gate
// on saying the word "walk" to a reader. cityWalkCount (the number of walks,
// not trees) only picks the wording once that gate has already passed.
const cityHasWalksPage = hasWalksPage(city);
const cityWalkCount = pageWalksFor(city).length;
const tslugs = treeSlugsForCity(city);
const tslug = tslugs[tree.id];
const loc = tree.location;
const age = ageToken(tree);
const canonical = `${BASE_URL}/${cslug}/${tslug}`;

const title = fitTitle([
  ...(age ? [
    `${tree.name}: ${age} Year Old ${speciesCommon(tree)} in ${cityName}`,
    `${tree.name}: ${age} Year Old Tree in ${cityName}`,
  ] : []),
  // Without an age the species still earns its place: it is what somebody
  // searching "dragon tree tenerife" is looking for, and dropping the age must
  // not drop the whole description with it.
  `${tree.name}: ${speciesCommon(tree)} in ${cityName}`,
  `${tree.name} in ${cityName}`,
  tree.name,
]);
// Answer before hook, which is what Contract B asks for; see metaForTree.
const description = metaForTree(tree, cityName, ui("en").metaLead);

// Sorted by haversine distance, matching build_tree_page's own nearby sort
// (build_site.py:3152-3154).
function kmBetween(a: { latitude: number; longitude: number }, b: { latitude: number; longitude: number }): number {
  return haversineKm([a.latitude, a.longitude], [b.latitude, b.longitude]);
}
const here = { latitude: loc.latitude!, longitude: loc.longitude! };
const others = allTrees
  .filter((t) => t.id !== tree.id)
  .sort((a, b) => kmBetween(here, { latitude: a.location.latitude!, longitude: a.location.longitude! }) - kmBetween(here, { latitude: b.location.latitude!, longitude: b.location.longitude! }));
const nearby = others.slice(0, 3);

const countryUrl = countryPages.has(country) ? `${BASE_URL}/${countryPages.get(country)}` : null;
const crumbItems: [string, string | null][] = [
  ["Home", BASE_URL],
  [country, countryUrl],
  [cityName, `${BASE_URL}/${cslug}`],
  [tree.name, null],
];

const photo = usablePhoto(tree);
let ogImage = "";
if (photo?.url) ogImage = `\n<meta property="og:image" content="${esc(ogImageUrl(photo.url))}">`;

const spCommon = speciesCommon(tree);
const spSlug = speciesPages.get(spCommon);

const seasonHtml = seasonBlock(tree, loc.latitude!);
const isApprox = locationIsApproximate(tree);

const graph = [
  ...SITE_SCHEMA,
  {
    "@type": "TouristAttraction",
    name: tree.name,
    description: (tree.story ?? "").slice(0, 300),
    isAccessibleForFree: (tree.access ?? "").toLowerCase().includes("free"),
    ...(photo?.url ? { image: metaImageUrls(photo.url) } : {}),
    // url, address and containedInPlace added 2026-08-18. They do not buy a
    // rich snippet, which TouristAttraction rarely gets: they tell a search
    // engine WHICH place this is, which is the part it cannot infer from a
    // pair of coordinates and a name. containedInPlace only when we actually
    // publish a page about the park, so it points at a real thing.
    url: canonical,
    address: {
      "@type": "PostalAddress",
      ...(loc.neighbourhood ? { streetAddress: loc.neighbourhood } : {}),
      addressLocality: cityName,
      addressCountry: country,
    },
    ...(parkPage ? { containedInPlace: {
      "@type": "Park",
      name: parkPage.official_name || parkPage.park,
      url: `${BASE_URL}/parks/${parkPage.slug}`,
    } } : {}),
    geo: { "@type": "GeoCoordinates", latitude: loc.latitude, longitude: loc.longitude },
  },
  breadcrumbSchema(crumbItems, canonical),
];
// All languages carrying an overlay for THIS city; a tree slug is identical
// across languages by contract, so one path shape covers them all.
// The bare number, for the column whose label says "Years old". A value that
// repeats its own label ("Years old / roughly 135 years") is the same fault as
// a species named twice one line lower, and on the web it wrapped to five
// lines and pushed its own label down (2026-09-04).
const ageLo = typeof tree.age_min === "number" && tree.age_min > 0 ? tree.age_min : null;
const ageHi = typeof tree.age_max === "number" && ageLo && tree.age_max > ageLo ? tree.age_max : null;
const ageNumber = ageLo ? (ageHi ? `${ageLo}-${ageHi}` : `${ageLo}`) : null;
const ageLabel = ageNumber ? "Years old" : "Age";
// AND A CAP where there is no number (Hidde, 2026-09-04: "can you please give
// a max to the age part, this is way too long and fucks up the design"). An
// age_estimate is prose and can run to a sentence: "roughly 135 years, planted
// around 1889-1890" wrapped over five lines and pushed its own label down. The
// first clause is the age; everything after the comma is provenance, and
// provenance belongs in the story where the sentence has room.
const ageText = (tree.age_estimate || "").split(/[,;(]/)[0].trim();
const ageValue = ageNumber ?? (ageText.length > 24 ? "see the story" : (ageText || "not recorded"));
const hb = hreflangForCity(cslug, "tree", tslug);
const hreflangBlock = hb ? "\n" + hb : "";
const headExtra = mapHead() + ogImage + hreflangBlock + "\n" + ldScript(graph);
const sources = treeSources(tree);
const scripts = singlePinScript(loc.latitude!, loc.longitude!) + WORTHIT_JS + TREE_ACTIONS_JS + SIGNIN_JS + SHARE_JS;
---
<Base title={title} description={description} canonical={canonical} headExtra={headExtra}>
  <main class="content-page has-tree-bar">
    <Breadcrumbs items={crumbItems} />
    {/* THE APP'S TREE PAGE, PORTED (Hidde, 2026-09-04: "import the design of
        the detail tree page of the app we just finalised"). The app version
        had the convention pass this one never got, and the order it arrived at
        is better on three counts that are visible in one screenshot.

        The picture comes FIRST and runs edge to edge. It used to sit after the
        title and two chips, inset, so on a 375 point phone the one thing that
        decides whether somebody sets off was the third block down. Every
        reference (Airbnb's listing, AllTrails' trail, Apple Maps' place) opens
        with the image at full bleed and no margin.

        The facts became a CARD, high, instead of chips: age, species and pin
        honesty are the same kind of answer and belong together, and the
        species is the door to its own page. This also brings the page closer
        to Contract A, which asks for a scannable fact block above the fold;
        the detail list (location, access, transport) keeps its place below and
        now sits above the map rather than under it.

        And the spacing is a RHYTHM rather than one gap repeated: 28px between
        sections, 10px inside a group. A page where everything is equally far
        apart has no hierarchy, which was Hidde's complaint about the app on
        2026-08-26 and was equally true here. */}
    {photo && photo.url ? (
      <PhotoFigure photo={photo} alt={tree.name} lang="en" variant="hero"
        widths={[700, 1100, 1600]} sizes="(max-width: 760px) 100vw, 760px" />
    ) : (
      <figure class="tree-noph tree-hero">
        <span class="tree-noph-art" aria-hidden="true"><Fragment set:html={`<svg viewBox="0 0 40 40">${speciesIcon(tree)}</svg>`} /></span>
        <figcaption>
          <b>{spCommon}</b>
          <span>Nobody has published a photograph of this tree under a licence we can use.{" "}
          <a href="/contribute">Send us yours</a> and it goes on this page.</span>
        </figcaption>
      </figure>
    )}
    <div class="tree-head">
      <div class="page-head">
        <h1>{tree.name}{tree.label && <span class="tree-label">{tree.label}</span>}</h1>
        <ShareButton url={canonical} title={tree.name} />
      </div>
      {/* ONE SMALL LINE OF LINKS, the way AllTrails opens a trail page and
          the way the app does since 2026-09-04. The species caption that stood
          here is gone: it named the species a second time, a centimetre above
          the card that names it, and on this tree it read "Moreton Bay Fig
          (Ficus macrophylla)" over "Moreton Bay Fig". A fact belongs in one
          place per page. */}
      <p class="tree-place"><a href={`/${cslug}`}>{[loc.neighbourhood, cityName].filter(Boolean).join(", ")}</a></p>
    </div>
    {/* EVERYTHING SOMEBODY NEEDS BEFORE SETTING OFF, in one block: two
        columns for the facts that are short, then a line for the location and
        a band for the ticket, both of which need words. Ported from the app,
        2026-09-04, with the amendments Hidde made while looking at eight
        drawings of it at real phone size.

        Two columns rather than three is arithmetic and not taste: at 375px
        "Approximate" leaves the species barely 40px, which is what made the
        old three-column card wrap its age over five lines and push its own
        label down. So the location became the line that carries words, and it
        carries the ask with it.

        The rule the whole block follows: a column states a short value, a line
        carries words, a panel is for something that decides whether you set
        off at all, and a fact appears exactly once per page. */}
    <div class="tree-block">
      <div class="tb-cols">
        <div class="tb-col tb-age"><span>{ageLabel}</span><b>{ageValue}</b></div>
        {spSlug ? (
          <a class="tb-col tb-species" href={`/species/${spSlug}`}><span>Species</span><b>{spCommon} <span class="fact-go" aria-hidden="true">›</span></b></a>
        ) : (
          <div class="tb-col tb-species"><span>Species</span><b>{spCommon}</b></div>
        )}
      </div>
      {isApprox ? (
        <p class="tb-loc tb-loc-approx">
          <b>Approximate location.</b>{" "}
          <a href={submitLink("correction", cityName, tree.name)}>Show us where it is</a>
        </p>
      ) : (
        <p class="tb-loc">Exact location. The pin marks the trunk.</p>
      )}
      {tree.paid_entry && (
        <p class="tb-ticket"><b>You need a ticket to see this tree</b><span>{tree.access}</span></p>
      )}
    </div>

    <div class="tree-bar" aria-label="Actions">
      <SaveHeart treeId={tree.id} treeName={tree.name} />
      <a class="tb-primary dir-link" href={`https://www.google.com/maps/dir/?api=1&destination=${loc.latitude},${loc.longitude}`} target="_blank" rel="noopener">Take me there</a>
      <a class="tb-secondary" href="/app" data-app-modal data-ev="app-cta">Get the app</a>
    </div>
    {/* Opens the app overlay rather than a page, since 2026-09-02 (Hidde:
        "stuur ze maar gewoon naar de app"). The count stays, because it says
        what is actually there and is read off the same walks the app serves;
        what changed is that the website stops promising to show the route.
        Still gated on hasWalksPage(), so we only mention a walk in a city that
        has one. */}
    {cityHasWalksPage && (
      <p class="under-bar-link"><a href="/app" data-app-modal data-ev="walks-app">
        {cityWalkCount === 1
          ? `See the walk past ${cityName}'s other trees in the app →`
          : `See the ${cityWalkCount} walks past ${cityName}'s other trees in the app →`}
      </a></p>
    )}
    {tree.how_to_recognise && (
      <p class="which-one"><b>Which one is it?</b> {tree.how_to_recognise}</p>
    )}
    <div class="prose-block"><p>{tree.story}</p></div>
    {/* Directly under the story, moved up from the foot of the page 2026-08-16
        (Hidde: "de thumb up and thumb down opties lijken een beetje weggestopt
        ... op de diepere pagina veel hoger"). It sat as the second-to-last
        element of 212 lines. The convention puts a rating summary at the top of
        a place page and the act of rating after the content; we deliberately
        show no counts, so there is no summary to hoist, and the honest place is
        the moment the reader has just learned what the tree is. */}
    <WorthIt treeId={tree.id} city={cityName} treeName={tree.name} />
    <Fragment set:html={seasonHtml} />
    <dl class="facts">
      <dt>Species</dt><dd>{tree.species ?? ""}</dd>
      <dt>Age estimate</dt><dd>{tree.age_estimate ?? "unknown"}</dd>
      <dt>Location</dt><dd>{loc.address ?? ""} ({loc.neighbourhood ?? ""})</dd>
      <dt>Access</dt><dd>{tree.access ?? ""}</dd>
      <dt>Getting there</dt><dd>{tree.transport ?? ""}</dd>
    </dl>
    <div class="map-embed"><div id="map" class="map"></div></div>
    <p class="go-note">The button above opens directions in your maps app. {tree.transport ?? ""}</p>
    {sources.length > 0 && (
      <section class="tree-sources">
        <h2>Sources</h2>
        <p>Where the facts on this page come from.</p>
        <ul>
          {sources.map((s) => (
            <li>{s.href ? <a href={s.href} target="_blank" rel="noopener">{s.label}</a> : <span>{s.label}</span>}</li>
          ))}
        </ul>
      </section>
    )}
    {nearby.length > 0 && (
      <Fragment>
        <h2>Trees nearby</h2>
        <div class="near-cards">
          {nearby.map((t) => (
            <a class="near-card" href={`/${cslug}/${tslugs[t.id]}`}>
              <b>{t.name}</b>
              <span>{t.age_estimate ?? ""} · {distLabel({ latitude: loc.latitude!, longitude: loc.longitude! }, { latitude: t.location.latitude!, longitude: t.location.longitude! })} away</span>
            </a>
          ))}
        </div>
      </Fragment>
    )}
    {/* WHERE TO GO NEXT, as chips rather than a paragraph, which is what the
        app closes a tree with (Hidde, 2026-08-26: "onderaan de boom detail
        pagina discover more in city, park or country, verschillende knoppen").
        AllTrails closes a trail with its own facet pills and Google Maps with
        "More places nearby"; a reading page that simply stops is a dead end.
        Every link Contract A requires is still here (city page, question page,
        nearby trees above), now as targets rather than as a sentence. */}
    <section class="discover-more">
      <h2>Discover more</h2>
      <div class="dm-chips">
        <a class="dm-chip" href={`/${cslug}`}>{allTrees.length > 1 ? `All ${allTrees.length} trees in ${cityName}` : `${cityName}`}</a>
        {allTrees.length > 1 && <a class="dm-chip" href={`/${cslug}/oldest-tree`}>The oldest tree in {cityName}</a>}
        {spSlug && <a class="dm-chip" href={`/species/${spSlug}`}>Every {spCommon.toLowerCase()}</a>}
        {parkPage && <a class="dm-chip" href={`/parks/${parkPage.slug}`}>{parkPage.name || parkPage.park}</a>}
        {/* No country chip: country pages live at /[country] and only exist
            once an intro is written and three cities qualify, so linking one
            from here would need that whole check and can otherwise ship a dead
            link, which qa.py rightly refuses. The app carries a country chip
            because it has no park facet; this page has four already. */}
      </div>
    </section>
    <div class="app-pitch">
      <strong>Collect the trees you stand in front of</strong>
      <p>Ticking this one off, walks past several more, and your collection growing city by city: that is the Ancient Trees app.</p>
      <a class="go-btn" href="/app" data-app-modal data-ev="app-cta">Get the app</a>
    </div>
    <div class="report">
      <strong>We could use your help.</strong>
      <p class="report-line">This page was researched from a distance. If you know this tree, you know things we do not: the species, the age, the size, whether the photo shows the right tree, or that it is gone. Every field on this page can be corrected.</p>
      {/* "Something is wrong here" used to sit here as well, directly under the
          vote control's own nested version of the same question: three
          overlapping correction paths in one box. The chips on the control
          above now do this in one tap, and their "Something else" chip still
          reaches this form, so the duplicate link is gone rather than repeated
          (one entry point per intent). */}
      <a class="report-btn" href={submitLink("correction", cityName, tree.name)}>Correct a detail on this page</a>
      <a class="report-btn" href={submitLink("tree", cityName)}>Suggest another tree</a>
    </div>
    <SignInModal />
  </main>
  <Fragment slot="scripts" set:html={scripts} />
</Base>
