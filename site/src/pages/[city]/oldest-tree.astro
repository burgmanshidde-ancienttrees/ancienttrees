---
// Contract B — Question page. Ported from build_question_page(), build_site.py:3317-3406.
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { cityIsRenderable, renderableTrees, oldestTree, treeSlugsForCity, slugify, type CityEntry } from "../../lib/trees";
import { ageToken } from "../../lib/tree-copy";
import { breadcrumbSchema, ldScript, SITE_SCHEMA, BASE_URL } from "../../lib/schema";
import { fitTitle } from "../../lib/title";
import { mapHead, singlePinScript } from "../../lib/map";
import { DESC_MAX } from "../../lib/site-config";
import { GENERIC_WORDS } from "../../lib/question-words";

export async function getStaticPaths() {
  const allCities = (await getCollection("cities")).filter(cityIsRenderable);
  const intros = await getCollection("countries");
  const collections = await getCollection("collectionPages");

  const countryPages = new Map<string, string>();
  const byCountryCount = new Map<string, number>();
  for (const c of allCities) byCountryCount.set(c.data.country, (byCountryCount.get(c.data.country) ?? 0) + 1);
  for (const intro of intros) {
    if ((byCountryCount.get(intro.data.country) ?? 0) >= 3) countryPages.set(intro.data.country, intro.data.slug);
  }

  return allCities.map((city) => {
    const trees = renderableTrees(city);
    const old = oldestTree(trees, city.data);
    const answer = city.data.question_answer ?? "";
    const context = city.data.question_context ?? "";
    if (!answer || !context) {
      throw new Error(`${city.id}/oldest-tree: question_answer and question_context must be written per city (Contract B)`);
    }
    const tokens = (old.name.match(/[A-Za-z']+/g) ?? []).filter((w) => /^[A-Z]/.test(w) && !GENERIC_WORDS.has(w.toLowerCase()));
    if (tokens.length > 0 && !tokens.some((t) => answer.toLowerCase().includes(t.toLowerCase()))) {
      throw new Error(`${city.id}/oldest-tree: question_answer never mentions ${JSON.stringify(old.name)} (looked for ${JSON.stringify(tokens)}); set oldest_tree_id or rewrite the answer`);
    }
    const contextWc = context.split(/\s+/).filter(Boolean).length;
    if (contextWc < 150 || contextWc > 200) {
      throw new Error(`${city.id}/oldest-tree: question_context is ${contextWc} words, Contract B requires 150-200`);
    }
    return { params: { city: city.id }, props: { city, trees, old, countryPages, collections } };
  });
}

interface Props {
  city: CityEntry;
  trees: ReturnType<typeof renderableTrees>;
  old: ReturnType<typeof oldestTree>;
  countryPages: Map<string, string>;
  collections: Awaited<ReturnType<typeof getCollection<"collectionPages">>>;
}
const { city, trees, old, countryPages, collections } = Astro.props as Props;

const cityName = city.data.city;
const country = city.data.country;
const cslug = city.id;
const oslug = slugify(old.name);
const loc = old.location;
const age = ageToken(old);
const canonical = `${BASE_URL}/${cslug}/oldest-tree`;
const question = `What is the oldest tree in ${cityName}?`;

const title = fitTitle([
  ...(age ? [
    `What Is the Oldest Tree in ${cityName}? (${old.name}, ${age} Years)`,
    `What Is the Oldest Tree in ${cityName}? (${age} Years Old)`,
  ] : []),
  `What Is the Oldest Tree in ${cityName}?`,
]);
const answer = city.data.question_answer!;
const context = city.data.question_context!;
const description = city.data.question_meta || answer.slice(0, DESC_MAX);

const countryUrl = countryPages.has(country) ? `${BASE_URL}/${countryPages.get(country)}` : null;
const crumbItems: [string, string | null][] = [
  ["Home", BASE_URL],
  [country, countryUrl],
  [cityName, `${BASE_URL}/${cslug}`],
  ["Oldest tree", null],
];

const related = (city.data.faq ?? []).filter((f) => !f.q.toLowerCase().includes("oldest")).slice(0, 3);
const faqEntities = [
  { "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } },
  ...related.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
];

const cityCollections = collections.filter((c) => c.data.entries.some((e) => e.city_slug === cslug));
const coll = cityCollections[0] ?? null;

const graph = [...SITE_SCHEMA, { "@type": "FAQPage", mainEntity: faqEntities }, breadcrumbSchema(crumbItems, canonical)];
const headExtra = mapHead() + "\n" + ldScript(graph);
const scripts = singlePinScript(loc.latitude!, loc.longitude!);
---
<Base title={title} description={description} canonical={canonical} headExtra={headExtra}>
  <main class="content-page">
    <Breadcrumbs items={crumbItems} />
    <h1>{question}</h1>
    <p class="answer-first">{answer}</p>
    <div class="map-embed"><div id="map" class="map"></div></div>
    <div class="prose-block"><p>{context}</p></div>
    <div class="cta">
      Read <a href={`/${cslug}/${oslug}`}>the full story of {old.name}</a>, or see <a href={`/${cslug}`}>all {trees.length} remarkable ancient trees in {cityName}</a>.
    </div>
    {coll ? (
      <p class="prose-block">
        One of {cityName}'s trees also appears in <a href={`/collections/${coll.data.slug}`}>{coll.data.title}</a>, a themed collection spanning several cities.
      </p>
    ) : (
      <p class="prose-block">See more <a href="/collections">themed collections</a> of remarkable trees.</p>
    )}
  </main>
  <Fragment slot="scripts" set:html={scripts} />
</Base>
