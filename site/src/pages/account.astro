---
// The sign-in flow: email in, check-your-inbox with masked address and a
// resend cooldown, an expired-link recovery, and the signed-in shell that
// shows the visitor's real on-device collection. Ported from
// build_account_page(), build_site.py:5487-5685. Kept noindexed and out of
// the sitemap (sitemap-integration.ts excludes any noindexed page by
// content, matching Python's "write straight to disk, skip the pages list"
// trick) - this is still a prototype even with AUTH_ENABLED true.
import Base from "../layouts/Base.astro";
import { BASE_URL } from "../lib/schema";
import { SUPABASE_URL, SUPABASE_KEY } from "../lib/site-config";
import { SAVED_LIST_JS } from "../lib/saved-list-js";
import { MY_TREES_JS } from "../lib/my-trees-js";
import { TREE_ACTIONS_JS } from "../lib/tree-actions-js";
import SignInModal from "../components/SignInModal.astro";
import { SIGNIN_JS } from "../lib/signin-js";
import { VISITED_SYNC_JS } from "../lib/visited-sync-js";

const canonical = `${BASE_URL}/account`;
---
<Base
  title="Sign in to Ancient Trees"
  description="Keep your tree collection on every device."
  canonical={canonical}
  headExtra='<meta name="robots" content="noindex, nofollow">'
>
<main class="content-page account-page">

  <section id="st-signin" class="acct-card">
    <p class="hero-kicker">Your tree collection</p>
    <h1>Sign in to keep it <em>everywhere</em>.</h1>
    <p class="acct-sub">We send you a sign-in link, and your account keeps what you collect and save.</p>
    <button type="button" class="oauth-btn" id="acct-google">Continue with Google</button>
    <p class="signin-or">or</p>
    <form id="acct-form" class="hero-search" autocomplete="email">
      <input type="email" id="acct-email" placeholder="you@example.com" aria-label="Email address" required>
      <button type="submit" class="go-btn">Email me a sign-in link</button>
    </form>
    <p class="acct-fine">We hold your email address, the name and picture you chose, and the trees you have saved, collected and photographed. You can delete all of it at any time. <a href="/privacy">Privacy</a></p>
  </section>

  <section id="st-sent" class="acct-card" hidden>
    <h1>Check your <em>inbox</em>.</h1>
    <p class="acct-sub">We sent a sign-in link to <strong id="sent-to"></strong>. It works once and expires in 15 minutes.</p>
    <p class="acct-actions">
      <button type="button" id="resend" class="go-btn ghost" disabled>Resend (<span id="cool">30</span>)</button>
      <button type="button" id="change" class="acct-link">Use a different address</button>
    </p>
  </section>

  <section id="st-expired" class="acct-card" hidden>
    <h1>That link has <em>expired</em>.</h1>
    <p class="acct-sub">Links work once and briefly, to keep your account safe. One tap gets you a fresh one.</p>
    <p class="acct-actions"><button type="button" id="re-expired" class="go-btn">Send a new link</button></p>
  </section>

  <!-- BUILT LIKE THE APP'S SETTINGS SCREEN, 2026-08-31, on Hidde's ask. It was
       one flat card with Sign out and Delete my account sitting side by side on
       it, a mis-click apart. The app puts deletion a layer in, under Account,
       which is what he ruled on 2026-08-21 ("most of the time they put the
       click further down") and what every reference does: Strava is Settings,
       My Account, Delete Account; AllTrails the same; GitHub keeps destructive
       actions in a marked area at the foot of the account page. CONVENTIONS.md
       carries the full lookup.

       A <details> rather than a second page: on the web a disclosure is the
       honest equivalent of a pushed screen, it needs no routing, and it keeps
       the one thing that matters, which is that deletion is not on the surface
       somebody lands on. -->
  <section id="st-in" class="acct-card" hidden>
    <p class="hero-kicker">Signed in</p>
    <h1>Your <em>trees</em>.</h1>

    <div class="acct-identity">
      <strong id="in-email"></strong>
      <div class="stat-row">
        <div class="stat"><b id="n-mine">0</b><span>your trees</span></div>
        <div class="stat alt"><b id="n-trees">0</b><span>saved</span></div>
        <div class="stat"><b id="n-cities">0</b><span>cities</span></div>
      </div>
    </div>
    <p class="acct-sub" id="in-note">The trees you photographed and the ones you saved follow this account to any device.</p>
    <!-- Said plainly because Google and Apple hand out different addresses, and
         Apple's is a private relay by default. Somebody who signs in with Apple
         on the phone and Google here would otherwise see an empty collection
         and conclude we lost it. -->
    <p class="acct-fine">Your trees are kept under this address. Signing in with a different one starts a separate collection. To use a different address, write to <a href="mailto:info@ancienttrees.app">info@ancienttrees.app</a> and we will move your collection across.</p>

    <p class="acct-group">Settings</p>
    <div class="acct-rows">
      <!-- THE NAME OTHER PEOPLE SEE. The app has had a profile editor since the
           social half shipped and this page had nothing, so an account made
           here could never be found by anybody: the finder searches
           display_name, and a profile row only comes into being when a name is
           set. Name only, no picture: uploading needs the avatars bucket and
           its policies, and the name is the whole of what makes an account
           findable. -->
      <div class="acct-row">
        <label for="in-name">The name people see</label>
        <div class="acct-name-row">
          <input id="in-name" type="text" maxlength="40" autocomplete="nickname"
                 placeholder="Nobody sees this until you set it" />
          <button type="button" id="save-name" class="go-btn">Save</button>
        </div>
        <p class="acct-fine" id="name-note">Set a name and people can find you in the app to follow your trees. Leave it empty and nobody can.</p>
      </div>

    </div>

    <p class="acct-group">About</p>
    <div class="acct-rows">
      <a class="acct-row acct-linkrow" href="/privacy">Privacy</a>
      <a class="acct-row acct-linkrow" href="/terms">Terms</a>
      <a class="acct-row acct-linkrow" href="/support">Support</a>
    </div>

    <p class="acct-actions"><button type="button" id="signout" class="acct-link">Sign out</button></p>

    <!-- DELETION AT THE FOOT, IN A MARKED AREA, OPENING A SCREEN OF ITS OWN.
         Moved here 2026-08-31 after Hidde read the first attempt and said it
         stood oddly, which it did. I had copied the app, where deletion lives
         inside a pushed Account screen, into a disclosure sitting among the
         settings rows. On the web that is nobody's pattern: GitHub puts a
         Danger Zone at the foot of the account page with a named button that
         opens a dialog, Strava a Delete Your Account link at the foot of My
         Account, Airbnb and Google the same shape.

         The both-surfaces rule is what I got wrong. It asks that the BEHAVIOUR
         match, not the design: deletion costs a second, deliberate step on
         both. A pushed screen does that on a phone; a named button at the foot
         opening an explanation does it here. -->
    <details class="acct-danger" id="del-panel">
      <summary>Delete account</summary>
      <div class="acct-danger-body">
        <p class="acct-fine">We hold your email address, the name and picture you chose, and the trees you have saved, collected and photographed. Deleting your account removes all of it, and it cannot be undone.</p>
        <button type="button" id="del-acct" class="acct-link danger">Delete my account</button>
      </div>
    </details>
  </section>

  <!-- TWO LANES, BUILT LIKE THE APP'S MY TREES SCREEN (Hidde, 2026-09-02: "de
       web account pagina moet veel meer de opbouw van app gaan krijgen"). The
       app has held these as two independent lists since 2026-08-26, opening on
       your own trees rather than on the wishlist, because the page is called
       My trees and the trees that are yours are the ones you photographed; a
       list of things you have not seen yet is the second question.

       The picker is a tab pair rather than the app's segmented control: same
       behaviour, and the design is per surface (CLAUDE.md's both-surfaces
       rule). It sits outside the signed-in card because the saved lane works
       signed out, from this device alone, and always has. -->
  <section class="acct-lanes" id="lanes">
    <div class="lane-picker" role="tablist" aria-label="Your lists">
      <button type="button" id="lane-mine" class="lane on" role="tab" aria-selected="true" aria-controls="pane-mine">My trees</button>
      <button type="button" id="lane-saved" class="lane" role="tab" aria-selected="false" aria-controls="pane-saved">Saved</button>
    </div>

    <div id="pane-mine" role="tabpanel" aria-labelledby="lane-mine">
      <ul id="mine-list" class="saved-list" hidden></ul>
      <p id="mine-empty" hidden>You can add a tree in the app by photographing it and filling in what you know. <a href="/app">Get the app</a>.</p>
      <p id="mine-signedout" hidden>Sign in above and the trees you photographed appear here.</p>
    </div>

    <div id="pane-saved" role="tabpanel" aria-labelledby="lane-saved" hidden>
      <p class="prose-block" id="saved-sub">The trees you tapped Save on. Sign in above to see them here and on any other device.</p>
      <ul id="saved-list" class="saved-list" hidden></ul>
      <p id="saved-empty" hidden>Nothing saved yet. Open any tree and tap <b>&#9825; Save</b> to keep it here for the day you walk past. <a href="/explore">Find a tree near you</a>.</p>
    </div>
  </section>
  <SignInModal />
</main>
<Fragment slot="scripts" set:html={TREE_ACTIONS_JS + SIGNIN_JS + VISITED_SYNC_JS + SAVED_LIST_JS + MY_TREES_JS + `
<script>
(function() {
  var SB = "${SUPABASE_URL}";
  var KEY = "${SUPABASE_KEY}";
  var states = ["st-signin", "st-sent", "st-expired", "st-in"];
  function show(id) {
    states.forEach(function(x) { document.getElementById(x).hidden = (x !== id); });
  }
  function mask(e) {
    var at = e.indexOf("@");
    if (at < 2) return e;
    return e[0] + "•••" + e.slice(at - 1);
  }
  var lastEmail = "";
  function sendLink(email, done) {
    fetch(SB + "/auth/v1/otp?redirect_to=" + encodeURIComponent(location.origin + location.pathname), {
      method: "POST",
      headers: { "apikey": KEY, "Content-Type": "application/json" },
      body: JSON.stringify({ email: email, create_user: true })
    }).then(function(r) { done(r.ok); }).catch(function() { done(false); });
  }
  var cooldown = null;
  function startCooldown() {
    var btn = document.getElementById("resend"), n = 30;
    btn.disabled = true;
    clearInterval(cooldown);
    cooldown = setInterval(function() {
      n--; document.getElementById("cool").textContent = n;
      if (n <= 0) { clearInterval(cooldown); btn.disabled = false; btn.textContent = "Resend link"; }
    }, 1000);
  }
  // The saved-list script owns these two numbers now (lib/saved-list-js.ts):
  // they count the saved trees this page lists, not the check-in log, which
  // is app-only on a phone and therefore permanently zero here.
  function localStats() {}
  // Who is signed in, kept so the name can be written against the right row.
  var myId = null;
  function signedIn(session) {
    try { localStorage.setItem("ancienttrees_session", JSON.stringify(session)); } catch (e) {}
    fetch(SB + "/auth/v1/user", { headers: { "apikey": KEY, "Authorization": "Bearer " + session.access_token } })
      .then(function(r) { return r.ok ? r.json() : null; })
      .then(function(u) {
        if (u && u.email) document.getElementById("in-email").textContent = u.email;
        if (u && u.id) { myId = u.id; loadName(session.access_token, u.id); }
      })
      .catch(function() {});
    localStats();
    if (window.atLoadMine) window.atLoadMine(session.access_token);
    show("st-in");
  }

  // The name they already chose, wherever they chose it. An empty box on a
  // page that already knows the answer reads as data lost, and somebody who
  // set their name in the app would be looking at exactly that.
  function loadName(token, id) {
    fetch(SB + "/rest/v1/profiles?select=display_name&user_id=eq." + encodeURIComponent(id),
          { headers: { "apikey": KEY, "Authorization": "Bearer " + token } })
      .then(function(r) { return r.ok ? r.json() : null; })
      .then(function(rows) {
        if (rows && rows[0] && rows[0].display_name) {
          document.getElementById("in-name").value = rows[0].display_name;
        }
      })
      .catch(function() {});
  }
  function parseHash() {
    var h = {};
    location.hash.slice(1).split("&").forEach(function(kv) {
      var p = kv.split("=");
      if (p[0]) h[decodeURIComponent(p[0])] = decodeURIComponent(p[1] || "");
    });
    return h;
  }
  var h = parseHash();
  if (h.access_token) {
    history.replaceState(null, "", location.pathname);
    signedIn({
      access_token: h.access_token,
      refresh_token: h.refresh_token || "",
      expires_at: Math.floor(Date.now() / 1000) + parseInt(h.expires_in || "3600", 10)
    });
  } else if (h.error_code === "otp_expired" || h.error === "access_denied") {
    history.replaceState(null, "", location.pathname);
    show("st-expired");
  } else {
    try {
      var s = JSON.parse(localStorage.getItem("ancienttrees_session"));
      if (s && s.expires_at > Date.now() / 1000) signedIn(s);
    } catch (e) {}
  }
  document.getElementById("acct-form").addEventListener("submit", function(ev) {
    ev.preventDefault();
    var e = document.getElementById("acct-email").value.trim();
    if (!e) return;
    lastEmail = e;
    sendLink(e, function(ok) {
      if (ok) {
        document.getElementById("sent-to").textContent = mask(e);
        show("st-sent"); startCooldown();
      } else {
        document.getElementById("acct-email").setCustomValidity("That did not work; try again in a minute.");
        document.getElementById("acct-form").reportValidity();
        setTimeout(function() { document.getElementById("acct-email").setCustomValidity(""); }, 3000);
      }
    });
  });
  document.getElementById("change").addEventListener("click", function() { show("st-signin"); });
  document.getElementById("resend").addEventListener("click", function() {
    if (lastEmail) sendLink(lastEmail, function() {});
    startCooldown();
  });
  document.getElementById("re-expired").addEventListener("click", function() {
    if (lastEmail) { sendLink(lastEmail, function() {}); document.getElementById("sent-to").textContent = mask(lastEmail); }
    show(lastEmail ? "st-sent" : "st-signin"); if (lastEmail) startCooldown();
  });
  // Saving it. The SAME upsert the app makes (profiles?on_conflict=user_id
  // with resolution=merge-duplicates), so setting a name here and setting one
  // in the app are one operation against one row rather than two paths that
  // can disagree. CLAUDE.md's both-surfaces rule: the decision travels, the
  // design does not have to.
  var nameBtn = document.getElementById("save-name");
  nameBtn.addEventListener("click", function() {
    var box = document.getElementById("in-name");
    var note = document.getElementById("name-note");
    var v = box.value.trim();
    var s = null;
    try { s = JSON.parse(localStorage.getItem("ancienttrees_session")); } catch (e) {}
    if (!s || !myId) { note.textContent = "Sign in again and try once more."; return; }
    if (v.length < 1 || v.length > 40) {
      note.textContent = "A name is between 1 and 40 characters.";
      return;
    }
    nameBtn.disabled = true;
    note.textContent = "Saving.";
    fetch(SB + "/rest/v1/profiles?on_conflict=user_id", {
      method: "POST",
      headers: {
        "apikey": KEY,
        "Authorization": "Bearer " + s.access_token,
        "Content-Type": "application/json",
        "Prefer": "resolution=merge-duplicates"
      },
      body: JSON.stringify([{ user_id: myId, display_name: v }])
    }).then(function(r) {
      nameBtn.disabled = false;
      note.textContent = r.ok
        ? "Saved. People can find you as " + v + " in the app."
        : "That did not save. Try again, or write to info@ancienttrees.app.";
    }).catch(function() {
      nameBtn.disabled = false;
      note.textContent = "That did not save. Try again in a moment.";
    });
  });

  // The lane picker. Two panes, one visible, and the tab that is on says so
  // to a screen reader as well as in ink.
  var lanes = [["lane-mine", "pane-mine"], ["lane-saved", "pane-saved"]];
  lanes.forEach(function(pair) {
    document.getElementById(pair[0]).addEventListener("click", function() {
      lanes.forEach(function(other) {
        var on = other[0] === pair[0];
        var tab = document.getElementById(other[0]);
        tab.classList.toggle("on", on);
        tab.setAttribute("aria-selected", on ? "true" : "false");
        document.getElementById(other[1]).hidden = !on;
      });
    });
  });

  document.getElementById("signout").addEventListener("click", function() {
    try {
      var s = JSON.parse(localStorage.getItem("ancienttrees_session"));
      if (s) fetch(SB + "/auth/v1/logout", { method: "POST",
        headers: { "apikey": KEY, "Authorization": "Bearer " + s.access_token } }).catch(function() {});
    } catch (e) {}
    try { localStorage.removeItem("ancienttrees_session"); } catch (e) {}
    if (window.atClearMine) window.atClearMine();
    show("st-signin");
  });
  // Account deletion: calls the delete_user() SECURITY DEFINER function in
  // Supabase (runs as owner, deletes auth.users row for auth.uid() only).
  // Two clicks on purpose; no dialog dependency. The on-device collection in
  // ancienttrees_seen is deliberately left alone: it was never on the server.
  var delBtn = document.getElementById("del-acct");
  var delArmed = false;
  delBtn.addEventListener("click", function() {
    if (!delArmed) {
      delArmed = true;
      delBtn.textContent = "This permanently deletes your account and email. Click again to confirm.";
      return;
    }
    var s = null;
    try { s = JSON.parse(localStorage.getItem("ancienttrees_session")); } catch (e) {}
    if (!s) { show("st-signin"); return; }
    fetch(SB + "/rest/v1/rpc/delete_user", { method: "POST",
      headers: { "apikey": KEY, "Authorization": "Bearer " + s.access_token,
                 "Content-Type": "application/json" }, body: "{}" })
      .then(function(r) {
        if (r.ok) {
          try { localStorage.removeItem("ancienttrees_session"); } catch (e) {}
          if (window.atClearMine) window.atClearMine();
          delArmed = false;
          delBtn.textContent = "Delete my account";
          show("st-signin");
        } else {
          delBtn.textContent = "Deletion failed. Try again, or email us via the privacy page.";
        }
      })
      .catch(function() {
        delBtn.textContent = "Deletion failed (network). Try again.";
      });
  });
})();
</script>
`} />
</Base>
