---
// Your profile: who you are, what you have collected, and your two lists.
//
// REBUILT 2026-09-02 TO MATCH THE APP (Hidde: "laten we deze opzet aanhouden
// voor je profielpagina - daar alle functionaliteiten inbouwen die we ook in
// de app hebben gebouwd en dan settings een knop dieper"), with the app's own
// My trees screen and a Polarsteps profile beside it as the references.
//
// Convention, and it is the same one both references follow: a profile opens
// with WHO, then a row of counts, then the thing you can do, then your lists.
// Settings are not on it; they sit behind a gear in the corner. That is
// Polarsteps, Strava, AllTrails and our own app, and it is what this page got
// wrong: it opened with a sign-in card and then stacked the account admin, the
// name editor and a delete panel around the trees.
//
// The counts are the app's counts, taken from Collect.swift so the two
// surfaces cannot answer the same question differently: trees you have stood
// in front of plus trees you added, the species among them, the countries.
//
// Both-surfaces note (CLAUDE.md, 2026-08-21): the BEHAVIOUR matches the app,
// the design does not have to. Adding a tree is a camera sheet on the phone
// and the contribute form here, because a laptop has no camera in a park.
//
// Kept noindexed and out of the sitemap: this is somebody's own page.
import Base from "../layouts/Base.astro";
import { BASE_URL } from "../lib/schema";
import { SUPABASE_URL, SUPABASE_KEY } from "../lib/site-config";
import { PROFILE_JS } from "../lib/profile-js";
import { MY_TREES_JS } from "../lib/my-trees-js";
import { TREE_ACTIONS_JS } from "../lib/tree-actions-js";
import SignInPanel from "../components/SignInPanel.astro";
import { myTreesMapScript, mapHead } from "../lib/map";
import { SHEET_JS } from "../lib/sheet-js";

const canonical = `${BASE_URL}/account`;
---
<Base
  title="Your trees"
  description="Keep your tree collection on every device."
  canonical={canonical}
  headExtra={'<meta name="robots" content="noindex, nofollow">' + mapHead()}
  footer={false}
>
{/* THE SHARED MAP-PAGE SKELETON, the one the city page and /explore already
    use: panel on the left, map filling the rest. Not a third layout, per the
    rule this project has had to learn twice (one layout for map pages: fix
    the shared piece, never one page). */}
<div class="split">
  <aside class="panel" id="sheet">
  <div class="sheet-grab"><div class="panel-head">

  {/* THE SAME PANEL THE DIALOG RENDERS, not a copy of it. Hidde looked at
      this page after the deploy and said "het lijkt niet echt live": it was,
      and it carried the sheet's button weights without its shape, because the
      two were kept in step by hand. They are one file now. */}
  <section id="st-signin" class="acct-card signin-dialog--page">
    <SignInPanel lang="en" prefix="acct" />
  </section>

  <section id="st-sent" class="acct-card" hidden>
    <h1>Check your <em>inbox</em>.</h1>
    <p class="acct-sub">We sent a sign-in link to <strong id="sent-to"></strong>. It works once and expires in 15 minutes.</p>
    <p class="acct-actions">
      <button type="button" id="resend" class="go-btn ghost" disabled>Resend (<span id="cool">30</span>)</button>
      <button type="button" id="change" class="acct-link">Use a different address</button>
    </p>
  </section>

  <section id="st-expired" class="acct-card" hidden>
    <h1>That link has <em>expired</em>.</h1>
    <p class="acct-sub">Links work once and briefly, to keep your account safe. One tap gets you a fresh one.</p>
    <p class="acct-actions"><button type="button" id="re-expired" class="go-btn">Send a new link</button></p>
  </section>

  <!-- THE PROFILE ITSELF. Identity, counts, the one action, then the lists.
       The gear is the only way to the settings, exactly as in the app. -->
  <section id="st-in" class="profile-head" hidden>
    <div class="profile-top">
      <span class="profile-avatar" id="in-avatar" aria-hidden="true"></span>
      <div class="profile-who">
        <h1 id="in-handle">Your trees</h1>
        <p class="profile-follow"><b id="n-followers">0</b> followers &nbsp; <b id="n-following">0</b> following</p>
      </div>
      <a class="profile-gear" href="/account/settings" aria-label="Settings">
        <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M19.4 13.5a7.6 7.6 0 0 0 0-3l1.7-1.3-2-3.4-2 .8a7.6 7.6 0 0 0-2.6-1.5L14.2 3H9.8l-.3 2.1a7.6 7.6 0 0 0-2.6 1.5l-2-.8-2 3.4 1.7 1.3a7.6 7.6 0 0 0 0 3L2.9 14.8l2 3.4 2-.8a7.6 7.6 0 0 0 2.6 1.5l.3 2.1h4.4l.3-2.1a7.6 7.6 0 0 0 2.6-1.5l2 .8 2-3.4z"/></svg>
      </a>
    </div>

    <div class="stat-row">
      <div class="stat"><b id="n-trees">0</b><span>Trees</span></div>
      <div class="stat alt"><b id="n-species">0</b><span>Species</span></div>
      <div class="stat"><b id="n-countries">0</b><span>Countries</span></div>
    </div>

    {/* Full width, because it is the one action on the page and both
        references draw it that way: our own Collect screen and Polarsteps'
        red "Voeg een reis toe". A pill hugging its own text reads as a
        secondary link.

        No "signed in as ..." paragraph here. It was three lines of grey
        between the button and the lists, and the app keeps that fact in
        Settings, which is where it now lives on the web too. The trees are
        the screen. */}
    <a class="go-btn profile-add" href="/contribute?kind=tree">Add a tree</a>
  </section>
  </div></div>

  <div class="sheet-body">

  <!-- TWO LANES, THE APP'S TWO LANES, in the app's order and with the app's
       words (Hidde, 2026-08-26: "ik zou daar op openen, niet op favourites").
       My trees is what you have stood in front of and what you added;
       Favourites is what you hearted. They are independent lists and a tree
       may be in both. -->
  <section class="acct-lanes" id="saved" hidden>
    <div class="lane-picker" role="tablist" aria-label="Your lists">
      <button type="button" id="lane-mine" class="lane on" role="tab" aria-selected="true" aria-controls="pane-mine">My trees</button>
      <button type="button" id="lane-saved" class="lane" role="tab" aria-selected="false" aria-controls="pane-saved">Favourites</button>
    </div>

    <div id="pane-mine" role="tabpanel" aria-labelledby="lane-mine">
      <ul id="visited-list" class="saved-list" hidden></ul>
      <ul id="mine-list" class="saved-list" hidden></ul>
      {/* THE APP'S OWN EMPTY LINES (Collect.swift), one sentence each, rather
          than the three-clause versions this page had written for itself. The
          method differs by surface and only the method: a laptop has no camera
          in a park, so the web says the form. */}
      <p id="mine-empty" hidden>You add a tree here by photographing it in the app, or by <a href="/contribute?kind=tree">telling us about one</a>.</p>
    </div>

    <div id="pane-saved" role="tabpanel" aria-labelledby="lane-saved" hidden>
      <ul id="saved-list" class="saved-list" hidden></ul>
      <p id="saved-empty" hidden>No favourites yet. Tap a heart anywhere to keep a tree here.</p>
    </div>
  </section>

  <!-- UNITS lived here until 2026-09-18 and is in /account/settings now, which
       is where the app keeps it (Screens/Profile.swift) and what this page's
       own rule above says: settings are not on the profile, they sit behind
       the gear. Same convention as AllTrails and komoot, which keep one Units
       switch in account settings and apply it to web and app alike. -->
  </div>
  </aside>
  <div class="stage">
    <div id="map" class="map"></div>
  </div>
</div>
<Fragment slot="scripts" set:html={TREE_ACTIONS_JS + myTreesMapScript() + PROFILE_JS + MY_TREES_JS + SHEET_JS + `
<script>
(function() {
  var SB = "${SUPABASE_URL}";
  var KEY = "${SUPABASE_KEY}";
  var states = ["st-signin", "st-sent", "st-expired", "st-in"];
  function show(id) {
    states.forEach(function(x) { document.getElementById(x).hidden = (x !== id); });
    // The lists are the second half of the signed-in state.
    document.getElementById("saved").hidden = (id !== "st-in");
  }
  var lastEmail = "";
  function mask(e) {
    var at = e.indexOf("@");
    if (at < 2) return e;
    return e[0] + "•••" + e.slice(at - 1);
  }
  function sendLink(email, done) {
    fetch(SB + "/auth/v1/otp?redirect_to=" + encodeURIComponent(location.origin + location.pathname), {
      method: "POST",
      headers: { "apikey": KEY, "Content-Type": "application/json" },
      body: JSON.stringify({ email: email, create_user: true })
    }).then(function(r) { done(r.ok); }).catch(function() { done(false); });
  }
  var cooldown = null;
  function startCooldown() {
    var btn = document.getElementById("resend"), n = 30;
    btn.disabled = true;
    clearInterval(cooldown);
    cooldown = setInterval(function() {
      n--; document.getElementById("cool").textContent = n;
      if (n <= 0) { clearInterval(cooldown); btn.disabled = false; btn.textContent = "Resend link"; }
    }, 1000);
  }
  function signedIn(session) {
    try { localStorage.setItem("ancienttrees_session", JSON.stringify(session)); } catch (e) {}
    show("st-in");
    // The heart script concluded there was nobody signed in before the token
    // arrived in the url hash; tell it otherwise.
    if (window.atSyncSaves) window.atSyncSaves();
    if (window.atLoadProfile) window.atLoadProfile(session.access_token);
    if (window.atLoadMine) window.atLoadMine(session.access_token);
  }
  function parseHash() {
    var h = {};
    location.hash.slice(1).split("&").forEach(function(kv) {
      var p = kv.split("=");
      if (p[0]) h[decodeURIComponent(p[0])] = decodeURIComponent(p[1] || "");
    });
    return h;
  }
  var h = parseHash();
  if (h.access_token) {
    history.replaceState(null, "", location.pathname);
    signedIn({
      access_token: h.access_token,
      refresh_token: h.refresh_token || "",
      expires_at: Math.floor(Date.now() / 1000) + parseInt(h.expires_in || "3600", 10)
    });
  } else if (h.error_code === "otp_expired" || h.error === "access_denied") {
    history.replaceState(null, "", location.pathname);
    show("st-expired");
  } else {
    try {
      var s = JSON.parse(localStorage.getItem("ancienttrees_session"));
      if (s && s.expires_at > Date.now() / 1000) signedIn(s);
    } catch (e) {}
  }
  document.getElementById("acct-form").addEventListener("submit", function(ev) {
    ev.preventDefault();
    var e = document.getElementById("acct-email").value.trim();
    if (!e) return;
    lastEmail = e;
    sendLink(e, function(ok) {
      if (ok) {
        document.getElementById("sent-to").textContent = mask(e);
        show("st-sent"); startCooldown();
      } else {
        document.getElementById("acct-email").setCustomValidity("That did not work; try again in a minute.");
        document.getElementById("acct-form").reportValidity();
        setTimeout(function() { document.getElementById("acct-email").setCustomValidity(""); }, 3000);
      }
    });
  });
  document.getElementById("change").addEventListener("click", function() { show("st-signin"); });
  document.getElementById("resend").addEventListener("click", function() {
    if (lastEmail) sendLink(lastEmail, function() {});
    startCooldown();
  });
  document.getElementById("re-expired").addEventListener("click", function() {
    if (lastEmail) { sendLink(lastEmail, function() {}); document.getElementById("sent-to").textContent = mask(lastEmail); }
    show(lastEmail ? "st-sent" : "st-signin"); if (lastEmail) startCooldown();
  });

  // The lane picker. Two panes, one visible, and the tab that is on says so
  // to a screen reader as well as in ink.
  var lanes = [["lane-mine", "pane-mine"], ["lane-saved", "pane-saved"]];
  function lane(id) {
    lanes.forEach(function(other) {
      var on = other[0] === id;
      var tab = document.getElementById(other[0]);
      tab.classList.toggle("on", on);
      tab.setAttribute("aria-selected", on ? "true" : "false");
      document.getElementById(other[1]).hidden = !on;
    });
  }
  lanes.forEach(function(pair) {
    document.getElementById(pair[0]).addEventListener("click", function() { lane(pair[0]); });
  });
  // The nav's heart, the footer and /saved have all pointed at /account#saved
  // for weeks. The anchor lands on this block and opens the lane it names.
  if (location.hash === "#saved") lane("lane-saved");
})();
</script>
`} />
</Base>
