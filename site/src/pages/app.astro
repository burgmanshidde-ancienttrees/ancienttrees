---
// The app fakedoor page. Ported from build_fakedoor_pages(), build_site.py:4416-4501.
// /plus, its former sibling URL (closed 2026-07-29), redirects here rather
// than 404ing (redirect-stubs-integration.ts, per the Barcelona bcn_008
// precedent: nothing indexed retires outright).
import Base from "../layouts/Base.astro";
import { BASE_URL } from "../lib/schema";
import { imgSrcset } from "../lib/images";
import AppGetter from "../components/AppGetter.astro";

const canonical = `${BASE_URL}/app`;
const applandImg = imgSrcset(
  "https://images.unsplash.com/photo-1690269112887-da7d1f1ea6f3",
  [1200, 2000, 2800],
  "100vw",
);
---
<Base title="The Ancient Trees app" description="The iOS app for the walk itself: the old trees near you, and the ones you have stood in front of." canonical={canonical}>
<div class="appland">
  <!-- Taylor Cole, Unsplash License (no on-page credit required; recorded here
       per hard rule 4). -->
  <img class="appland-bg" {...applandImg} alt="">
  <div class="appland-card">
    <div class="appland-left">
      <span class="chip gold">Free on the App Store</span>
      <h1>Every ancient tree, in your pocket</h1>
      <p class="appland-sub">Open it wherever you happen to be and it finds the remarkable old trees within walking distance, strings the good ones into one afternoon, and tells you what you are standing in front of when you get there. Every tree you visit is one you keep.</p>
      <AppGetter ev="app-page-badge" source="app-page" />
      <p class="waitlist-note app-getter-ios-note">Needs an iPhone running iOS 18 or later.</p>
    </div>
    <div class="appland-right">
      <h2>What you can do</h2>
      <div class="appland-feat"><span class="feat-tile"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="22" r="14" fill="none" stroke="#4A6B2A" stroke-width="3"/><circle cx="24" cy="22" r="4" fill="#D9A13F"/><path d="M24 4 v6 M24 34 v6 M6 22 h6 M36 22 h6" stroke="#4A6B2A" stroke-width="2.6" stroke-linecap="round"/></svg></span><div><h3>Find the ones near you</h3><p>It opens on where you are and shows the remarkable old trees around you, closest first, with the walk to each.</p></div></div>
      <div class="appland-feat"><span class="feat-tile"><svg viewBox="0 0 48 48" aria-hidden="true"><ellipse cx="24" cy="19" rx="12" ry="10" fill="#3A5222"/><circle cx="17" cy="18" r="7" fill="#4A6B2A"/><circle cx="31" cy="18" r="7" fill="#4A6B2A"/><circle cx="24" cy="11" r="7" fill="#5B7F35"/><path d="M22.9 40h2.4l-.6-13h-1.2z" fill="#6B4F33"/><circle cx="36" cy="34" r="8" fill="#D9A13F"/><path d="M32.5 34 l2.5 2.5 5 -5" stroke="#fff" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></span><div><h3>Collect the ones you visit</h3><p>Stand in front of a tree, tick it off, and watch a collection build itself city by city and country by country.</p></div></div>
      <div class="appland-feat"><span class="feat-tile"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="8" y="16" width="32" height="22" rx="4" fill="#ECEDE2" stroke="#4A6B2A" stroke-width="2.5"/><circle cx="24" cy="27" r="7" fill="none" stroke="#4A6B2A" stroke-width="2.5"/><path d="M18 16 l2.4-4h7.2l2.4 4" fill="none" stroke="#4A6B2A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span><div><h3>Add the ones we are missing</h3><p>Stand in front of one we do not have yet, photograph it, and it joins the map.</p></div></div>
      <div class="appland-feat"><span class="feat-tile"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 39C13 30 7 23 7 15.5 7 10.5 11 7 16 7c3.4 0 6.4 1.9 8 4.6C25.6 8.9 28.6 7 32 7c5 0 9 3.5 9 8.5 0 7.5-6 14.5-17 23.5z" fill="#D9A13F"/></svg></span><div><h3>Save the ones for later</h3><p>Heart a tree you want to visit and find it again whenever you need it.</p></div></div>
    </div>
  </div>
</div>
</Base>
