---
// Contribute page. Ported from build_contribute_page(), build_site.py:4816-4927.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { cityIsRenderable } from "../lib/trees";
import { breadcrumbSchema, ldScript, SITE_SCHEMA, BASE_URL } from "../lib/schema";
import { fitTitle } from "../lib/title";
import { submitLink } from "../lib/tree-copy";
import { byCityListOrder } from "../lib/city-order";
import { SUPABASE_URL, SUPABASE_KEY } from "../lib/site-config";
import { DOWNSIZE_JS } from "../lib/image-downsize-js";
import { ui } from "../lib/i18n";
// English today; the sign strings are looked up rather than typed so the day
// this page gets a translation they come with it (every change covers every
// language, 2026-09-02).
const U = ui("en");

const canonical = `${BASE_URL}/contribute`;
const title = fitTitle(["Become Your City's Tree Guide", "Map Your City's Ancient Trees"], canonical);
const description =
  "Know the remarkable old trees of your city? Put them on the map. Every submission is verified against independent sources before it goes live.";
const crumbItems: [string, string | null][] = [["Home", BASE_URL], ["Suggest a tree", null]];

const allCities = (await getCollection("cities")).filter(cityIsRenderable);
const published = byCityListOrder(allCities.map((c) => ({ slug: c.id, city: c.data.city })));

const graph = [...SITE_SCHEMA, breadcrumbSchema(crumbItems, canonical)];
const headExtra = ldScript(graph);
---
<Base title={title} description={description} canonical={canonical} headExtra={headExtra}>
<main class="content-page">
  <Breadcrumbs items={crumbItems} />
  <h1>Become your city's tree guide</h1>
  <p class="answer-first">This map is missing far more cities than it has, and the trees that matter most are the ones locals already know about. If you know your city's remarkable old trees, you can put them on the map.</p>
  <div class="prose-block">
    <p>Research from a distance finds the famous trees. It misses the one on the corner that everyone in the neighbourhood walks past, the one with the story attached, the one that is only obvious if you live there. That gap is why this page exists.</p>
    <p>Everything sent in gets checked against independent sources, and the location gets verified, because a wrong pin is worse than a missing tree. Confirmed trees get their own page. What cannot be confirmed waits instead of going live half-true. We do not publish your name anywhere on the site, and we do not need it to accept a tree.</p>
  </div>

  {/* THE ACCOUNT IS ASKED FOR BEFORE THE TYPING, not after it (2026-09-24).
      Hidde: "het gaat er vooral om dat in de front end van de website in de
      flow je naar het inloggen wordt gestuurd en dat dat wordt uitgelegd dat
      dat moet." It was explained in a grey line UNDER the send button, which
      somebody reads after filling in six fields, if at all.

      Both references put the gate at the entrance: Google Maps will not show
      the Contribute tab to a signed-out person at all, and iNaturalist asks
      you to sign up before it gives you the observation form (CONVENTIONS.md,
      "Contributing when you are not signed in"). We keep the softer version
      our own 2026-08-21 ruling chose, the form visible and fillable to
      anybody, and move the SENTENCE to where they meet it first. */}
  <p class="sg-gate" id="sg-gate" hidden>
    <span>Sending needs a free account. It keeps the trees you send, so you can see what happened to each one.</span>
    <button type="button" id="sg-gate-btn" class="sg-gate-btn">Sign in</button>
  </p>

  <form id="suggest" class="suggest-form" autocomplete="off">
    <!-- The "what are you sending" dropdown is gone (Hidde, 2026-08-21:
         "isnt this first question useless - i dont need press inquiries here
         or privacy blabla"). It asked every visitor to classify themselves
         before they could give us a tree, which is the one thing this form is
         for. `kind` survives as a hidden field: it still routes Step 0b, and
         the deep links that set it (a correction from a tree page, a privacy
         request from the privacy page) still arrive with it set. -->
    <input type="hidden" id="sg-kind" value="tree">
    <p class="sg-note" id="sg-kindnote" hidden></p>
    <label>What tree, or trees, do you want to send?
      <input type="text" id="sg-tree" placeholder="The plane on the church square">
    </label>
    <label>Which city?
      <input type="text" id="sg-city" required placeholder="Utrecht">
    </label>
    <label>Where does it stand? <span class="sg-hint">A street, a park, or a Google Maps link. The single most useful thing you can give us.</span>
      <input type="text" id="sg-where" placeholder="Domplein, next to the cathedral entrance">
    </label>
    <label>Why is it remarkable?
      <textarea id="sg-why" rows="3" placeholder="Old, huge, a story attached, or simply the tree everyone knows"></textarea>
    </label>
    <label>How far round is the trunk? <span class="sg-hint">Optional. In metres, at chest height. One hug is about 1.5 m.</span>
      <input type="text" inputmode="decimal" id="sg-girth" placeholder="4.2">
    </label>
    {/* A PHOTOGRAPH, which this page has asked for since it was written and had
        nowhere to put (2026-09-23). A button with a hidden file input behind
        it, the same shape as the profile picture on /account/settings, because
        a bare file input is ugly on every platform and a button is what both
        references draw. */}
    <div class="sg-photo">
      <span class="sg-photo-label">A photo you took yourself</span>
      <span class="sg-hint">Optional. It has to be your own picture, not one from a website.</span>
      <button type="button" id="sg-pic-btn" class="sg-pic-btn">Choose a photo</button>
      <input id="sg-pic" type="file" accept="image/*" hidden />
      <span id="sg-pic-name" class="sg-hint"></span>
    </div>
    {/* THE SIGN, a second photograph and an optional one (Hidde, 2026-09-24:
        "vaak staat er een bordje bij een oude boom"). A sign names the
        species, often the age and the tree itself, which settles which trunk
        this is. Convention: iNaturalist lets you add more photographs to one
        observation and never asks for them (CONVENTIONS.md, "A photograph of
        the sign beside a tree"). Evidence for whoever checks the tip, never
        published. The app's describe form asks the same question. */}
    <div class="sg-photo">
      <span class="sg-photo-label">{U.signPhotoLabel}</span>
      <span class="sg-hint">{U.signPhotoHint}</span>
      <button type="button" id="sg-sign-btn" class="sg-pic-btn">{U.signPhotoBtn}</button>
      <input id="sg-sign" type="file" accept="image/*" hidden />
      <span id="sg-sign-name" class="sg-hint"></span>
    </div>
    <label>Your name <span class="sg-hint">Optional. Never shown on the site.</span>
      <input type="text" id="sg-name" placeholder="First name is fine">
    </label>
    <button type="submit" class="go-btn">Send it in</button>
    <p class="sg-note" id="sg-note"></p>
  </form>
  <!-- THE CONFIRMATION LIVES OUTSIDE THE FORM, because the form is what gets
       hidden. #sg-note sits inside it and is for the messages that belong
       beside the button while the form is still on screen. -->
  <p class="sg-done" id="sg-done" hidden></p>

  <p class="sg-fine">Writing about us? The numbers, image licences and caveats live on the <a href="/press">press page</a>.</p>

  <h2>What helps most</h2>
  <ul class="link-list">
    <li><strong>Where exactly it stands.</strong> A street corner, a park entrance, or a dropped pin from Google Maps. The single most useful thing you can give us.</li>
    <li><strong>Why it is remarkable.</strong> Old, enormous, strange, or tied to a local story.</li>
    <li><strong>How thick the trunk is.</strong> You can measure it by putting your arms around it, and one adult hug is about a metre and a half.</li>
    <li><strong>How you know.</strong> A link, a book, a plaque, or just that you grew up next to it.</li>
    <li><strong>A photo you took yourself,</strong> if you have one. We can only publish photos that are yours to share or openly licensed.</li>
  </ul>

  <h2>Or fix something</h2>
  <div class="prose-block">
    <p>Spotted a wrong location, an age that looks off, or a tree that has fallen since we wrote about it? Those corrections are just as valuable. <a href={submitLink("correction")}>Send a correction</a> and say what is wrong.</p>
  </div>
  <p class="suggest">Cities on the map so far: {published.map((p, i) => (
    <Fragment>{i > 0 && <Fragment set:html=" &middot; " />}<a href={`/${p.slug}`}>{p.city}</a></Fragment>
  ))}</p>
</main>
<Fragment slot="scripts" set:html={`
<script>
(function() {
  var f = document.getElementById('suggest'), note = document.getElementById('sg-note');
  var done = document.getElementById('sg-done');
  if (!f) return;
  var FIELDS = ['sg-kind', 'sg-city', 'sg-tree', 'sg-where', 'sg-why', 'sg-girth', 'sg-name'];
  // "4.2", "4,2", "4.2 m" and "420 cm" are the same trunk; a bare number under
  // 30 is metres. The same rule as Sightings.girthCm(parsing:) in the app, and
  // the same range as the database's own check.
  function girthCm(v) {
    var t = (v || '').toLowerCase().replace(',', '.').trim();
    if (!t) return null;
    var isCm = /cm$/.test(t), isM = !isCm && /m$/.test(t);
    var n = parseFloat(t.replace(/[^0-9.]/g, ''));
    if (!(n > 0)) return null;
    var r = Math.round(isCm ? n : (isM || n < 30 ? n * 100 : n));
    return (r >= 10 && r <= 5000) ? r : null;
  }
  // The one thing still kept on the device, and deliberately: text somebody
  // has typed and not yet sent is not a saved tree, it is an unfinished
  // sentence, and losing it to a mis-tap helps nobody. Written as a literal
  // rather than through a constant so scripts/qa.py's allowlist can see it.
  // Everything a person COLLECTS lives in their account (2026-09-02).
  function session() {
    try {
      var s = JSON.parse(localStorage.getItem('ancienttrees_session'));
      return (s && s.expires_at > Date.now() / 1000) ? s : null;
    } catch (e) { return null; }
  }
  // The gate is drawn by script rather than server-side, because the page is
  // static and cached: the HTML is the same for everybody and only the browser
  // knows who is holding it.
  var gate = document.getElementById('sg-gate');
  var gateBtn = document.getElementById('sg-gate-btn');
  function drawGate() {
    var signedIn = !!session();
    var priv = document.getElementById('sg-kind').value === 'privacy';
    // A privacy request may always be anonymous, so telling that person to
    // sign in would be wrong as well as unwelcoming.
    var gated = !signedIn && !priv;
    gate.hidden = !gated;
    // AND THE FIELDS GO WITH IT (Hidde, 2026-09-24: "loop alle ingangen naar
    // het formulier langs en zet dicht"). Every entrance was already gated and
    // the overlay opened on all of them; what stayed open was that dismissing
    // it left a form anybody could fill and send. That was my own softer
    // reading of the 2026-08-21 ruling and it is what he is closing.
    //
    // This is now the Google Maps shape exactly: a signed-out person does not
    // get the contribute surface. What they get instead is the page saying
    // what it is for, and one button.
    f.hidden = gated;
    if (done) done.hidden = true;
  }
  gateBtn.addEventListener('click', function() {
    if (window.atOpenSignIn) window.atOpenSignIn(null, 'contribute');
  });
  // No listener for "they just signed in", and none is needed: every route
  // into a session leaves this page and comes back to it. The magic link
  // reloads it and Google redirects to it, and Base's head script stores the
  // token before any of this runs, so drawGate below already sees the answer.

  var params = new URLSearchParams(location.search);
  var kind = params.get('kind');
  var map = {tree: 'tree', city: 'city', home: 'city', correction: 'correction', privacy: 'privacy'};
  if (kind && map[kind]) { document.getElementById('sg-kind').value = map[kind]; }
  // The dropdown is gone, so a deep link that is not about sending a tree has
  // to say so in words, or a privacy request looks like a tree form.
  var kindNote = {correction: 'Sending a correction. Tell us what is wrong and where.',
                  privacy: 'Sending a privacy request. Say what you would like removed.'};
  var kn = kindNote[document.getElementById('sg-kind').value];
  if (kn) { var el = document.getElementById('sg-kindnote'); el.textContent = kn; el.hidden = false; }
  // the page the reader came from already knows the city and the tree
  if (params.get('city')) { document.getElementById('sg-city').value = params.get('city'); }
  if (params.get('tree')) { document.getElementById('sg-tree').value = params.get('tree'); }
  // A draft survives the sign-in round trip: the magic link reloads this
  // page, and eating a paragraph someone typed would be the worst possible
  // answer to "please sign in".
  try {
    var d = JSON.parse(localStorage.getItem('at_contribute_draft'));
    if (d) FIELDS.forEach(function(id) {
      var el = document.getElementById(id);
      if (el && d[id] && !el.value) el.value = d[id];
    });
  } catch (e) {}
  drawGate();

  // AND IT OPENS BY ITSELF (Hidde, 2026-09-24: "dramatic approach just open
  // the login overlay if people go to the 'add tree flow' from all direction
  // and put the header like - to add a tree you need to login", then, about
  // the line above: "that one sentence noone will read"). He is right on both
  // counts, and this is the Google Maps convention adopted whole rather than
  // softened: the gate is at the entrance, and a person arriving here with no
  // account meets it before the first field instead of after the sixth.
  //
  // It supersedes the softer half of the 2026-08-21 ruling, which was that the
  // form is fillable by anybody and sending is what needs the account. The
  // form is still VISIBLE and the dialog is still dismissible, so nothing is
  // hidden and nobody is trapped; what changed is that the requirement is
  // announced rather than discovered.
  //
  // A privacy request never triggers it: asking for your own data back can
  // never require making an account first.
  //
  // ON LOAD, and that word is the whole fix. The first version guarded with
  // "&& window.atOpenSignIn" and ran at parse time, where that helper does not
  // exist yet: Base renders SIGNIN_JS after this page's own scripts, so the
  // guard was false and the block skipped itself in silence. It shipped and
  // did nothing. My harness could not see it either, because the stub in the
  // harness was defined ABOVE the script under test, which is kinder than the
  // real page. The load event fires once every inline script has run.
  if (!gate.hidden) {
    var openGate = function() {
      if (window.atOpenSignIn) window.atOpenSignIn(null, 'contribute');
    };
    if (document.readyState === 'complete') openGate();
    else window.addEventListener('load', openGate);
  }

  var btn = f.querySelector('button[type="submit"]');
  var inFlight = false;

  // THE PHOTOGRAPH. Staged on choosing and sent on submit, so nothing is
  // uploaded by somebody who changes their mind, and the tip still lands if
  // the picture does not: a tree we did not know about is worth more than an
  // image, and losing the words because a file failed would be the wrong way
  // round.
  // Two pickers of the same shape: the tree, and the sign beside it.
  var staged = { tree: null, sign: null };
  function picker(key, btnId, fileId, nameId) {
    var pb = document.getElementById(btnId);
    var pfile = document.getElementById(fileId);
    var pname = document.getElementById(nameId);
    pb.addEventListener('click', function() { pfile.click(); });
    pfile.addEventListener('change', function() {
      var pf = pfile.files && pfile.files[0];
      if (!pf) return;
      pname.textContent = 'Reading it...';
      window.atDownsize(pf, 1600, function(blob) {
        staged[key] = blob;
        pname.textContent = blob ? pf.name : 'That picture could not be read. Try another one.';
        if (blob) pb.textContent = 'Change photo';
      });
    });
  }
  picker('tree', 'sg-pic-btn', 'sg-pic', 'sg-pic-name');
  picker('sign', 'sg-sign-btn', 'sg-sign', 'sg-sign-name');

  function uuid() {
    if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
      var r = Math.random() * 16 | 0;
      return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
    });
  }

  // Into the sightings bucket, under the folder the person already owns, so
  // there is no second bucket and no second policy. Returns the stored path,
  // or null, and a null is not an error anybody is told about: the words are
  // the tip.
  function sendPhoto(s, picked, done) {
    if (!picked || !s) { done(null); return; }
    var uid = (s.user && s.user.id) ? s.user.id : s.user_id;
    if (!uid) { done(null); return; }
    var file = uuid() + '.jpg';
    var path = uid + '/' + file;
    fetch('${SUPABASE_URL}/storage/v1/object/sightings/'
          + encodeURIComponent(uid) + '/' + file, {
      method: 'POST',
      headers: { 'apikey': '${SUPABASE_KEY}', 'Authorization': 'Bearer ' + s.access_token,
                 'Content-Type': 'image/jpeg', 'x-upsert': 'true' },
      body: picked
    }).then(function(r) { done(r.ok ? path : null); })
      .catch(function() { done(null); });
  }
  f.addEventListener('submit', function(e) {
    e.preventDefault();
    if (inFlight) return;
    var city = document.getElementById('sg-city').value.trim();
    if (!city) return;
    var kindNow = document.getElementById('sg-kind').value;
    var s = session();
    // The gate (Hidde, 2026-08-21, the Google Maps convention): anyone can
    // see and fill the form, sending needs the account that lets us answer.
    // A privacy request is the one exception: asking for your data back can
    // never require creating an account first.
    if (!s && kindNow !== 'privacy') {
      var draft = {};
      FIELDS.forEach(function(id) { draft[id] = document.getElementById(id).value; });
      try { localStorage.setItem('at_contribute_draft', JSON.stringify(draft)); } catch (e) {}
      note.textContent = 'Sending needs an account. Sign in and press send again; what you typed is kept.';
      if (window.atOpenSignIn) window.atOpenSignIn(null, 'feedback');
      return;
    }
    // One press, one row: the Toulouse correction of 2026-08-20 arrived as
    // three identical rows because nothing stopped the extra presses.
    inFlight = true; btn.disabled = true; btn.textContent = 'Sending...';
    note.textContent = '';
    at.track('suggestion-submit');
    var headers = {'apikey': '${SUPABASE_KEY}', 'Content-Type': 'application/json', 'Prefer': 'return=minimal'};
    if (s) headers['Authorization'] = 'Bearer ' + s.access_token;
    var body = {
      kind: kindNow,
      city: city,
      tree: document.getElementById('sg-tree').value.trim(),
      location_hint: document.getElementById('sg-where').value.trim(),
      why: document.getElementById('sg-why').value.trim(),
      name: document.getElementById('sg-name').value.trim(),
      page: document.referrer || null
    };
    // Only when there is one: a column the database does not know yet would
    // refuse the whole row, and the tree matters more than the number.
    var girth = girthCm(document.getElementById('sg-girth').value);
    if (girth) body.girth_cm = girth;

    // THE PICTURE FIRST, then the row, so a row never points at a file that
    // failed to arrive. And the tip goes either way: if the upload fails, or
    // the photo column is not there yet, the words still land. A tree we did
    // not know about is worth more than an image of it.
    function post(b2) {
      return fetch('${SUPABASE_URL}/rest/v1/submissions', {
        method: 'POST', headers: headers, body: JSON.stringify(b2)
      });
    }
    sendPhoto(s, staged.tree, function(path) {
      if (path) body.photo = path;
      sendPhoto(s, staged.sign, function(signPath) {
      if (signPath) body.sign_photo = signPath;
      post(body).then(function(r) {
        if (!r.ok && (body.photo || body.sign_photo)) {
          // The database has not been taught a column yet. The same defence
          // the girth field already carries, and a retry rather than a guess
          // because PostgREST refuses the WHOLE row over one unknown key.
          // submissions.sign_photo is in supabase/PENDING.sql until pasted.
          delete body.photo;
          delete body.sign_photo;
          return post(body);
        }
        return r;
      }).then(function(r) {
      if (r.ok) {
        f.hidden = true;
        try { localStorage.removeItem('at_contribute_draft'); } catch (e) {}
        note.textContent = '';
        // AND SAY WHERE IT WENT. Until 2026-09-23 this said only thank you,
        // and the person had nowhere to go and look, which is half of why the
        // first outside contributor sent one oak fourteen times. Their own
        // account now lists what they sent and what happened to it, which is
        // the iNaturalist and Google Maps pattern: you land on the list that
        // holds the thing you just made (CONVENTIONS.md, "Landing after you
        // have added something").
        done.innerHTML = kindNow === 'privacy'
          ? 'Received. It reaches the people who run this site.'
          : 'Thank you. We check every tip against independent sources before '
            + 'anything goes live. You can follow this one on '
            + '<a href="/account">your account</a>, and we will write to you '
            + 'when it changes something.';
        done.hidden = false;
        done.scrollIntoView({ block: 'center', behavior: 'smooth' });
      } else {
        inFlight = false; btn.disabled = false; btn.textContent = 'Send it in';
        note.textContent = 'That did not go through. Try again in a moment.';
      }
      }).catch(function() {
        inFlight = false; btn.disabled = false; btn.textContent = 'Send it in';
        note.textContent = 'No connection. Try again in a moment.';
      });
      });
    });
  });
})();
</script>
${DOWNSIZE_JS}
`} />
</Base>
