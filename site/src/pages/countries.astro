---
// Countries index. Ported from build_countries_index(), build_site.py:4242-4274.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { cityIsRenderable, renderableTrees } from "../lib/trees";
import { COUNTRY_MIN_CITIES } from "../lib/species";
import { cityFace } from "../lib/images";
import { breadcrumbSchema, ldScript, SITE_SCHEMA, BASE_URL } from "../lib/schema";
import { fitTitle } from "../lib/title";
import { countryName } from "../lib/map";
import { browseCard } from "../lib/browse-card";

const allCities = (await getCollection("cities")).filter(cityIsRenderable);
const intros = await getCollection("countries");

const byCountry = new Map<string, typeof allCities>();
for (const c of allCities) {
  const key = c.data.country;
  if (!byCountry.has(key)) byCountry.set(key, []);
  byCountry.get(key)!.push(c);
}

// Same card shape build_country_page() returns (build_site.py:4232-4239),
// for every country that qualifies for its own page. Pre-sorted by country
// name (build_site.py:5794's `for country in sorted(country_pages)`) before
// the final tree-count sort, so a count tie breaks the same way.
const countryCards = intros
  .filter((intro) => (byCountry.get(intro.data.country)?.length ?? 0) >= COUNTRY_MIN_CITIES)
  .sort((a, b) => a.data.country.localeCompare(b.data.country))
  .map((intro) => {
    const cities = byCountry.get(intro.data.country)!;
    const ranked = [...cities].sort(
      (a, b) => renderableTrees(b).length - renderableTrees(a).length || a.data.city.localeCompare(b.data.city),
    );
    const trees = cities.reduce((s, c) => s + renderableTrees(c).length, 0);
    let face: string | null = null;
    for (const c of ranked) {
      const f = cityFace(c.data, 400);
      if (f) {
        face = f;
        break;
      }
    }
    return {
      slug: intro.data.slug,
      display: countryName(intro.data, true),
      cities: cities.length,
      trees,
      face,
    };
  })
  .sort((a, b) => b.trees - a.trees);

const canonical = `${BASE_URL}/countries`;
const title = fitTitle(["Ancient Trees by Country", "Browse Ancient Trees by Country"], canonical);
const description =
  "Every country on the map, with the cities and trees mapped in each: Japan's shrine camphors, Spain's imported giants, Portugal's register.";
const crumbItems: [string, string | null][] = [["Home", BASE_URL], ["Countries", null]];

const totalC = countryCards.reduce((s, c) => s + c.cities, 0);
const totalT = countryCards.reduce((s, c) => s + c.trees, 0);

const graph = [
  ...SITE_SCHEMA,
  {
    "@type": "ItemList",
    name: "Countries",
    itemListElement: countryCards.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.display, url: `${BASE_URL}/${c.slug}` })),
  },
  breadcrumbSchema(crumbItems, canonical),
];
---
<Base title={title} description={description} canonical={canonical} headExtra={ldScript(graph)}>
<main class="content-page">
  <Breadcrumbs items={crumbItems} />
  <h1>Ancient trees by country</h1>
  <p class="answer-first">{totalC} cities across {countryCards.length} countries, {totalT} remarkable trees between them. Every country plants differently and protects differently, and it shows in what survived. Or go straight to <a href="/cities">the city list</a>.</p>
  <div class="cindex-grid" set:html={countryCards.map((c) => browseCard(`/${c.slug}`, c.display, `${c.cities} cities &middot; ${c.trees} trees`, c.face)).join("")} />
</main>
</Base>
