---
// German city pages. Three lines of routing; the whole implementation is
// TranslatedCityPage.astro, shared by every language per Contract J v1.13.
import { getCollection } from "astro:content";
import TranslatedCityPage from "../../components/TranslatedCityPage.astro";
import { cityIsRenderable } from "../../lib/trees";
import { translatedCityPaths } from "../../lib/i18n";

export async function getStaticPaths() {
  return translatedCityPaths("de", (await getCollection("cities")).filter(cityIsRenderable) as any);
}
const { city, tr } = Astro.props as any;
---
<TranslatedCityPage lang="de" city={city} tr={tr} />
