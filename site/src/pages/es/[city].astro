---
// Spanish city page: the /es/ half of the Malaga translation test
// (2026-08-10, Hidde's direction). Structurally a sibling of ../[city].astro
// with Spanish chrome hardcoded the same way the English template hardcodes
// English; the translated text comes from data/i18n/es/<slug>.json and
// everything factual (coordinates, photos, walks) from the one canonical
// city file. When a second language arrives, the shared skeleton gets
// extracted; two copies is the honest cost of a test, ten copies would be a
// maintenance bug.
//
// Known limits, deliberate for the test: the site chrome (nav, footer) and
// the map popups stay English, and the season block is omitted because its
// generated labels are English. If the test earns a second language, those
// become the next work, not silent debt.
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import TreeCard from "../../components/TreeCard.astro";
import SignInModal from "../../components/SignInModal.astro";
import AppModal from "../../components/AppModal.astro";
import { TREE_ACTIONS_JS } from "../../lib/tree-actions-js";
import { SIGNIN_JS } from "../../lib/signin-js";
import { cityIsRenderable, renderableTrees, treeSlugsForCity, type CityEntry } from "../../lib/trees";
import { usablePhoto, imgSrcset, creditRequired } from "../../lib/images";
import { speciesIcon } from "../../lib/species-icons";
import { breadcrumbSchema, ldScript, SITE_SCHEMA, BASE_URL } from "../../lib/schema";
import { mapHead } from "../../lib/map";
import { type WalkMarker } from "../../lib/walks";
import { cityMapScript } from "../../lib/city-map-script";
import { SHEET_JS } from "../../lib/sheet-js";
import { translatedCities, cityTranslation, hreflangLinks, QUESTION_SLUG, type CityTranslation } from "../../lib/i18n";

function esc(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

export async function getStaticPaths() {
  const allCities = (await getCollection("cities")).filter(cityIsRenderable);
  return translatedCities("es").map((slug) => {
    const city = allCities.find((c) => c.id === slug);
    if (!city) throw new Error(`data/i18n/es/${slug}.json has no matching English city file`);
    const tr = cityTranslation("es", slug)!;
    const trees = renderableTrees(city);
    // The overlay must cover every rendered tree: a Spanish page silently
    // falling back to an English story would look like sloppiness, and a
    // missing id would mean the English city grew after the translation.
    for (const t of trees) {
      if (!tr.trees[t.id]) throw new Error(`es/${slug}: no translation for ${t.id}; the English city grew past the overlay`);
    }
    const iw = tr.intro.split(/\s+/).filter(Boolean).length;
    if (iw < 60 || iw > 100) throw new Error(`es/${slug}: intro is ${iw} words, Contract C requires 60-100`);
    return { params: { city: slug }, props: { city, tr } };
  });
}

interface Props {
  city: CityEntry;
  tr: CityTranslation;
}
const { city, tr } = Astro.props as Props;

const cslug = city.id;
const trees = renderableTrees(city);
const tslugs = treeSlugsForCity(city);
const canonical = `${BASE_URL}/es/${cslug}`;

const markers: WalkMarker[] = trees.map((t, i) => ({
  lat: t.location.latitude!,
  lng: t.location.longitude!,
  label: String(i + 1),
  icon: speciesIcon(t),
  name: tr.trees[t.id].name,
  id: t.id,
  area: (t.location.neighbourhood ?? "").trim(),
  shot: Boolean(usablePhoto(t)),
}));

const crumbItems: [string, string | null][] = [
  ["Inicio", BASE_URL],
  [tr.city, null],
];

const listElements = trees.map((t, i) => ({
  "@type": "ListItem",
  position: i + 1,
  name: tr.trees[t.id].name,
  url: `${BASE_URL}/es/${cslug}/${tslugs[t.id]}`,
  item: {
    "@type": "TouristAttraction",
    name: tr.trees[t.id].name,
    description: tr.trees[t.id].story.slice(0, 200),
    geo: { "@type": "GeoCoordinates", latitude: t.location.latitude, longitude: t.location.longitude },
  },
}));
const graph = [
  ...SITE_SCHEMA,
  { "@type": "ItemList", name: tr.title, itemListElement: listElements },
  { "@type": "FAQPage", mainEntity: tr.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
  breadcrumbSchema(crumbItems, canonical),
];
const headExtra = mapHead() + "\n" + hreflangLinks("es", `/${cslug}`, `/es/${cslug}`) + "\n" + ldScript(graph);

const avgLat = markers.reduce((s, m) => s + m.lat, 0) / markers.length;
const avgLng = markers.reduce((s, m) => s + m.lng, 0) / markers.length;

function esDuration(minutes: number): string {
  const h = Math.floor(minutes / 60);
  const m = Math.round(minutes) % 60;
  if (h && m) return `${h} h ${m} min`;
  if (h) return h === 1 ? "1 hora" : `${h} horas`;
  return `${m} min`;
}

const qslug = QUESTION_SLUG.es;
---
<Base title={tr.title} description={tr.meta_description} canonical={canonical} headExtra={headExtra} footer={false} lang="es">
  <div class="split">
    <aside class="panel" id="sheet">
      <div class="sheet-grab">
      <div class="panel-head">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Inicio</a> › <span>{tr.city}</span></nav>
        <button type="button" class="sheet-back">← Los {trees.length} árboles</button>
        <p class="eyebrow">España</p>
        <h1>Árboles históricos de <em>{tr.city}</em></h1>
        <p class="sheet-count">{trees.length} árboles en el mapa</p>
      </div>
      </div>
      <div class="sheet-body">
      <div class="city-intro">
        <p class="lede">{tr.intro}</p>
        <button type="button" class="city-intro-more">Leer más</button>
        <p class="lang-alt">This page also exists <a href={`/${cslug}`}>in English</a>.</p>
        <p class="passport" id="passport" hidden>
          <strong><span id="passport-count">0</span> de {trees.length}</strong> visitados en {tr.city}
          <span class="passport-total" id="passport-total"></span>
          <button type="button" class="passport-save" id="passport-save">Guardar o pasar a otro dispositivo</button>
        </p>
      </div>
      {trees.map((t, i) => {
        const x = tr.trees[t.id];
        return (
          <TreeCard tree={t} citySlug={cslug} treeSlug={tslugs[t.id]} index={i + 1}
                    variant="full" headingLevel={2} lang="es"
                    overrides={{ name: x.name, species: x.species, age: x.age_estimate, story: x.story }} />
        );
      })}
      <div class="panel-foot">
        <p class="subtle-suggest"><b>Estamos cartografiando todos los árboles singulares del mundo.</b> ¿Conoces uno en {tr.city} que nos falte, o ves aquí un error? <a href="/contribute?kind=tree">Cuéntanoslo</a>.</p>
        <div class="take-with-you">
          <strong>¿Vas a ir?</strong> <a href={`/${cslug}.gpx`} download>Descarga los {trees.length} árboles</a> como archivo de mapa y ábrelo en Google Maps, Organic Maps o cualquier aplicación de senderismo. Funciona sin conexión.
        </div>
        <h2>Preguntas frecuentes</h2>
        <dl class="faq">
          {tr.faq.map((f) => (
            <Fragment>
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </Fragment>
          ))}
          <dt>Más sobre el árbol más antiguo</dt>
          <dd><a href={`/es/${cslug}/${qslug}`}>¿Cuál es el árbol más antiguo de {tr.city}?</a> La respuesta completa, con mapa y cómo llegar.</dd>
        </dl>
        <p class="suggest">¿Conoces un árbol que merezca estar en esta lista? <a href="/contribute?kind=tree">Envíanoslo</a>.</p>
      </div>
      </div>
    </aside>
    <div class="stage">
      <div id="map" class="map"></div>
      <div class="walks" id="walk">
        <div class="map-tools">
          <a class="map-cta" href="/app" data-app-modal data-ev="walks-app">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="map-cta-ic"><path d="M5 19c0-2.2 1.8-4 4-4h6c2.2 0 4-1.8 4-4s-1.8-4-4-4H9" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/><circle cx="5" cy="19" r="2.2" fill="currentColor"/><circle cx="19" cy="5" r="2.2" fill="currentColor"/></svg>
            <span class="map-cta-text">Rutas a pie<span class="map-cta-sub">en la aplicación</span></span>
          </a>
          <button type="button" class="map-gps" id="gps-btn" aria-pressed="false" aria-label="Dónde estoy">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="gps-ic"><circle cx="12" cy="12" r="3.2" fill="currentColor"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/><circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="2" fill="none"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <SignInModal es />
  <AppModal es />
  <Fragment slot="scripts" set:html={TREE_ACTIONS_JS + SIGNIN_JS + cityMapScript(markers, [avgLat, avgLng], null, [], []) + SHEET_JS} />
</Base>
