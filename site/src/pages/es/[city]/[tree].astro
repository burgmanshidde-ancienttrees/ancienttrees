---
// Spanish tree page: sibling of ../../[city]/[tree].astro for translated
// cities. Facts (coordinates, photo, licence) from the canonical city file,
// text from the overlay. Season block deliberately omitted (its generated
// labels are English); the collect dialog is translated but points at the
// same English /app page, which is where the product actually is.
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { cityIsRenderable, renderableTrees, treeSlugsForCity, distLabel, type CityEntry, type Tree } from "../../../lib/trees";
import { haversineKm } from "../../../lib/walks";
import { usablePhoto, imgSrcset, thumbUrl, creditRequired } from "../../../lib/images";
import { speciesIcon } from "../../../lib/species-icons";
import { breadcrumbSchema, ldScript, SITE_SCHEMA, BASE_URL } from "../../../lib/schema";
import { locationIsApproximate } from "../../../lib/tree-copy";
import { mapHead, singlePinScript } from "../../../lib/map";
import { translatedCities, cityTranslation, hreflangLinks, type CityTranslation, type TreeTranslation } from "../../../lib/i18n";

function esc(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

export async function getStaticPaths() {
  const allCities = (await getCollection("cities")).filter(cityIsRenderable);
  const paths: { params: { city: string; tree: string }; props: any }[] = [];
  for (const slug of translatedCities("es")) {
    const city = allCities.find((c) => c.id === slug);
    if (!city) continue;
    const tr = cityTranslation("es", slug)!;
    const trees = renderableTrees(city);
    const tslugs = treeSlugsForCity(city);
    for (const tree of trees) {
      const x = tr.trees[tree.id];
      if (!x) throw new Error(`es/${slug}: no translation for ${tree.id}`);
      const wc = x.story.split(/\s+/).filter(Boolean).length;
      if (wc < 150 || wc > 250) throw new Error(`es/${slug}/${tslugs[tree.id]}: story is ${wc} words, the 150-250 bar applies in every language`);
      paths.push({ params: { city: slug, tree: tslugs[tree.id] }, props: { city, tree, x, allTrees: trees, tr } });
    }
  }
  return paths;
}

interface Props {
  city: CityEntry;
  tree: Tree;
  x: TreeTranslation;
  allTrees: Tree[];
  tr: CityTranslation;
}
const { city, tree, x, allTrees, tr } = Astro.props as Props;

const cslug = city.id;
const tslugs = treeSlugsForCity(city);
const tslug = tslugs[tree.id];
const loc = tree.location;
const canonical = `${BASE_URL}/es/${cslug}/${tslug}`;

const title = `${x.name}, ${tr.city}`.length <= 60 ? `${x.name}, ${tr.city}` : x.name;
// Same fill-the-room discipline as the English metaFromStory, inline because
// the Spanish sentence shapes differ and the helper is four lines.
function metaEs(story: string): string {
  const sentences = story.split(/(?<=[.!?]) /);
  let out = "";
  for (const s of sentences) {
    const cand = out ? out + " " + s : s;
    if (cand.length <= 155) { out = cand; continue; }
    if (out.length >= 120) break;
    const cut = cand.slice(0, 154);
    const sp = cut.lastIndexOf(" ");
    out = (sp > -1 ? cut.slice(0, sp) : cut).replace(/[,.;:]+$/, "") + "…";
    break;
  }
  return out;
}
const description = metaEs(x.story);

function kmBetween(a: { latitude: number; longitude: number }, b: { latitude: number; longitude: number }): number {
  return haversineKm([a.latitude, a.longitude], [b.latitude, b.longitude]);
}
const here = { latitude: loc.latitude!, longitude: loc.longitude! };
const nearby = allTrees
  .filter((t) => t.id !== tree.id)
  .sort((a, b) => kmBetween(here, { latitude: a.location.latitude!, longitude: a.location.longitude! }) - kmBetween(here, { latitude: b.location.latitude!, longitude: b.location.longitude! }))
  .slice(0, 3);

const crumbItems: [string, string | null][] = [
  ["Inicio", BASE_URL],
  [tr.city, `${BASE_URL}/es/${cslug}`],
  [x.name, null],
];

const photo = usablePhoto(tree);
let ogImage = "";
if (photo?.url) ogImage = `\n<meta property="og:image" content="${esc(thumbUrl(photo.url, 1200))}">`;

const isApprox = locationIsApproximate(tree);
const graph = [
  ...SITE_SCHEMA,
  {
    "@type": "TouristAttraction",
    name: x.name,
    description: x.story.slice(0, 300),
    isAccessibleForFree: x.access.toLowerCase().startsWith("gratuito"),
    geo: { "@type": "GeoCoordinates", latitude: loc.latitude, longitude: loc.longitude },
  },
  breadcrumbSchema(crumbItems, canonical),
];
const headExtra = mapHead() + ogImage + "\n" + hreflangLinks("es", `/${cslug}/${tslug}`, `/es/${cslug}/${tslug}`) + "\n" + ldScript(graph);
const scripts = singlePinScript(loc.latitude!, loc.longitude!);
---
<Base title={title} description={description} canonical={canonical} headExtra={headExtra} lang="es">
  <main class="content-page has-tree-bar">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Inicio</a> › <a href={`/es/${cslug}`}>{tr.city}</a> › <span>{x.name}</span></nav>
    <h1>{x.name}</h1>
    <p class="chip-row">
      <span class="chip">{x.age_estimate}</span>
      <span class="chip">{x.species}</span>
      {isApprox && <span class="chip approx">ubicación aproximada</span>}
    </p>
    {photo && photo.url ? (
      <figure class="tree-photo">
        <img {...imgSrcset(photo.url, [700, 1100, 1600], "(max-width: 800px) 100vw, 760px")} alt={x.name} loading="lazy" />
        {creditRequired(photo.license) && <figcaption>Foto: {photo.attribution} ({photo.license})</figcaption>}
      </figure>
    ) : (
      <figure class="tree-noph">
        <span class="tree-noph-art" aria-hidden="true"><Fragment set:html={`<svg viewBox="0 0 40 40">${speciesIcon(tree)}</svg>`} /></span>
        <figcaption>
          <b>{x.species}</b>
          <span>Nadie ha publicado una fotografía de este árbol con una licencia que podamos usar.
          <a href="/contribute">Envíanos la tuya</a> y aparecerá en esta página con tu nombre.</span>
        </figcaption>
      </figure>
    )}
    <div class="action-row">
      <a class="go-btn" href={`https://www.google.com/maps/dir/?api=1&destination=${loc.latitude},${loc.longitude}`} target="_blank" rel="noopener">Cómo llegar</a>
      <a class="action-link" href={`/es/${cslug}#walk`}>Recorre más árboles en {tr.city}</a>
    </div>
    <div class="prose-block"><p>{x.story}</p></div>
    <div class="map-embed"><div id="map" class="map"></div></div>
    <p class="go-note">El botón de arriba abre las indicaciones en tu aplicación de mapas. {x.transport}</p>
    {isApprox && (
      <p class="approx-note">
        El marcador señala la zona correcta de forma aproximada, no el árbol exacto. Está aquí, pero todavía no hemos confirmado la posición precisa sobre el terreno.{" "}
        <a href="/contribute?kind=correction">¿Sabes exactamente dónde está?</a>
      </p>
    )}
    <dl class="facts">
      <dt>Especie</dt><dd>{x.species}</dd>
      <dt>Edad estimada</dt><dd>{x.age_estimate}</dd>
      <dt>Ubicación</dt><dd>{loc.address ?? ""} ({loc.neighbourhood ?? ""})</dd>
      <dt>Acceso</dt><dd>{x.access}</dd>
      <dt>Cómo llegar</dt><dd>{x.transport}</dd>
    </dl>
    <h2>Árboles cercanos</h2>
    <div class="near-cards">
      {nearby.map((t) => (
        <a class="near-card" href={`/es/${cslug}/${tslugs[t.id]}`}>
          <b>{tr.trees[t.id].name}</b>
          <span>{tr.trees[t.id].age_estimate} · a {distLabel({ latitude: loc.latitude!, longitude: loc.longitude! }, { latitude: t.location.latitude!, longitude: t.location.longitude! })}</span>
        </a>
      ))}
    </div>
    <div class="cta">
      ¿Quieres saber qué más sigue en pie en {tr.city}? Mira <a href={`/es/${cslug}`}>los {allTrees.length} árboles singulares de {tr.city}</a> o descubre <a href={`/es/${cslug}/arbol-mas-antiguo`}>cuál es el árbol más antiguo de {tr.city}</a>.
    </div>
    <div class="report">
      <strong>Nos vendría bien tu ayuda.</strong>
      <p class="report-line">Esta página se investigó a distancia. Si conoces este árbol, sabes cosas que nosotros no sabemos.</p>
      <a class="report-btn" href="/contribute?kind=correction">Aquí hay algo mal</a>
      <a class="report-btn" href="/contribute?kind=tree">Sugerir otro árbol</a>
    </div>
    <div class="tree-bar" aria-label="Acciones">
      <a class="tb-link" href={`https://www.google.com/maps/dir/?api=1&destination=${loc.latitude},${loc.longitude}`} target="_blank" rel="noopener">Cómo llegar</a>
      <a class="tb-link" href={`/es/${cslug}#walk`}>Más árboles</a>
    </div>
  </main>
  <Fragment slot="scripts" set:html={scripts} />
</Base>
