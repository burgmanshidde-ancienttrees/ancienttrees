---
// Spanish question page, at the phrase a Spanish speaker actually searches.
// Routing only; TranslatedQuestionPage.astro is shared (Contract J v1.13).
import { getCollection } from "astro:content";
import TranslatedQuestionPage from "../../../components/TranslatedQuestionPage.astro";
import { cityIsRenderable } from "../../../lib/trees";
import { allQuestionPathsFor } from "../../../lib/i18n";

export async function getStaticPaths() {
  return allQuestionPathsFor("es", (await getCollection("cities")).filter(cityIsRenderable) as any);
}
const { city, tr, fallback } = Astro.props as any;
---
<TranslatedQuestionPage lang="es" city={city} tr={tr} fallback={fallback} />
