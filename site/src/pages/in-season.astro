---
// The bloom page, retired to a redirect on 2026-08-26. The season story left
// the public site (DECISIONS.md: "the whole season story is Plus, the fact
// included"); the app's Plus is where it resurfaces. The URL keeps resolving
// because a public URL never dies (hard rule 3), and the meta refresh is the
// pattern qa.py's orphan check already recognises as a deliberate stub.
const target = "/explore";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href="https://ancienttrees.app/explore" />
    <title>Ancient Trees</title>
  </head>
  <body>
    <p>This page has moved to <a href={target}>the map</a>.</p>
  </body>
</html>
