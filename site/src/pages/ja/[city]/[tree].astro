---
// Japanese tree pages. Routing only; TranslatedTreePage.astro is the shared
// implementation for every language (Contract J v1.13).
import { getCollection } from "astro:content";
import TranslatedTreePage from "../../../components/TranslatedTreePage.astro";
import { cityIsRenderable, renderableTrees, treeSlugsForCity } from "../../../lib/trees";
import { translatedTreePaths } from "../../../lib/i18n";

export async function getStaticPaths() {
  const cities = (await getCollection("cities")).filter(cityIsRenderable);
  return translatedTreePaths("ja", cities as any, renderableTrees, treeSlugsForCity);
}
const p = Astro.props as any;
---
<TranslatedTreePage lang="ja" city={p.city} tree={p.tree} x={p.x} allTrees={p.allTrees} tr={p.tr} />
