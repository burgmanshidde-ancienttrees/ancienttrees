---
// Dutch question page, at the phrase a Dutch speaker actually searches.
// Routing only; TranslatedQuestionPage.astro is shared (Contract J v1.13).
import { getCollection } from "astro:content";
import TranslatedQuestionPage from "../../../components/TranslatedQuestionPage.astro";
import { cityIsRenderable, renderableTrees } from "../../../lib/trees";
import { translatedQuestionPaths } from "../../../lib/i18n";

export async function getStaticPaths() {
  return translatedQuestionPaths("nl", (await getCollection("cities")).filter(cityIsRenderable) as any, renderableTrees);
}
const { city, tr } = Astro.props as any;
---
<TranslatedQuestionPage lang="nl" city={city} tr={tr} />
