---
// Contract H — Park page. Ported from build_park_page(), build_site.py:3908-3959.
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { cityIsRenderable, treeSlugsForCity, type CityEntry, type Tree } from "../../lib/trees";
import { groupTreesByPark, PARK_MIN_TREES } from "../../lib/parks";
import { usablePhoto, imgSrcset } from "../../lib/images";
import { breadcrumbSchema, ldScript, SITE_SCHEMA, BASE_URL } from "../../lib/schema";
import { fitTitle } from "../../lib/title";
import { byCityListOrder } from "../../lib/city-order";

export async function getStaticPaths() {
  const allCities = (await getCollection("cities")).filter(cityIsRenderable);
  const intros = await getCollection("parks");
  const groups = groupTreesByPark(allCities);

  const introByKey = new Map(intros.map((i) => [`${i.data.city_slug} ${i.data.park}`, i]));

  const published = byCityListOrder(allCities.map((c) => ({ slug: c.id, city: c.data.city })));

  return [...groups.values()]
    .filter((g) => g.trees.length >= PARK_MIN_TREES)
    .map((g) => {
      const intro = introByKey.get(`${g.citySlug} ${g.parkName}`);
      if (!intro) return null;
      return {
        params: { slug: intro.data.slug },
        props: { intro, city: g.city, trees: g.trees, published },
      };
    })
    .filter((p): p is NonNullable<typeof p> => p !== null);
}

interface Props {
  intro: CollectionEntry<"parks">;
  city: CityEntry;
  trees: Tree[];
  published: { slug: string; city: string }[];
}
const { intro, city, trees: rawTrees, published } = Astro.props as Props;

const name = intro.data.name || intro.data.park;
const cityName = city.data.city;
const cslug = city.id;
const canonical = `${BASE_URL}/parks/${intro.data.slug}`;

const title = fitTitle([
  intro.data.title ?? "",
  `Ancient Trees in ${name}, ${cityName}`,
  `${name}: Ancient Trees`,
]);
const description = intro.data.meta_description ?? "";

const crumbItems: [string, string | null][] = [
  ["Home", BASE_URL],
  ["Parks", `${BASE_URL}/parks`],
  [name, null],
];

const trees = [...rawTrees].sort((a, b) => (b.age_max ?? 0) - (a.age_max ?? 0));
const tslugs = treeSlugsForCity(city);

const listElements = trees.map((t, i) => ({
  "@type": "ListItem",
  position: i + 1,
  name: t.name,
  url: `${BASE_URL}/${cslug}/${tslugs[t.id]}`,
}));

const firstSentence = intro.data.intro.split(". ")[0] + ".";
const rest = intro.data.intro.slice(firstSentence.length).trimStart();

const otherCities = published.filter((p) => p.slug !== cslug).slice(0, 6);

const graph = [...SITE_SCHEMA, breadcrumbSchema(crumbItems, canonical), { "@type": "ItemList", name: `Ancient trees in ${name}`, itemListElement: listElements }];
---
<Base title={title} description={description} canonical={canonical} headExtra={ldScript(graph)}>
  <main class="content-page">
    <Breadcrumbs items={crumbItems} />
    <h1>Ancient Trees in {name}</h1>
    <p class="lede">{firstSentence}</p>
    {rest && <div class="prose-block"><p>{rest}</p></div>}
    <p class="suggest">
      All {trees.length} stand in <a href={`/${cslug}`}>{cityName}</a>, which maps {city.data.trees.length} remarkable trees in total.
    </p>
    {trees.map((t) => {
      const ph = usablePhoto(t);
      const storyFirst = (t.story ?? "").split(". ")[0];
      return (
        <div class={`entry${ph ? " has-thumb" : ""}`}>
          {ph && ph.url && (
            <div class="entry-thumb">
              <img {...imgSrcset(ph.url, [300, 600], "140px")} alt={t.name} loading="lazy" />
            </div>
          )}
          <div class="entry-body">
            <h3><a href={`/${cslug}/${tslugs[t.id]}`}>{t.name}</a> <span class="tree-label">{t.age_estimate ?? ""}</span></h3>
            <p>{t.species}. {storyFirst}.</p>
          </div>
        </div>
      );
    })}
    {intro.data.official_url && (
      // The reciprocity OUTREACH.md promises has to actually exist on the
      // page: opening hours, tickets and closures are theirs to state, not
      // ours. Ported from build_park_page(), origin/main 7f02499.
      <p class="suggest">
        Opening times and visitor information: <a href={intro.data.official_url} rel="noopener">{intro.data.official_name || "the official site"}</a>.
      </p>
    )}
    <p class="suggest">
      More parks worth the walk: <a href="/parks">every park we map</a>. Or explore by city:{" "}
      {otherCities.map((q, i) => (
        <Fragment>
          {i > 0 && " · "}
          <a href={`/${q.slug}`}>{q.city}</a>
        </Fragment>
      ))}
    </p>
  </main>
</Base>
