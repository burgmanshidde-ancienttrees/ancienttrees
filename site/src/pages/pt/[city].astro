---
// Portuguese city pages. Three lines of routing; the whole implementation is
// TranslatedCityPage.astro, shared by every language per Contract J v1.13.
import { getCollection } from "astro:content";
import TranslatedCityPage from "../../components/TranslatedCityPage.astro";
import { cityIsRenderable } from "../../lib/trees";
import { allCityPathsFor } from "../../lib/i18n";

export async function getStaticPaths() {
  return allCityPathsFor("pt", (await getCollection("cities")).filter(cityIsRenderable) as any);
}
const { city, tr, fallback } = Astro.props as any;
---
<TranslatedCityPage lang="pt" city={city} tr={tr} fallback={fallback} />
