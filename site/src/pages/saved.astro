---
// /saved merged into /account on 2026-08-18 (Hidde: "saved trees is een losse
// pagina en staat niet onder account, dit is totaal niet conventioneel").
// The URL stays alive rather than being retired, per hard rule 3, and the page
// is noindex so nothing has to link to it.
import Base from "../layouts/Base.astro";
import { BASE_URL } from "../lib/schema";
const canonical = `${BASE_URL}/account`;
---
<Base
  title="Saved Trees"
  description="Your saved trees now live under your account."
  canonical={canonical}
  headExtra={'<meta name="robots" content="noindex">\n<meta http-equiv="refresh" content="0; url=/account#saved">'}
>
  <main class="content-page">
    <h1>Saved trees</h1>
    <p class="prose-block">Your saved trees live under <a href="/account#saved">your account</a>.</p>
  </main>
</Base>
