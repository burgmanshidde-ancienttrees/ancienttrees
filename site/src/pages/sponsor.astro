---
// The sponsor page. Hidde, 2026-08-26: "ik zou wel 'sponsor this project'
// gewoon live zetten, zodat we hopelijk in ieder geval de kosten kunnen
// dekken", and with it "zodat apple niet mee profiteert", which is why the
// ask lives on the web where no store takes a cut.
//
// A utility page like /privacy, /terms and /app rather than a blueprint
// contract: it targets no query and enters no internal-link scheme, so hard
// rule 7 is not in play. It carries no price of its own for the same reason
// the app cannot: the amounts live in Hidde's own provider dashboard, which
// keeps pricing where hard rule 2 puts it.
//
// SPONSOR_URL empty means: no button, noindex, and no footer link. Nothing
// here promises that anything stays free, because that promise is his to
// make and he has ruled against making it.
//
// No photograph (Hidde, 2026-08-28: "delete the photo"). The page had led on
// the oldest photographed tree on the map; the ask reads faster without a
// picture in front of it, and the trees are one tap away in the menu.
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { breadcrumbSchema, ldScript, SITE_SCHEMA, BASE_URL } from "../lib/schema";
import { SPONSOR_URL } from "../lib/site-config";
import { submitLink } from "../lib/tree-copy";
import { pressNumbers, nf } from "../lib/press";

const n = pressNumbers();

const live = SPONSOR_URL.length > 0;
const canonical = `${BASE_URL}/sponsor`;
const crumbItems: [string, string | null][] = [["Home", BASE_URL], ["Sponsor", null]];

const description = `Ancient Trees is a passion project: ${nf(n.trees)} remarkable old trees you can go and stand in front of. A donation buys the time to make it better.`;

const graph = [
  ...SITE_SCHEMA,
  breadcrumbSchema(crumbItems, canonical),
  {
    "@type": "WebPage",
    name: "Sponsor Ancient Trees",
    description,
    url: canonical,
  },
];

const headExtra = (live ? "" : '<meta name="robots" content="noindex">') + ldScript(graph);
---
<Base title="Sponsor Ancient Trees" description={description} canonical={canonical} headExtra={headExtra}>
<main class="content-page sponsor-page">
  <Breadcrumbs items={crumbItems} />
  <h1>Sponsor this project</h1>
  <p class="lede">Ancient Trees is a passion project. I'm building it to let others appreciate nature and go outside. Marvel at something older than you can imagine.</p>

  <div class="prose-block">
    <p>Running the website and app does cost money. A donation would help me enormously: more time and more resources to make this much better, and to get more of these trees on the map.</p>

    {live && (
      <p>
        <a class="go-btn" href={SPONSOR_URL} rel="noopener" data-ev="sponsor-open">Sponsor Ancient Trees</a>
      </p>
    )}

    <h2>Helping without money</h2>
    <p>Worth just as much: <a href={submitLink("tree")}>send me a tree I am missing</a>, or tell me when something on a page is wrong. People who have stood in front of the tree are how this map gets better, and a wrong pin gets looked at the same day.</p>

    {!live && (
      <p class="suggest">The sponsor page is being set up. In the meantime, <a href={submitLink("tree")}>a tree I am missing</a> helps just as much.</p>
    )}
  </div>
</main>
</Base>
